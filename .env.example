# Aztec Ops — environment template.
#
#   cp .env.example .env
#
# Every variable below is read by `backend/config/settings.py` (the `Settings` class), which
# validates them at import time: a malformed value fails at startup with a named error instead of
# surfacing three hours later inside a request. Nothing else is read, so a variable that is not
# here is a variable the application ignores.
#
# The values shipped here are safe local defaults. `.env` itself is git-ignored — no secret is
# ever committed, and the only credentials in this file are the throwaway ones Compose creates for
# the local PostgreSQL.
#
# Docker Compose also reads this file for `${VAR}` substitution, so the published host ports below
# are configurable from the same place. The Django services get their DATABASE_URL and REDIS_URL
# from `docker-compose.yml` directly (service names, not localhost); the values here are what you
# want when you run something against the containers *from the host*.

# --- Application -------------------------------------------------------------------------------

# Which behaviour profile is active: local | test | production.
# `production` turns on SSL redirect, secure cookies and HSTS, and forces DEBUG off whatever
# DJANGO_DEBUG says. `test` swaps in the MD5 password hasher so test users are cheap to create.
ENVIRONMENT=local

# Django's signing key: sessions, CSRF tokens, password-reset links, and — since authentication
# became real — the HS256 key every JWT is signed with. Rotating it invalidates every outstanding
# access and refresh token at once, which is this deployment's only revocation lever. Keep it at
# least 32 bytes: PyJWT warns below that for SHA-256. The default below is fine locally and
# unacceptable anywhere else — generate a real one for a deployed environment:
#   python -c "import secrets; print(secrets.token_urlsafe(64))"
DJANGO_SECRET_KEY=dev-only-not-a-secret-do-not-use-this-in-production

# Verbose error pages and the SQL query log. Ignored when ENVIRONMENT=production.
DJANGO_DEBUG=true

# Hosts Django will answer for. `*` is the local default; a deployed environment names its domains
# explicitly, because this is the only defence against Host-header poisoning.
#
# JSON array, not a comma-separated string: `allowed_hosts` is a `list[str]` on the Settings model
# and pydantic-settings parses complex fields as JSON. `*` alone raises SettingsError at startup.
DJANGO_ALLOWED_HOSTS=["*"]

# --- Backing services --------------------------------------------------------------------------

# PostgreSQL, as one URL rather than six variables that can disagree with each other. This value
# is the *host* view of the Compose database; inside the network the host is `postgres` and the
# port is 5432. Used when you point psql, a GUI client or a host-side manage.py at the container.
DATABASE_URL=postgres://aztec:aztec@localhost:55433/aztec

# Redis, for exactly two jobs: the Celery broker and result backend, and the `aztec.sse` pub/sub
# channel the streaming endpoint reads. It holds no durable event state — the transactional outbox
# in PostgreSQL is the durability guarantee, so a Redis that loses everything delays events by one
# sweep and loses none. Same host-versus-network note as DATABASE_URL.
REDIS_URL=redis://localhost:56379/0

# Credentials the postgres container initialises itself with, and the host ports Compose
# publishes. Ports are deliberately not 5432/6379: those belong to whatever the developer already
# runs locally, and stealing them is how a compose file breaks someone's machine.
POSTGRES_DB=aztec
POSTGRES_USER=aztec
POSTGRES_PASSWORD=aztec
POSTGRES_PORT=55433
REDIS_PORT=56379
API_PORT=8000
FRONTEND_PORT=4321

# --- Cross-origin ------------------------------------------------------------------------------

# Origins allowed to call the API from a browser. The Astro dev server is the only one locally;
# the SSE endpoint needs this as much as the JSON routes do. JSON array, for the same reason as
# DJANGO_ALLOWED_HOSTS above.
CORS_ALLOWED_ORIGINS=["http://localhost:4321"]

# --- Domain knobs ------------------------------------------------------------------------------

# How often Celery Beat emits `clock.ticked`. This is the upper bound on how stale a time-derived
# score can be (ARCHITECTURE §4.2): raise it and overdue projects notice later, lower it and every
# tick recomputes the portfolio again. 300 = five minutes.
TICKER_INTERVAL_SECONDS=300

# A project with no recorded activity for this many days trips the IS_STALE risk flag.
STALENESS_THRESHOLD_DAYS=14

# How many times one event is retried before its outbox row is dead-lettered. Handlers are
# idempotent (deduplicated on `ProcessedEvent(event_id, handler)`), so a retry is always safe; this
# bounds how long a poisoned event keeps consuming worker time. A dead-lettered row is not lost: it
# is visible in /admin/events/outboxevent/ and re-queued from there.
EVENT_MAX_ATTEMPTS=5

# How often Celery Beat sweeps the outbox for anything the broker missed. This is a safety net, not
# the hot path: a service writing an event kicks a drain on `transaction.on_commit`, so this is the
# worst-case latency when that kick was lost, never the normal one. Both paths read the same table,
# so neither can double-deliver — `ProcessedEvent` settles it.
EVENT_DRAIN_INTERVAL_SECONDS=5

# How many outbox rows one drain claims, with SELECT ... FOR UPDATE SKIP LOCKED. Larger batches
# amortise the round trip; smaller ones shorten the lock each drain holds.
EVENT_DRAIN_BATCH_SIZE=100

# --- Seed credentials ----------------------------------------------------------------------
# Both blocks are EMPTY on purpose. A default that works is still a hardcoded credential, only
# one that everybody who reads this public repository knows. Empty means "nobody can sign in
# yet", which is a safe failure; `admin/admin` is not.
#
# The committed fixture stores the literal "!" as each user's password, which Django reads as
# unusable. `make seed` replaces it only from these variables.

# Applied by `make seed` to the six seeded team members. Leave empty and they cannot sign in —
# and since every route is now authenticated, an unset value means the API answers 401 to
# everything except the health probes. Set it before the demo.
#
# Of the six, `camila.torres` is seeded with is_staff=true, which is what `User.is_ops_lead`
# reads: she is the only seeded account that may force a priority override or rebuild the whole
# portfolio. Everyone else may do everything else.
SEED_USER_PASSWORD=

# Django's own convention — the same variables `createsuperuser --noinput` reads. `make seed`
# creates or updates this admin account. Leave empty and it creates none; run
# `docker compose exec api python manage.py createsuperuser` yourself instead.
DJANGO_SUPERUSER_USERNAME=
DJANGO_SUPERUSER_PASSWORD=
DJANGO_SUPERUSER_EMAIL=
