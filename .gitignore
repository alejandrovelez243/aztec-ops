Enunciado — Reto Desarrollador de Soluciones con IA _ Aztec.md
data/raw/

# --- secrets ---------------------------------------------------------------------------
# .env.example is the tracked template and must stay tracked; every real .env must not.
.env
.env.*
!.env.example
*.pem
*.key

# --- Python ----------------------------------------------------------------------------
__pycache__/
*.py[cod]
.venv/
*.sqlite3
.pytest_cache/
.ruff_cache/
.mypy_cache/
htmlcov/
.coverage
coverage.xml

# --- Django / Celery runtime state -----------------------------------------------------
# Beat's default scheduler keeps its last-run times in a local shelve file. It is per-machine
# state, and committing it means one developer's clock decides when another's tasks are due.
celerybeat-schedule*
celerybeat.pid
*.pid
*.log

# Collected into the production image at build time, served from the finders in dev.
# Never a source artefact.
staticfiles/

# --- Frontend --------------------------------------------------------------------------
node_modules/
dist/
.astro/

# --- Tooling ---------------------------------------------------------------------------
.impeccable/live/
.impeccable/questions/
.claude/settings.local.json
.claude/worktrees/
.DS_Store
.idea/
.vscode/
