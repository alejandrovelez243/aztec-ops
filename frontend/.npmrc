# openapi-typescript 7.13.0 (its latest release) still declares `peer typescript@"^5.x"`, while this
# project is on TypeScript 6 — the version @astrojs/check, astro and typescript-eslint all support.
# Without this flag `npm ci` fails on every machine, including the Docker build, so the lockfile that
# was committed could never be installed from.
#
# Accepting the mismatch is safe here and is a deliberate, recorded decision rather than a silent
# `--force` in someone's shell history: openapi-typescript is a dev-only code generator invoked by
# `npm run gen:api`, it reads an OpenAPI document and writes a .d.ts, and it never enters the Astro
# build or the running container. Nothing it touches is type-checked against the TS 6 compiler.
#
# Remove this line as soon as openapi-typescript widens the peer range to include ^6.
legacy-peer-deps=true
