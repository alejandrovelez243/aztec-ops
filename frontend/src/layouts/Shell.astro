---
/**
 * DIRECTION CONTRACT — "El Muro" (approved 2026-07-28)
 *
 * THESIS: The operations wall in software — work is physical cards a hand
 * moves. Refuses both the dark console matrix (retired) and the indigo
 * template dashboard.
 * OWN-WORLD: Warm paper ground, white cards with layered soft shadows and
 * hairline edges, 16px radius; one Cobalto voice; rojo/ámbar/verde/cielo/
 * piedra as washes; Schibsted Grotesk + Spline Sans Mono figures.
 * STORY: Sign in → land on today's zones → open the queue → move work; every
 * action answers; colleagues' moves visibly travel.
 * FIRST VIEWPORT: Persistent collapsible sidebar, 64px topbar (back +
 * breadcrumbs + live badge), content on paper.
 * FORM: User-pinned mix of their references (beats the roll; no seed key).
 * Comp C governs Resumen, comp B governs Prioridades.
 */
import { ClientRouter } from "astro:transitions";

import "../styles/tokens.css";
import "../styles/base.css";
import BrandMark from "../components/ui/BrandMark.astro";
import Icon from "../components/ui/Icon.astro";
import type { IconName } from "../components/ui/Icon.astro";
import ConnectionBadge from "../islands/ConnectionBadge.astro";
import { appGuardScript } from "../lib/auth/guard-inline";
import { SESSION_COOKIE_NAME, SESSION_STORAGE_KEY } from "../lib/auth/tokens";

/** One breadcrumb; the last one renders as the current page (no link). */
export interface Crumb {
  label: string;
  href?: string;
}

/**
 * Keys of the sidebar destinations; `active` highlights one. Keys and routes
 * are English, the labels beside them Spanish (CLAUDE.md §Language).
 */
export type NavKey =
  | "overview"
  | "priorities"
  | "projects"
  | "board"
  | "team"
  | "activity"
  | "workflows";

export interface Props {
  /** Document title, rendered as `<title>{title} — Aztec Ops</title>`. */
  title: string;
  /** Which sidebar destination this page belongs to. */
  active?: NavKey;
  /** Wayfinding trail; omit on the root page. */
  crumbs?: Crumb[];
  /**
   * Full-bleed content: drops the centred `--content-max` measure and the side
   * gutters, and lets the content region grow to the remaining viewport height.
   *
   * The documented escape hatch for surfaces whose own geometry *is* the page —
   * `/board`, where the wall must start at the sidebar edge and end at the
   * viewport edge, and where the columns need a bounded height to scroll inside.
   * A page that opts in owns its own padding: the layout stops supplying any.
   *
   * Reaching for negative margins instead is the failure this exists to prevent —
   * they lie about the measure, break at every breakpoint the shell changes, and
   * leave the topbar and the content disagreeing about where the page begins.
   */
  wide?: boolean;
}

const { title, active, crumbs = [], wide = false } = Astro.props;

const NAV: ReadonlyArray<{
  key: NavKey;
  label: string;
  href: string;
  icon: IconName;
}> = [
  { key: "overview", label: "Resumen", href: "/", icon: "home" },
  {
    key: "priorities",
    label: "Prioridades",
    href: "/priorities",
    icon: "flag",
  },
  { key: "projects", label: "Proyectos", href: "/projects", icon: "folder" },
  { key: "board", label: "Tablero", href: "/board", icon: "board" },
  { key: "team", label: "Equipo", href: "/team", icon: "users" },
  { key: "activity", label: "Actividad", href: "/activity", icon: "pulse" },
  { key: "workflows", label: "Flujos", href: "/workflows", icon: "flow" },
];

/** Where the back button goes when the tab has no history: the parent crumb. */
const backFallback =
  crumbs.length > 1 ? (crumbs[crumbs.length - 2]?.href ?? "/") : "/";

const LOGIN_PATH = "/login";

/**
 * Runs before paint, ahead of any bundle, so a signed-out visitor never sees a
 * frame of the app. The middleware is the authoritative guard; this only spares
 * the flash, and both read the same cookie on purpose (`lib/auth/guard-inline.ts`).
 */
const appGuard = appGuardScript(
  SESSION_COOKIE_NAME,
  SESSION_STORAGE_KEY,
  LOGIN_PATH,
);
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <script is:inline set:html={appGuard} />
    <script is:inline>
      // Sidebar state, before paint, so the rail never flashes open.
      //
      // 1024–1439 is the icon rail by contract (DESIGN.md §Layout), which the
      // stored preference cannot override: below 1024 the sidebar is the
      // drawer, and only from 1440 is there room for the operator to choose.
      // The same rule lives in the module script below, applied again whenever
      // the viewport crosses the band.
      (function () {
        var pref = "open";
        try {
          pref =
            window.localStorage.getItem("aztec.ui.sidebar") === "rail"
              ? "rail"
              : "open";
        } catch {
          /* storage disabled: the panel is the default */
        }
        var band = window.matchMedia(
          "(min-width: 1024px) and (max-width: 1439px)",
        );
        document.documentElement.dataset.sidebar = band.matches ? "rail" : pref;
      })();
    </script>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta name="theme-color" content="#f4f3ef" />
    <title>{title} — Aztec Ops</title>
    <meta property="og:title" content={`${title} — Aztec Ops`} />
    <meta
      property="og:description"
      content="Prioriza el portafolio y explica por qué."
    />
    <meta property="og:image" content="/brand/og.jpg" />
    <meta name="twitter:card" content="summary_large_image" />
    <ClientRouter />
  </head>
  <body>
    <a class="visually-hidden skip-link" href="#contenido"
      >Saltar al contenido</a
    >
    <div class="shell">
      <aside class="sidebar" id="sidebar" transition:persist="sidebar">
        <div class="sidebar-top">
          <a class="brand" href="/" aria-label="Aztec Ops, ir al resumen">
            <BrandMark size={26} />
            <span class="brand-name">Aztec Ops</span>
          </a>
          <button
            class="btn btn-ghost btn-icon collapse-btn"
            type="button"
            data-action="toggle-sidebar"
            aria-label="Plegar o desplegar el menú"
          >
            <Icon name="panel" />
          </button>
        </div>

        <nav class="nav" aria-label="Secciones">
          <ul>
            {
              NAV.map((item) => (
                <li>
                  <a
                    class="nav-item"
                    href={item.href}
                    title={item.label}
                    aria-current={item.key === active ? "page" : undefined}
                  >
                    <Icon name={item.icon} />
                    <span class="nav-label">{item.label}</span>
                  </a>
                </li>
              ))
            }
          </ul>
        </nav>

        <div class="sidebar-foot">
          <div class="operator" data-operator hidden>
            <span class="avatar" data-operator-avatar></span>
            <span class="operator-text">
              <span class="title operator-name" data-operator-name></span>
              <span class="small operator-role" data-operator-role></span>
            </span>
            <button
              class="btn btn-ghost btn-icon"
              type="button"
              data-action="logout"
              aria-label="Cerrar sesión"
            >
              <Icon name="logout" />
            </button>
          </div>
        </div>
      </aside>

      <div class="scrim" data-action="close-drawer" aria-hidden="true"></div>

      <div class="main-col">
        <header class="topbar">
          <button
            class="btn btn-ghost btn-icon menu-btn"
            type="button"
            data-action="open-drawer"
            aria-label="Abrir el menú"
            aria-controls="sidebar"
            aria-expanded="false"
            data-drawer-trigger
          >
            <Icon name="menu" />
          </button>
          <button
            class="btn btn-ghost btn-icon"
            type="button"
            data-action="back"
            data-back-fallback={backFallback}
            aria-label="Volver"
          >
            <Icon name="back" />
          </button>
          {
            crumbs.length > 0 && (
              <nav class="crumbs" aria-label="Ruta">
                <ol>
                  {crumbs.map((crumb, index) => (
                    <li>
                      {index < crumbs.length - 1 && crumb.href !== undefined ? (
                        <a href={crumb.href}>{crumb.label}</a>
                      ) : (
                        <span aria-current="page">{crumb.label}</span>
                      )}
                    </li>
                  ))}
                </ol>
              </nav>
            )
          }
          <div class="topbar-right">
            <ConnectionBadge />
          </div>
        </header>
        <main id="contenido" class="content" data-wide={wide ? "" : undefined}>
          <slot />
        </main>
      </div>
    </div>

    <div
      id="toast-region"
      class="toast-region"
      aria-live="polite"
      transition:persist="toasts"
    >
    </div>

    <script>
      // Shell behaviour: one delegated click handler (survives view-transition
      // swaps without rebinding), the SSE connection (opened exactly once here,
      // FRONTEND.md §6), the session-expired listener, and per-navigation init.
      import { SESSION_EXPIRED_EVENT } from "../lib/api/client";
      import {
        avatarHue,
        getOperator,
        guardAppPage,
        initials,
        signOut,
      } from "../lib/auth/session";
      import { connect } from "../lib/stream/store";
      import { toast } from "../lib/toast";

      const SIDEBAR_PREF_KEY = "aztec.ui.sidebar";

      /**
       * The band in which the sidebar is the icon rail whatever the operator
       * prefers (DESIGN.md §Layout: <1024 drawer, 1024–1439 rail, ≥1440 panel).
       * Duplicated once in the pre-paint inline script, which cannot import.
       */
      const railBand = window.matchMedia(
        "(min-width: 1024px) and (max-width: 1439px)",
      );

      /**
       * Opens or closes the drawer, and tells assistive tech that it did.
       *
       * The trigger owns `aria-expanded`: the drawer is also closed by the
       * scrim and by Escape, so a state written only where the button is
       * clicked would leave a screen reader announcing an open navigation over
       * a closed one.
       */
      function setDrawer(open: boolean): void {
        if (open) {
          document.documentElement.dataset.drawer = "open";
        } else {
          delete document.documentElement.dataset.drawer;
        }
        document
          .querySelector("[data-drawer-trigger]")
          ?.setAttribute("aria-expanded", String(open));
      }

      /** The stored choice; `open` whenever storage refuses to answer. */
      function storedSidebar(): "rail" | "open" {
        try {
          return window.localStorage.getItem(SIDEBAR_PREF_KEY) === "rail"
            ? "rail"
            : "open";
        } catch {
          return "open";
        }
      }

      /**
       * Applies the effective sidebar mode: the rail band wins over the
       * preference, so widening past 1440 restores the operator's choice and
       * narrowing back into the band collapses to the rail again.
       */
      function applySidebarMode(): void {
        document.documentElement.dataset.sidebar = railBand.matches
          ? "rail"
          : storedSidebar();
      }

      function toggleSidebar(): void {
        const next = storedSidebar() === "rail" ? "open" : "rail";
        try {
          window.localStorage.setItem(SIDEBAR_PREF_KEY, next);
        } catch {
          /* preference simply not persisted */
        }
        applySidebarMode();
      }

      function goBack(control: HTMLElement): void {
        const fallback = control.dataset.backFallback ?? "/";
        if (window.history.length > 1) {
          window.history.back();
        } else {
          window.location.assign(fallback);
        }
      }

      /**
       * Re-marks the current destination in the sidebar.
       *
       * The sidebar is `transition:persist`ed, so it survives a navigation
       * untouched — including the `aria-current` the server rendered for
       * whatever page first drew it. Without this, the highlight stays on the
       * entry the operator arrived through and the nav quietly lies about
       * where they are.
       */
      function markActiveNav(): void {
        const path = window.location.pathname;
        for (const link of document.querySelectorAll<HTMLAnchorElement>(
          ".nav-item",
        )) {
          const href = link.getAttribute("href") ?? "";
          const isActive =
            href === "/"
              ? path === "/"
              : path === href || path.startsWith(`${href}/`);
          if (isActive) link.setAttribute("aria-current", "page");
          else link.removeAttribute("aria-current");
        }
      }

      function fillOperatorCard(): void {
        const operator = getOperator();
        const card = document.querySelector<HTMLElement>("[data-operator]");
        if (card === null || operator === null) return;
        card.hidden = false;
        const avatar = card.querySelector<HTMLElement>(
          "[data-operator-avatar]",
        );
        if (avatar !== null) {
          avatar.textContent = initials(operator.label);
          avatar.style.setProperty(
            "--avatar-h",
            String(avatarHue(operator.alias)),
          );
        }
        const name = card.querySelector<HTMLElement>("[data-operator-name]");
        if (name !== null) name.textContent = operator.label;
        const role = card.querySelector<HTMLElement>("[data-operator-role]");
        if (role !== null) role.textContent = operator.role ?? "";
      }

      document.addEventListener("click", (event) => {
        const target = event.target;
        if (!(target instanceof Element)) return;
        const control = target.closest<HTMLElement>("[data-action]");
        if (control === null) return;
        switch (control.dataset.action) {
          case "toggle-sidebar":
            toggleSidebar();
            break;
          case "open-drawer":
            setDrawer(true);
            break;
          case "close-drawer":
            setDrawer(false);
            break;
          case "back":
            goBack(control);
            break;
          case "logout":
            void signOut();
            break;
          default:
            break;
        }
      });

      document.addEventListener("keydown", (event) => {
        if (event.key === "Escape") setDrawer(false);
      });

      railBand.addEventListener("change", applySidebarMode);

      window.addEventListener(SESSION_EXPIRED_EVENT, () => {
        toast({
          kind: "error",
          title: "Tu sesión expiró",
          detail: "Vuelve a iniciar sesión para continuar.",
        });
        window.setTimeout(() => {
          window.location.assign("/login");
        }, 1200);
      });

      document.addEventListener("astro:page-load", () => {
        if (!guardAppPage()) return;
        setDrawer(false);
        applySidebarMode();
        markActiveNav();
        fillOperatorCard();
      });

      // The single SSE connection for the whole tab (idempotent; islands only
      // subscribe). Opened here so the stream is warm before islands hydrate.
      connect();
    </script>

    <style>
      .shell {
        display: grid;
        grid-template-columns: auto 1fr;
        min-height: 100dvh;
      }

      .skip-link:focus-visible {
        position: fixed;
        inset: var(--space-2) auto auto var(--space-2);
        width: auto;
        height: auto;
        margin: 0;
        padding: var(--space-2) var(--space-3);
        clip: auto;
        clip-path: none;
        background: var(--carta);
        border-radius: var(--radius-control);
        box-shadow: var(--shadow-raised);
        z-index: var(--z-toast);
      }

      /* --- Sidebar --- */

      .sidebar {
        position: sticky;
        top: 0;
        align-self: start;
        height: 100dvh;
        width: var(--size-sidebar);
        display: flex;
        flex-direction: column;
        background: var(--carta);
        border-right: var(--border-width) solid var(--hairline);
        padding: var(--space-4) var(--space-3);
        /*
         * The one width animation kept on purpose. A transform would slide the
         * rail over the content or leave a gap beside it — the point of
         * collapsing is that the content *reclaims* the space, which is a
         * layout change by definition. It runs once per deliberate click, on a
         * grid track, not per frame of a data update, so the reflow it costs is
         * bounded and paid for. Everything that animates on data uses transform
         * (see the bars in SignalBar, ScorePlate and MemberRow).
         */
        transition: width var(--motion-panel-duration) var(--motion-panel-ease);
        z-index: var(--z-sidebar);
        overflow: hidden;
      }

      .sidebar-top {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: var(--space-2);
        padding-inline: var(--space-2);
        margin-bottom: var(--space-5);
      }

      .brand {
        display: flex;
        align-items: center;
        gap: var(--space-3);
        text-decoration: none;
        min-width: 0;
      }

      .brand-name {
        font-size: var(--text-title-size);
        font-weight: 700;
        letter-spacing: -0.01em;
        white-space: nowrap;
      }

      .nav ul {
        display: flex;
        flex-direction: column;
        gap: var(--space-1);
      }

      .nav-item {
        display: flex;
        align-items: center;
        gap: var(--space-3);
        padding: 10px var(--space-3);
        border-radius: var(--radius-control);
        color: var(--tinta-media);
        text-decoration: none;
        font-size: var(--text-title-size);
        font-weight: 500;
        white-space: nowrap;
        transition:
          background-color var(--motion-micro-duration) var(--motion-micro-ease),
          color var(--motion-micro-duration) var(--motion-micro-ease);
      }

      .nav-item:hover {
        background: var(--pozo);
        color: var(--tinta);
      }

      .nav-item[aria-current="page"] {
        background: var(--cobalto-papel);
        color: var(--cobalto);
        font-weight: 600;
      }

      .sidebar-foot {
        margin-top: auto;
        border-top: var(--border-width) solid var(--hairline);
        padding-top: var(--space-3);
      }

      .operator {
        display: flex;
        align-items: center;
        gap: var(--space-3);
        padding-inline: var(--space-2);
        min-width: 0;
      }

      .operator-text {
        display: flex;
        flex-direction: column;
        min-width: 0;
      }

      .operator-name,
      .operator-role {
        overflow: hidden;
        text-overflow: ellipsis;
        white-space: nowrap;
      }

      /* --- Rail (collapsed) --- */

      :global(html[data-sidebar="rail"]) .sidebar {
        width: var(--size-rail);
      }

      :global(html[data-sidebar="rail"]) .brand-name,
      :global(html[data-sidebar="rail"]) .nav-label,
      :global(html[data-sidebar="rail"]) .operator-text {
        display: none;
      }

      :global(html[data-sidebar="rail"]) .sidebar-top {
        flex-direction: column;
        gap: var(--space-3);
      }

      :global(html[data-sidebar="rail"]) .nav-item,
      :global(html[data-sidebar="rail"]) .operator {
        justify-content: center;
        padding-inline: 0;
      }

      :global(html[data-sidebar="rail"]) .operator :global(.btn-icon) {
        display: none;
      }

      /* --- Topbar --- */

      .main-col {
        min-width: 0;
        display: flex;
        flex-direction: column;
      }

      .topbar {
        position: sticky;
        top: 0;
        display: flex;
        align-items: center;
        gap: var(--space-2);
        height: var(--size-topbar);
        padding-inline: var(--space-4);
        background: var(--papel);
        border-bottom: var(--border-width) solid var(--hairline);
        z-index: calc(var(--z-sidebar) - 1);
      }

      .menu-btn {
        display: none;
      }

      .crumbs ol {
        display: flex;
        align-items: center;
        gap: var(--space-2);
        flex-wrap: nowrap;
        overflow: hidden;
      }

      .crumbs li {
        display: flex;
        align-items: center;
        gap: var(--space-2);
        white-space: nowrap;
        color: var(--tinta-media);
        font-size: var(--text-small-size);
      }

      .crumbs li + li::before {
        content: "/";
        color: var(--tinta-suave);
      }

      .crumbs a {
        text-decoration: none;
        border-radius: var(--radius-chip);
        transition: color var(--motion-micro-duration) var(--motion-micro-ease);
      }

      .crumbs a:hover {
        color: var(--cobalto);
      }

      .crumbs [aria-current="page"] {
        color: var(--tinta);
        font-weight: 600;
      }

      .topbar-right {
        margin-left: auto;
        display: flex;
        align-items: center;
        gap: var(--space-3);
      }

      .content {
        width: 100%;
        max-width: var(--content-max);
        margin-inline: auto;
        padding: var(--space-5) var(--space-6) var(--space-8);
      }

      /*
       * The `wide` escape hatch (see Props). The measure and the gutters go, and
       * the region becomes a flex column that claims the height the topbar left
       * over — a board whose columns scroll inside themselves needs a bounded
       * height, and `min-height: 0` is what keeps a flex child from refusing to
       * shrink below its content.
       */
      .content[data-wide] {
        max-width: none;
        margin-inline: 0;
        padding: 0;
        flex: 1;
        min-height: 0;
        display: flex;
        flex-direction: column;
      }

      /*
       * Below 1440 the collapse control has nothing to say: 1024–1439 is the
       * rail and below 1024 the drawer, both fixed by DESIGN.md §Layout. A
       * visible toggle there would write a preference the layout then ignores.
       */
      @media (max-width: 1439px) {
        .collapse-btn {
          display: none;
        }
      }

      /* --- Drawer (< 1024px) --- */

      .scrim {
        display: none;
        position: fixed;
        inset: 0;
        background: var(--scrim);
        z-index: var(--z-scrim);
      }

      @media (max-width: 1023px) {
        .shell {
          grid-template-columns: 1fr;
        }

        .sidebar {
          position: fixed;
          inset-block: 0;
          left: 0;
          width: var(--size-sidebar);
          transform: translateX(-100%);
          transition: transform var(--motion-panel-duration)
            var(--motion-panel-ease);
          box-shadow: none;
          z-index: var(--z-drawer);
        }

        :global(html[data-sidebar="rail"]) .sidebar {
          width: var(--size-sidebar);
        }

        :global(html[data-sidebar="rail"]) .brand-name,
        :global(html[data-sidebar="rail"]) .nav-label {
          display: initial;
        }

        :global(html[data-sidebar="rail"]) .operator-text {
          display: flex;
        }

        :global(html[data-sidebar="rail"]) .sidebar-top {
          flex-direction: row;
        }

        :global(html[data-sidebar="rail"]) .nav-item,
        :global(html[data-sidebar="rail"]) .operator {
          justify-content: flex-start;
          padding-inline: var(--space-3);
        }

        :global(html[data-sidebar="rail"]) .operator {
          padding-inline: var(--space-2);
        }

        :global(html[data-sidebar="rail"]) .operator :global(.btn-icon) {
          display: inline-flex;
        }

        :global(html[data-drawer="open"]) .sidebar {
          transform: translateX(0);
          box-shadow: var(--shadow-lifted);
        }

        :global(html[data-drawer="open"]) .scrim {
          display: block;
        }

        .menu-btn {
          display: inline-flex;
        }

        .content {
          padding: var(--space-4) var(--space-4) var(--space-7);
        }
      }
    </style>
  </body>
</html>
