---
import BoardColumn from "../components/board/BoardColumn.astro";
import EngagementSwitcher from "../components/board/EngagementSwitcher.astro";
import type { Option } from "../components/board/EngagementSwitcher.astro";
import Icon from "../components/ui/Icon.astro";
import MemberBar from "../components/board/MemberBar.astro";
import TaskPanel from "../components/board/TaskPanel.astro";
import { BOARD_ENGAGEMENT_KEY } from "../components/board/board-dom";
import type {
  BoardPanelModel,
  MemberChipModel,
  ProjectCardModel,
  Tone,
} from "../components/board/board-model";

/**
 * The board canvas: the one island of `/board`, and the home of the product's signature
 * interaction — cards with mass.
 *
 * What it owns, and why it is one island rather than five:
 *
 * - **Drag.** Pointer events plus `setPointerCapture`, no drag library. The card lifts, tilts
 *   toward its own velocity and *trails the hand* through a critically damped follower on
 *   rAF; the board announces legality while it travels, the slider auto-scrolls when the card
 *   nears an edge, and the drop is answered by the server, never by the client.
 * - **Its keyboard and touch twin.** Every card carries a "Mover a…" menu listing the same
 *   legal moves and posting through the same path. Drag is the enhancement, never the only
 *   way in (DESIGN.md, Do's).
 * - **Selection and the task panel.** A card is also a control: picking one fills the panel
 *   with that project's tasks, grouped by task state. The choice lives in `?project=CODE`, so
 *   a reload and the back button both land where the operator was.
 * - **The member filter.** Pressing a face narrows the wall to that person's projects.
 * - **The stream.** `project.state_changed` from another operator travels the card across the
 *   board with an attribution chip riding on it — the moment the product's multiplayer nature
 *   is shown instead of implied — and the `task.*` topics refresh the open panel.
 *
 * All of them mutate the same cards, so they share one controller: split across islands they
 * would race each other on the same DOM node with no owner of the truth.
 *
 * The first paint is server-rendered by the page; this island never fetches the board. It
 * fetches exactly three things on demand — a project's legal moves, the transition POST, and
 * the selected project's tasks — and compares every envelope's `occurred_at` against the
 * card's rendered `updated_at` before touching it (`docs/standards/PATTERNS_FRONTEND.md` §6).
 */
export interface Props {
  panels: readonly BoardPanelModel[];
  /** Engagement type painted first; the browser swaps to the operator's stored choice. */
  defaultEngagement: string;
  /**
   * Connection arm the server rendered. `stale` is the `disconnected` view state: the board
   * stays on screen, marked, with drags refused — never blanked (`FRONTEND.md` §1).
   */
  connection: "live" | "stale";
  /** `occurred_at` of the last envelope the store saw, for the staleness sentence. */
  lastEventAt: string | null;
  /** The roster, for the "Miembros" bar; empty when the read failed. */
  members: readonly MemberChipModel[];
  /** Why the roster is missing, when it is. */
  membersNote: string | null;
  /** The project `?project=` named, already located on the board; `null` when none. */
  selected: { card: ProjectCardModel; tone: Tone } | null;
}

const {
  panels,
  defaultEngagement,
  connection,
  lastEventAt,
  members,
  membersNote,
  selected,
} = Astro.props;

const options: Option[] = panels.map((panel) => ({
  code: panel.engagementType.code,
  label: panel.engagementType.label,
  tone: panel.tone,
  count: panel.columns.reduce(
    (total, column) => total + column.cards.length,
    0,
  ),
}));

const selectedCode = selected === null ? null : selected.card.code;

/** Server-side twin of the runtime's staleness sentence; both name the same moment. */
const staleSentence =
  lastEventAt === null
    ? "Sin conexión en vivo. El tablero muestra los datos con los que se cargó la página."
    : `Sin conexión en vivo. El tablero muestra los datos de las ${new Intl.DateTimeFormat(
        "es",
        { hour: "2-digit", minute: "2-digit" },
      ).format(new Date(lastEventAt))}.`;
---

<div
  class="board"
  data-board
  data-engagement={defaultEngagement}
  data-connection={connection}
  data-last-event-at={lastEventAt ?? ""}
  data-selected={selectedCode ?? undefined}
>
  <div class="board-bar">
    <EngagementSwitcher options={options} active={defaultEngagement} />
    <MemberBar members={members} failureNote={membersNote} />
    <p class="small board-hint" lang="es">
      Arrastra una tarjeta a otra columna, o usa <strong>Mover a…</strong> en la tarjeta.
    </p>
  </div>

  <div
    class="stale card tone-ambar"
    data-board-stale
    hidden={connection === "live"}
    role="status"
  >
    <Icon name="alert" size={18} />
    <p class="small" data-board-stale-text lang="es">{staleSentence}</p>
    <button
      type="button"
      class="btn btn-secondary"
      data-board-stale-action
      data-mode="offline"
      lang="es">Reconectar</button
    >
  </div>

  <div class="board-stage">
    <div class="board-slider">
      {
        panels.map((panel) => (
          <section
            class="panel"
            id={`panel-${panel.engagementType.code}`}
            data-panel
            data-engagement-code={panel.engagementType.code}
            hidden={panel.engagementType.code !== defaultEngagement}
            aria-label={`Tablero de ${panel.engagementType.label}`}
          >
            <div class="columns" data-columns>
              {panel.columns.map((column) => (
                <BoardColumn column={column} selectedCode={selectedCode} />
              ))}
            </div>
          </section>
        ))
      }
    </div>

    <div class="tpanel-slot">
      <TaskPanel selected={selected} />
    </div>
  </div>

  <div class="move-menu card" id="board-move-menu" data-move-menu hidden>
    <p
      class="label move-menu-title"
      id="board-move-menu-title"
      data-move-menu-title
      lang="es"
    >
    </p>
    <div
      class="move-menu-list"
      data-move-menu-list
      role="menu"
      aria-labelledby="board-move-menu-title"
    >
    </div>
  </div>

  <dialog
    class="reason-dialog"
    data-reason-dialog
    aria-labelledby="reason-title"
  >
    <form method="dialog" data-reason-form>
      <h2 class="h2" id="reason-title" lang="es">Motivo del cambio</h2>
      <p class="small" data-reason-context lang="es"></p>
      <label class="label reason-label" for="reason-input" lang="es"
        >Motivo</label
      >
      <textarea
        class="input"
        id="reason-input"
        data-reason-input
        rows="3"
        required
        lang="es"></textarea>
      <div class="reason-actions">
        <button
          type="button"
          class="btn btn-secondary"
          data-reason-cancel
          lang="es">Cancelar</button
        >
        <button
          type="submit"
          class="btn btn-primary"
          value="confirm"
          data-reason-submit
          disabled
          lang="es">Confirmar</button
        >
      </div>
    </form>
  </dialog>
</div>

<script is:inline define:vars={{ key: BOARD_ENGAGEMENT_KEY }}>
  // Applied before paint so the operator's board does not flash the alphabetically
  // first engagement type on every navigation. The module below re-applies it (and
  // owns every later switch); this is only the anti-flash pass. It steps aside when
  // the URL names a project: the page already opened the wall that card lives on,
  // and a stored preference must not fight a link somebody was sent.
  try {
    const stored = window.localStorage.getItem(key);
    const script = document.currentScript;
    const board = script === null ? null : script.previousElementSibling;
    const pinned =
      board !== null && board.getAttribute("data-selected") !== null;
    const panel =
      stored === null || board === null || pinned
        ? null
        : board.querySelector(
            `[data-panel][data-engagement-code="${CSS.escape(stored)}"]`,
          );
    if (board !== null && panel !== null && stored !== null) {
      board.setAttribute("data-engagement", stored);
      for (const candidate of board.querySelectorAll("[data-panel]")) {
        if (candidate === panel) candidate.removeAttribute("hidden");
        else candidate.setAttribute("hidden", "");
      }
      for (const pill of board.querySelectorAll("[data-engagement-pill]")) {
        pill.setAttribute(
          "aria-pressed",
          pill.getAttribute("data-engagement-code") === stored
            ? "true"
            : "false",
        );
      }
    }
  } catch {
    /* storage disabled: the server's default type stays selected */
  }
</script>

<script>
  import type { ProjectDetail } from "../lib/api/domain";
  import { getOperator } from "../lib/auth/session";
  import {
    countUp,
    flip,
    prefersReducedMotion,
    sampleSpring,
    shake,
    travelBy,
  } from "../lib/motion/spring";
  import { onReset, onStatus, retry, subscribe } from "../lib/stream/store";
  import type { Envelope } from "../lib/stream/store";
  import { toast } from "../lib/toast";
  import {
    BOARD_ENGAGEMENT_KEY,
    BOARD_PROJECT_PARAM,
    SEL,
    applyStateChip,
    bodyOf,
    cardsOf,
    columnOf,
    columnsOf,
    findCard,
    findColumn,
    isNewer,
    isPending,
    labelOf,
    markUpdatedAt,
    panelOf,
    patchStateChip,
    refreshColumn,
    rideAttribution,
    setPending,
    visibleCardsOf,
  } from "../components/board/board-dom";
  import { fieldList } from "../components/board/board-model";
  import type {
    TaskGroupModel,
    TaskRowModel,
  } from "../components/board/board-model";
  import {
    claimPanel,
    isCurrent,
    loadTasks,
    type TaskPanelResult,
  } from "../components/board/board-tasks";
  import {
    invalidateMoves,
    loadMoves,
    moveErrorCopy,
    submitMove,
    type MoveOption,
    type MovesResult,
  } from "../components/board/board-moves";

  /** Movement past which a press becomes a drag instead of a click. */
  const DRAG_THRESHOLD_PX = 4;
  /** Follower spring: stiff enough to obey, soft enough that the card visibly trails. */
  const FOLLOW_STIFFNESS = 260;
  /** Critical damping (2√k, mass 1): lag without wobble — mass, not jelly. */
  const FOLLOW_DAMPING = 2 * Math.sqrt(FOLLOW_STIFFNESS);
  /** Frame clamp, so a backgrounded tab does not integrate one enormous step. */
  const MAX_FRAME_SECONDS = 0.032;
  const FALLBACK_FRAME_SECONDS = 1 / 60;
  /** Tilt ceiling of DESIGN.md's grab step. */
  const MAX_TILT_DEG = 3;
  /** Degrees of tilt per px/s of horizontal velocity. */
  const TILT_PER_VELOCITY = 0.004;
  /** Grab scale of DESIGN.md's card lifecycle. */
  const GRAB_SCALE = 1.03;
  /**
   * How long a confirmed POST waits for its `project.state_changed` envelope before the card
   * settles from the response instead. Without it a dropped stream leaves a card spinning
   * forever over a change the server already made.
   */
  const CONFIRM_DEADLINE_MS = 8_000;
  /** How long the remote-move ring stays on the card. */
  const REMOTE_RING_MS = 900;
  const MENU_GAP_PX = 6;
  const VIEWPORT_MARGIN_PX = 8;
  /** Band at each edge of the slider inside which a carried card drags the wall along. */
  const AUTOSCROLL_ZONE_PX = 96;
  /** Top speed of that drag, in px per second at the very edge. */
  const AUTOSCROLL_MAX_PX_PER_SEC = 1_100;
  /** Width at which the task panel stops being a sheet and becomes a fixed column. */
  const PANEL_COLUMN_QUERY = "(min-width: 1280px)";
  /**
   * Trailing window for task events. A single edit can land as `task.updated` plus
   * `task.state_changed`, and re-reading the list once per frame of a burst is a request
   * storm for one visible change.
   */
  const TASK_REFRESH_DEBOUNCE_MS = 250;

  /** Why a card refuses to be picked up while the stream is down. */
  const STALE_DRAG_HINT =
    "Sin conexión en vivo: no puedes arrastrar tarjetas hasta reconectar.";
  const RESET_SENTENCE =
    "La conexión se reinició y no se pueden recuperar los eventos perdidos. Actualiza el tablero para volver a la verdad del servidor.";

  /** A press that has not yet travelled far enough to become a drag. */
  interface ArmedPress {
    readonly card: HTMLElement;
    readonly pointerId: number;
    readonly originX: number;
    readonly originY: number;
  }

  /** One live drag. Everything the follower, the legality paint and the drop need. */
  interface DragSession {
    readonly card: HTMLElement;
    readonly panel: HTMLElement;
    readonly originColumn: HTMLElement;
    /** The horizontal scroller the card is travelling over; `null` if there is none. */
    readonly scroller: HTMLElement | null;
    /** Holds the card's place in its origin column, so the hole stays visible. */
    readonly placeholder: HTMLElement;
    readonly pointerId: number;
    readonly cardHeight: number;
    /** Pointer offset inside the card at grab; the card hangs from this point. */
    readonly grabX: number;
    readonly grabY: number;
    readonly baseLeft: number;
    readonly baseTop: number;
    targetX: number;
    targetY: number;
    x: number;
    y: number;
    vx: number;
    vy: number;
    /** Auto-scroll speed in px/s, signed; zero away from the slider's edges. */
    autoScrollVx: number;
    lastFrame: number;
    frame: number | null;
    /** Legal moves by target state code; `null` until the lookup answers. */
    options: Map<string, MoveOption> | null;
    readonly slots: HTMLElement[];
  }

  /**
   * How a gesture ended.
   *
   * `refused` is kept apart from `released` because they mean different things to the hand:
   * a card dropped on a column that will not take it answers with the reject shake, while a
   * card released over nothing simply goes home (DESIGN.md §Motion, steps 3 and 4).
   */
  type DropOutcome =
    | { readonly kind: "accepted"; readonly column: HTMLElement }
    | { readonly kind: "refused" }
    | { readonly kind: "released" };

  /** Where the card physically sits while its transition is in flight. */
  type CardPlacement =
    | { readonly kind: "moved"; readonly from: HTMLElement }
    | { readonly kind: "waiting" };

  /**
   * One transition in flight, waiting for the envelope that confirms it.
   *
   * Registered before the POST departs, because the envelope can outrun the response: an
   * unregistered confirmation would leave the card spinning over a change already made.
   * `detail` and `timer` therefore arrive later, when (and if) the response does.
   */
  interface PendingMove {
    readonly card: HTMLElement;
    readonly code: string;
    readonly toStateCode: string;
    readonly targetLabel: string;
    readonly placement: CardPlacement;
    /** The server's answer, once it lands; `null` while the POST is still in flight. */
    detail: ProjectDetail | null;
    /** The confirmation deadline, armed only after the server accepted. */
    timer: number | null;
  }

  /** One requested move, from either input path. */
  interface MoveRequest {
    readonly card: HTMLElement;
    readonly code: string;
    readonly option: MoveOption;
    readonly targetLabel: string;
    readonly placement: CardPlacement;
  }

  /** How a selection came about; it decides history and focus, never the paint. */
  interface SelectOptions {
    /** Push a history entry, so the back button returns to the previous selection. */
    readonly push: boolean;
    /** Move focus onto the card — true only when the selection came from a pointer. */
    readonly focus: boolean;
  }

  /** Teardown of the currently mounted board; drained on `astro:before-swap`. */
  let cleanups: Array<() => void> = [];

  document.addEventListener("astro:page-load", () => {
    const board = document.querySelector<HTMLElement>(SEL.board);
    if (board === null || board.dataset["ready"] === "true") return;
    board.dataset["ready"] = "true";
    mount(board);
  });

  document.addEventListener("astro:before-swap", () => {
    for (const off of cleanups) off();
    cleanups = [];
  });

  /**
   * Wires one board. Everything below closes over `board`, so nothing survives a navigation
   * except through {@link cleanups} — a subscription left behind would keep patching cards
   * that are no longer in the document.
   */
  function mount(board: HTMLElement): void {
    const operator = getOperator();
    const operatorAlias = operator === null ? null : operator.alias;

    const menu = board.querySelector<HTMLElement>(SEL.moveMenu);
    const menuList = board.querySelector<HTMLElement>(SEL.moveMenuList);
    const menuTitle = board.querySelector<HTMLElement>(SEL.moveMenuTitle);
    const dialog = board.querySelector<HTMLDialogElement>(
      "[data-reason-dialog]",
    );
    const reasonInput = board.querySelector<HTMLTextAreaElement>(
      "[data-reason-input]",
    );
    const reasonSubmit = board.querySelector<HTMLButtonElement>(
      "[data-reason-submit]",
    );
    const reasonCancel = board.querySelector<HTMLButtonElement>(
      "[data-reason-cancel]",
    );
    const reasonContext = board.querySelector<HTMLElement>(
      "[data-reason-context]",
    );
    const staleBanner = board.querySelector<HTMLElement>(SEL.staleBanner);
    const staleText = board.querySelector<HTMLElement>(SEL.staleText);
    const staleAction = board.querySelector<HTMLButtonElement>(SEL.staleAction);
    const taskPanel = board.querySelector<HTMLElement>(SEL.taskPanel);

    const pendings = new Map<string, PendingMove>();
    let armed: ArmedPress | null = null;
    let drag: DragSession | null = null;
    let menuOwner: HTMLElement | null = null;
    let resolveReason: ((reason: string | null) => void) | null = null;
    let staleMode: "offline" | "reset" | null =
      board.dataset["connection"] === "stale" ? "offline" : null;
    const renderedLastEvent = board.dataset["lastEventAt"] ?? "";
    let lastEventAt: string | null =
      renderedLastEvent === "" ? null : renderedLastEvent;
    let selectedCode: string | null = board.dataset["selected"] ?? null;
    let memberFilter: string | null = null;
    let taskRefreshTimer: number | null = null;

    // --- Engagement panels -------------------------------------------------

    /** The panel currently on screen, which is the one every gesture acts on. */
    function activePanel(): HTMLElement | null {
      return board.querySelector<HTMLElement>(`${SEL.panel}:not([hidden])`);
    }

    /**
     * Shows one engagement type's board. The choice is persisted because an operations lead
     * lives in one type for a whole morning, and re-picking it on every visit is a tax.
     */
    function selectEngagement(code: string, persist: boolean): void {
      const target = board.querySelector<HTMLElement>(
        `${SEL.panel}[data-engagement-code="${CSS.escape(code)}"]`,
      );
      if (target === null) return;
      board.dataset["engagement"] = code;
      for (const panel of board.querySelectorAll<HTMLElement>(SEL.panel)) {
        panel.hidden = panel !== target;
      }
      for (const pill of board.querySelectorAll<HTMLElement>(
        SEL.switcherPill,
      )) {
        pill.setAttribute(
          "aria-pressed",
          pill.dataset["engagementCode"] === code ? "true" : "false",
        );
      }
      refreshRoving();
      if (!persist) return;
      try {
        window.localStorage.setItem(BOARD_ENGAGEMENT_KEY, code);
      } catch {
        /* storage disabled: the choice simply does not outlive the visit */
      }
    }

    // A URL that names a project already opened the right wall; a stored preference must
    // not overrule the link somebody was sent.
    if (selectedCode === null) {
      try {
        const stored = window.localStorage.getItem(BOARD_ENGAGEMENT_KEY);
        if (stored !== null) selectEngagement(stored, false);
      } catch {
        /* storage disabled: the server's default type stays selected */
      }
    }

    // --- Selection and the task panel --------------------------------------

    const tp = {
      title: query("[data-tp-title]"),
      sub: query("[data-tp-sub]"),
      close: query("[data-tp-close]"),
      project: query("[data-tp-project]"),
      code: query("[data-tp-code]"),
      state: query("[data-tp-state]"),
      name: query("[data-tp-name]"),
      client: query("[data-tp-client]"),
      owner: query("[data-tp-owner]"),
      link: query("[data-tp-link]"),
      idle: query("[data-tp-idle]"),
      loading: query("[data-tp-loading]"),
      error: query("[data-tp-error]"),
      errorTitle: query("[data-tp-error-title]"),
      errorDetail: query("[data-tp-error-detail]"),
      retry: query("[data-tp-retry]"),
      empty: query("[data-tp-empty]"),
      groups: query("[data-tp-groups]"),
    };

    function query(selector: string): HTMLElement | null {
      return taskPanel === null
        ? null
        : taskPanel.querySelector<HTMLElement>(selector);
    }

    function template(name: string): HTMLTemplateElement | null {
      return taskPanel === null
        ? null
        : taskPanel.querySelector<HTMLTemplateElement>(
            `[data-template="${name}"]`,
          );
    }

    /**
     * Shows exactly one arm of the panel body.
     *
     * All four states are real markup rendered by `TaskPanel.astro`; this only decides which
     * one is on screen, so no Spanish string is ever built inside the island.
     */
    function showPanelArm(
      arm: "idle" | "loading" | "error" | "empty" | "ready",
    ): void {
      if (taskPanel !== null) taskPanel.dataset["state"] = arm;
      if (tp.idle !== null) tp.idle.hidden = arm !== "idle";
      if (tp.loading !== null) tp.loading.hidden = arm !== "loading";
      if (tp.error !== null) tp.error.hidden = arm !== "error";
      if (tp.empty !== null) tp.empty.hidden = arm !== "empty";
      if (tp.groups !== null) tp.groups.hidden = arm !== "ready";
    }

    /**
     * Fills the panel header from the card itself.
     *
     * The card already carries every fact the header shows — code, name, client, state chip,
     * owner disk — so reading them here costs nothing, while a second
     * `GET /api/v1/projects/{code}` would be a second version of the same truth that can
     * disagree with what the operator is looking at (`PATTERNS_FRONTEND.md` §6). The owner
     * disk is cloned rather than rebuilt so its hue and its accessible name travel with it.
     */
    function fillPanelHeader(card: HTMLElement): void {
      const code = card.dataset["code"] ?? "";
      if (tp.title !== null) tp.title.textContent = `Tareas de ${code}`;
      if (tp.code !== null) tp.code.textContent = code;
      if (tp.name !== null) {
        tp.name.textContent = textOf(card, SEL.cardTitle);
      }
      if (tp.client !== null) {
        tp.client.textContent = textOf(card, SEL.cardClient);
      }
      const column = columnOf(card);
      if (tp.state !== null && column !== null)
        applyStateChip(tp.state, column);
      if (tp.owner !== null) {
        const disk = card.querySelector<HTMLElement>(SEL.cardOwner);
        tp.owner.replaceChildren(
          ...(disk === null ? [] : [disk.cloneNode(true)]),
        );
      }
      if (tp.link !== null) {
        tp.link.setAttribute("href", `/projects/${encodeURIComponent(code)}`);
      }
      if (tp.project !== null) tp.project.hidden = false;
      if (tp.close !== null) tp.close.hidden = false;
    }

    function textOf(root: ParentNode, selector: string): string {
      const found = root.querySelector<HTMLElement>(selector);
      return found === null ? "" : (found.textContent ?? "").trim();
    }

    /**
     * Selects one card: it becomes the panel's subject and the column's keyboard entry point.
     *
     * Re-selecting the same card is a no-op beyond focus — a second click must not restart
     * the read and blink the list the operator is reading.
     */
    function selectCard(card: HTMLElement, options: SelectOptions): void {
      const code = card.dataset["code"] ?? "";
      if (code === "") return;
      const changed = code !== selectedCode;
      selectedCode = code;
      board.dataset["selected"] = code;
      markSelection(code);
      fillPanelHeader(card);
      refreshRoving();
      syncUrl(code, options.push && changed);
      if (options.focus) card.focus();
      if (!changed) return;
      if (tp.sub !== null) {
        tp.sub.textContent = "Cargando las tareas del proyecto…";
      }
      showPanelArm("loading");
      playPanelEntrance();
      void refreshTasks(code);
    }

    /** Drops the selection: the panel goes back to inviting one. */
    function clearSelection(options: SelectOptions): void {
      const previous = selectedCode;
      selectedCode = null;
      claimPanel(null);
      delete board.dataset["selected"];
      markSelection(null);
      refreshRoving();
      syncUrl(null, options.push && previous !== null);
      if (tp.title !== null) tp.title.textContent = "Tareas";
      if (tp.sub !== null) tp.sub.textContent = "Ninguna tarjeta seleccionada.";
      if (tp.project !== null) tp.project.hidden = true;
      if (tp.close !== null) tp.close.hidden = true;
      if (tp.groups !== null) tp.groups.replaceChildren();
      showPanelArm("idle");
      if (!options.focus || previous === null) return;
      const card = findCard(board, previous);
      if (card !== null) card.focus();
    }

    function markSelection(code: string | null): void {
      for (const card of board.querySelectorAll<HTMLElement>(SEL.card)) {
        card.setAttribute(
          "aria-selected",
          card.dataset["code"] === code ? "true" : "false",
        );
      }
    }

    /**
     * Reads the selected project's tasks and paints them.
     *
     * The claim is taken *before* the request so a slower answer for a project the operator
     * already left is dropped instead of overwriting the panel they are now reading.
     */
    async function refreshTasks(code: string): Promise<void> {
      claimPanel(code);
      const result = await loadTasks(code, new Date());
      if (!isCurrent(code)) return;
      paintTasks(result);
    }

    function paintTasks(result: TaskPanelResult): void {
      if (result.kind === "error") {
        if (tp.errorTitle !== null) tp.errorTitle.textContent = result.title;
        if (tp.errorDetail !== null) tp.errorDetail.textContent = result.detail;
        if (tp.sub !== null) tp.sub.textContent = "No pudimos leer las tareas.";
        showPanelArm("error");
        return;
      }
      if (result.kind === "empty") {
        if (tp.groups !== null) tp.groups.replaceChildren();
        if (tp.sub !== null) tp.sub.textContent = "Sin tareas registradas.";
        showPanelArm("empty");
        return;
      }
      renderGroups(result.groups);
      showPanelArm("ready");
    }

    function renderGroups(groups: readonly TaskGroupModel[]): void {
      if (tp.groups === null) return;
      const total = groups.reduce((sum, group) => sum + group.tasks.length, 0);
      if (tp.sub !== null) {
        tp.sub.textContent = total === 1 ? "1 tarea" : `${total} tareas`;
      }
      tp.groups.replaceChildren(
        ...groups.flatMap((group) => {
          const node = buildGroup(group);
          return node === null ? [] : [node];
        }),
      );
    }

    function buildGroup(group: TaskGroupModel): HTMLElement | null {
      const tpl = template("group");
      if (tpl === null) return null;
      const fragment = tpl.content.cloneNode(true);
      if (!(fragment instanceof DocumentFragment)) return null;
      const section = fragment.querySelector<HTMLElement>("[data-tp-group]");
      if (section === null) return null;

      const dot = section.querySelector<HTMLElement>("[data-tp-group-dot]");
      if (dot !== null) {
        dot.classList.add(group.tone.className);
        if (group.tone.style !== null)
          dot.setAttribute("style", group.tone.style);
      }
      const title = section.querySelector<HTMLElement>("[data-tp-group-title]");
      if (title !== null) title.textContent = group.state.label;
      const count = section.querySelector<HTMLElement>("[data-tp-group-count]");
      if (count !== null) count.textContent = String(group.tasks.length);

      const rows = section.querySelector<HTMLElement>("[data-tp-group-rows]");
      if (rows !== null) {
        rows.replaceChildren(
          ...group.tasks.flatMap((task) => {
            const row = buildTaskRow(task);
            return row === null ? [] : [row];
          }),
        );
      }
      return section;
    }

    function buildTaskRow(task: TaskRowModel): HTMLElement | null {
      const tpl = template("task");
      if (tpl === null) return null;
      const fragment = tpl.content.cloneNode(true);
      if (!(fragment instanceof DocumentFragment)) return null;
      const row = fragment.querySelector<HTMLElement>("[data-tp-task]");
      if (row === null) return null;

      const title = row.querySelector<HTMLElement>("[data-tp-task-title]");
      if (title !== null) title.textContent = task.title;
      const code = row.querySelector<HTMLElement>("[data-tp-task-code]");
      if (code !== null) code.textContent = task.code;

      const owner = row.querySelector<HTMLElement>("[data-tp-task-owner]");
      if (owner !== null) {
        const disk = buildOwnerDisk(task);
        owner.replaceChildren(...(disk === null ? [] : [disk]));
      }

      const due = row.querySelector<HTMLElement>("[data-tp-task-due]");
      if (due !== null) {
        due.classList.add(task.due.toneClass);
        due.textContent = task.due.text;
        due.title = task.due.description;
      }

      const overdue = row.querySelector<HTMLElement>("[data-tp-task-overdue]");
      if (overdue !== null) overdue.hidden = !task.isOverdue;

      const deps = row.querySelector<HTMLElement>("[data-tp-task-deps]");
      if (deps !== null) {
        deps.hidden = task.dependencies.length === 0;
        deps.replaceChildren(
          ...task.dependencies.flatMap((dependency) => {
            const chip = buildDependency(
              dependency.text,
              dependency.description,
              dependency.isResolved,
            );
            return chip === null ? [] : [chip];
          }),
        );
      }
      return row;
    }

    function buildOwnerDisk(task: TaskRowModel): HTMLElement | null {
      const owner = task.owner;
      if (owner === null) return null;
      const tpl = template("owner");
      if (tpl === null) return null;
      const fragment = tpl.content.cloneNode(true);
      if (!(fragment instanceof DocumentFragment)) return null;
      const disk = fragment.querySelector<HTMLElement>("[data-tp-owner-disk]");
      if (disk === null) return null;
      disk.textContent = owner.initials;
      disk.style.setProperty("--avatar-h", String(owner.hue));
      disk.title = owner.label;
      disk.setAttribute("aria-label", `Responsable: ${owner.label}`);
      return disk;
    }

    function buildDependency(
      label: string,
      description: string,
      isResolved: boolean,
    ): HTMLElement | null {
      const tpl = template("dependency");
      if (tpl === null) return null;
      const fragment = tpl.content.cloneNode(true);
      if (!(fragment instanceof DocumentFragment)) return null;
      const chip = fragment.querySelector<HTMLElement>("[data-tp-dep]");
      if (chip === null) return null;
      chip.textContent = label;
      chip.title = description;
      chip.dataset["resolved"] = isResolved ? "true" : "false";
      return chip;
    }

    /**
     * The one authored motion beyond the drag: the panel arrives on the `panel` spring, from
     * the side it lives on — the right at column width, from below when it is a sheet.
     */
    function playPanelEntrance(): void {
      if (taskPanel === null || prefersReducedMotion()) return;
      const asColumn = window.matchMedia(PANEL_COLUMN_QUERY).matches;
      const from = asColumn ? "translateX(16px)" : "translateY(24px)";
      const { duration, easing } = sampleSpring("panel");
      taskPanel.animate(
        [
          { opacity: 0, transform: from },
          { opacity: 1, transform: "none" },
        ],
        { duration, easing },
      );
    }

    /**
     * Writes the selection into the URL.
     *
     * `pushState` on a real change so the back button walks the selections the operator made;
     * `replaceState` otherwise, so restoring a selection from history does not push it again.
     */
    function syncUrl(code: string | null, push: boolean): void {
      const url = new URL(window.location.href);
      if (code === null) url.searchParams.delete(BOARD_PROJECT_PARAM);
      else url.searchParams.set(BOARD_PROJECT_PARAM, code);
      const next = `${url.pathname}${url.search}`;
      if (next === `${window.location.pathname}${window.location.search}`) {
        return;
      }
      if (push) window.history.pushState({}, "", next);
      else window.history.replaceState({}, "", next);
    }

    function onPopState(): void {
      if (!window.location.pathname.startsWith("/board")) return;
      const code = new URL(window.location.href).searchParams.get(
        BOARD_PROJECT_PARAM,
      );
      const card = code === null ? null : findCard(board, code);
      if (card === null) {
        clearSelection({ push: false, focus: false });
        return;
      }
      selectCard(card, { push: false, focus: false });
    }

    // The server rendered the header for `?project=`; the list is this island's to fetch.
    if (selectedCode !== null) void refreshTasks(selectedCode);

    // --- Member filter ------------------------------------------------------

    /**
     * Narrows the wall to one person's projects, or lifts the filter.
     *
     * Cards are hidden, never removed: a filtered board has to snap back without a refetch,
     * and a card removed mid-transition would lose the pending move it is carrying.
     */
    function applyMemberFilter(alias: string | null): void {
      memberFilter = alias;
      for (const card of board.querySelectorAll<HTMLElement>(SEL.card)) {
        const owner = card.dataset["ownerAlias"] ?? "";
        card.hidden = alias !== null && owner !== alias;
      }
      for (const column of board.querySelectorAll<HTMLElement>(SEL.column)) {
        refreshColumn(column);
      }
      for (const button of board.querySelectorAll<HTMLElement>(SEL.member)) {
        button.setAttribute(
          "aria-pressed",
          button.dataset["alias"] === alias ? "true" : "false",
        );
      }
      refreshEngagementCounts();
      refreshRoving();
    }

    /** Pill counts follow the filter: a count that ignores it names a board nobody sees. */
    function refreshEngagementCounts(): void {
      for (const panel of board.querySelectorAll<HTMLElement>(SEL.panel)) {
        const code = panel.dataset["engagementCode"] ?? "";
        const total = columnsOf(panel).reduce(
          (sum, column) => sum + visibleCardsOf(column).length,
          0,
        );
        const pill = board.querySelector<HTMLElement>(
          `${SEL.switcherPill}[data-engagement-code="${CSS.escape(code)}"]`,
        );
        const chip =
          pill === null
            ? null
            : pill.querySelector<HTMLElement>("[data-engagement-count]");
        if (chip !== null) chip.textContent = String(total);
      }
    }

    function toggleMemberOverflow(trigger: HTMLElement): void {
      const expanded = trigger.getAttribute("aria-expanded") === "true";
      trigger.setAttribute("aria-expanded", expanded ? "false" : "true");
      const bar = trigger.closest<HTMLElement>("[data-member-bar]");
      if (bar === null) return;
      for (const hiddenMember of bar.querySelectorAll<HTMLElement>(
        "[data-overflow]",
      )) {
        hiddenMember.hidden = expanded;
      }
    }

    // --- Keyboard: the board is a grid --------------------------------------

    /**
     * Moves focus onto one card and makes it the column's tab stop.
     *
     * Roving `tabindex` rather than a tab stop per card: a wall of forty cards that each take
     * a Tab press is a wall nobody reaches the end of.
     */
    function focusCard(card: HTMLElement): void {
      refreshRoving(card);
      card.focus();
      card.scrollIntoView({ block: "nearest", inline: "nearest" });
    }

    function refreshRoving(preferred?: HTMLElement): void {
      const panel = activePanel();
      for (const card of board.querySelectorAll<HTMLElement>(SEL.card)) {
        card.tabIndex = -1;
      }
      if (panel === null) return;
      const chosen =
        preferred ??
        (selectedCode === null ? null : findCard(panel, selectedCode)) ??
        firstVisibleCard(panel);
      if (chosen !== null && !chosen.hidden) chosen.tabIndex = 0;
    }

    function firstVisibleCard(panel: HTMLElement): HTMLElement | null {
      for (const column of columnsOf(panel)) {
        const first = visibleCardsOf(column)[0];
        if (first !== undefined) return first;
      }
      return null;
    }

    function onBoardKeyDown(event: KeyboardEvent): void {
      const target = event.target;
      if (!(target instanceof Element)) return;
      const card = target.closest<HTMLElement>(SEL.card);
      if (card === null) return;
      if (event.key === "ArrowDown" || event.key === "ArrowUp") {
        const column = columnOf(card);
        if (column === null) return;
        const siblings = visibleCardsOf(column);
        const next =
          siblings[
            siblings.indexOf(card) + (event.key === "ArrowDown" ? 1 : -1)
          ];
        if (next === undefined) return;
        event.preventDefault();
        focusCard(next);
        return;
      }
      if (event.key === "ArrowRight" || event.key === "ArrowLeft") {
        const next = neighbourCard(card, event.key === "ArrowRight" ? 1 : -1);
        if (next === null) return;
        event.preventDefault();
        focusCard(next);
        return;
      }
      if (event.key !== "Enter" && event.key !== " ") return;
      // The move trigger and any link inside keep their own activation keys.
      if (target.closest("button, a, textarea, input") !== null) return;
      event.preventDefault();
      selectCard(card, { push: true, focus: false });
    }

    /** The card at the same height in the nearest column that has any, in `step` direction. */
    function neighbourCard(
      card: HTMLElement,
      step: 1 | -1,
    ): HTMLElement | null {
      const column = columnOf(card);
      const panel = panelOf(card);
      if (column === null || panel === null) return null;
      const columns = columnsOf(panel);
      const row = visibleCardsOf(column).indexOf(card);
      for (
        let index = columns.indexOf(column) + step;
        index >= 0 && index < columns.length;
        index += step
      ) {
        const candidate = columns[index];
        if (candidate === undefined) continue;
        const cards = visibleCardsOf(candidate);
        if (cards.length === 0) continue;
        return cards[Math.min(Math.max(row, 0), cards.length - 1)] ?? null;
      }
      return null;
    }

    // --- Drag: grab --------------------------------------------------------

    function onPointerDown(event: PointerEvent): void {
      if (event.pointerType === "mouse" && event.button !== 0) return;
      if (board.dataset["connection"] === "stale") return;
      const target = event.target;
      if (!(target instanceof Element)) return;
      // Links and controls keep their own gestures; the rest of the card is the grip.
      if (target.closest("a, button, textarea, input") !== null) return;
      const card = target.closest<HTMLElement>(SEL.card);
      if (card === null || isPending(card)) return;
      closeMenu();
      // Stops the press from starting a text selection that would fight the drag; the
      // interactive parts of the card were excluded above, so nothing loses its focus.
      event.preventDefault();
      armed = {
        card,
        pointerId: event.pointerId,
        originX: event.clientX,
        originY: event.clientY,
      };
      card.setPointerCapture(event.pointerId);
    }

    function onPointerMove(event: PointerEvent): void {
      const session = drag;
      if (session === null) {
        const press = armed;
        if (press === null || press.pointerId !== event.pointerId) return;
        const travelled = Math.hypot(
          event.clientX - press.originX,
          event.clientY - press.originY,
        );
        if (travelled < DRAG_THRESHOLD_PX) return;
        beginDrag(press, event);
        return;
      }
      if (event.pointerId !== session.pointerId) return;
      session.targetX = event.clientX - session.grabX - session.baseLeft;
      session.targetY = event.clientY - session.grabY - session.baseTop;
      session.autoScrollVx = edgeVelocity(session, event.clientX);
      updateHover(session, event.clientX, event.clientY);
    }

    /**
     * A press that never became a drag is a click, and a click on a card selects it.
     *
     * Decided here rather than in a `click` listener because the pointer capture the grab
     * takes can swallow the synthetic click on some browsers; the press we armed is the
     * honest record that a finger went down and came up on the same card.
     */
    function onPointerUp(event: PointerEvent): void {
      const press = armed;
      armed = null;
      const session = drag;
      if (session === null) {
        if (press === null || press.pointerId !== event.pointerId) return;
        const target = event.target;
        if (target instanceof Element && target.closest("a, button") !== null) {
          return;
        }
        selectCard(press.card, { push: true, focus: true });
        return;
      }
      if (event.pointerId !== session.pointerId) return;
      const column = columnAt(session, event.clientX, event.clientY);
      if (column === null) {
        concludeDrag(session, { kind: "released" });
        return;
      }
      if (column.dataset["drop"] === "legal") {
        concludeDrag(session, { kind: "accepted", column });
        return;
      }
      concludeDrag(session, { kind: "refused" });
    }

    function onPointerCancel(event: PointerEvent): void {
      armed = null;
      const session = drag;
      if (session === null || event.pointerId !== session.pointerId) return;
      concludeDrag(session, { kind: "released" });
    }

    /**
     * Lifts the card out of flow and starts the follower.
     *
     * The card becomes `position: fixed` at exactly the rect it occupied, and a placeholder
     * takes its place, so the origin column keeps the hole the card came out of instead of
     * closing over it — you can always see where you are moving *from*.
     */
    function beginDrag(press: ArmedPress, event: PointerEvent): void {
      armed = null;
      const card = press.card;
      const column = columnOf(card);
      const panel = panelOf(card);
      if (column === null || panel === null) return;

      const rect = card.getBoundingClientRect();
      const placeholder = document.createElement("div");
      placeholder.className = "drop-slot is-origin";
      placeholder.setAttribute("role", "presentation");
      placeholder.style.height = `${rect.height}px`;
      card.before(placeholder);

      card.style.position = "fixed";
      card.style.left = `${rect.left}px`;
      card.style.top = `${rect.top}px`;
      card.style.width = `${rect.width}px`;
      card.style.margin = "0";
      card.dataset["dragging"] = "true";
      document.documentElement.dataset["boardDragging"] = "true";

      const session: DragSession = {
        card,
        panel,
        originColumn: column,
        scroller: panel.querySelector<HTMLElement>(SEL.columns),
        placeholder,
        pointerId: press.pointerId,
        cardHeight: rect.height,
        grabX: event.clientX - rect.left,
        grabY: event.clientY - rect.top,
        baseLeft: rect.left,
        baseTop: rect.top,
        targetX: 0,
        targetY: 0,
        x: 0,
        y: 0,
        vx: 0,
        vy: 0,
        autoScrollVx: 0,
        lastFrame: performance.now(),
        frame: null,
        options: null,
        slots: [],
      };
      drag = session;
      session.frame = requestAnimationFrame(step);
      void announceLegality(session);
    }

    /**
     * One frame of the follower: a critically damped spring pulling the card toward the
     * pointer, plus a tilt proportional to its own horizontal velocity, plus the wall sliding
     * under it when the card is held at an edge.
     *
     * The lag *is* the mass — the card arrives after the hand, which is what makes it read as
     * an object rather than a cursor decoration. Under reduced motion the card tracks the
     * pointer exactly and neither tilts nor scales; the auto-scroll stays, because it is
     * reach, not decoration.
     */
    function step(now: number): void {
      const session = drag;
      if (session === null) return;
      const elapsed = (now - session.lastFrame) / 1000;
      const dt =
        elapsed > 0
          ? Math.min(MAX_FRAME_SECONDS, elapsed)
          : FALLBACK_FRAME_SECONDS;
      session.lastFrame = now;

      if (session.autoScrollVx !== 0 && session.scroller !== null) {
        session.scroller.scrollLeft += session.autoScrollVx * dt;
      }

      const reduced = prefersReducedMotion();
      if (reduced) {
        session.x = session.targetX;
        session.y = session.targetY;
        session.vx = 0;
        session.vy = 0;
      } else {
        const ax =
          FOLLOW_STIFFNESS * (session.targetX - session.x) -
          FOLLOW_DAMPING * session.vx;
        const ay =
          FOLLOW_STIFFNESS * (session.targetY - session.y) -
          FOLLOW_DAMPING * session.vy;
        session.vx += ax * dt;
        session.vy += ay * dt;
        session.x += session.vx * dt;
        session.y += session.vy * dt;
      }

      const tilt = reduced
        ? 0
        : clamp(session.vx * TILT_PER_VELOCITY, -MAX_TILT_DEG, MAX_TILT_DEG);
      const scale = reduced ? 1 : GRAB_SCALE;
      session.card.style.transform = `translate3d(${session.x.toFixed(2)}px, ${session.y.toFixed(2)}px, 0) scale(${scale}) rotate(${tilt.toFixed(2)}deg)`;
      session.frame = requestAnimationFrame(step);
    }

    /**
     * How fast the slider should travel with a card held near its edge, in px/s.
     *
     * A board wider than the viewport is unreachable without it: the hand cannot both hold a
     * card and scroll the wall. Speed ramps with depth into the band so a card resting just
     * inside the edge creeps instead of bolting.
     */
    function edgeVelocity(session: DragSession, x: number): number {
      const scroller = session.scroller;
      if (scroller === null) return 0;
      if (scroller.scrollWidth <= scroller.clientWidth) return 0;
      const rect = scroller.getBoundingClientRect();
      const fromLeft = x - rect.left;
      const fromRight = rect.right - x;
      if (fromLeft < AUTOSCROLL_ZONE_PX && scroller.scrollLeft > 0) {
        const depth = clamp(1 - fromLeft / AUTOSCROLL_ZONE_PX, 0, 1);
        return -depth * AUTOSCROLL_MAX_PX_PER_SEC;
      }
      const maxScroll = scroller.scrollWidth - scroller.clientWidth;
      if (fromRight < AUTOSCROLL_ZONE_PX && scroller.scrollLeft < maxScroll) {
        const depth = clamp(1 - fromRight / AUTOSCROLL_ZONE_PX, 0, 1);
        return depth * AUTOSCROLL_MAX_PX_PER_SEC;
      }
      return 0;
    }

    // --- Drag: the board announces legality --------------------------------

    /**
     * Asks the project which moves it may take and paints the answer on the columns.
     *
     * A failed lookup does not abort the gesture: every column simply refuses, the drop
     * springs back, and the operator reads why in a toast. Aborting mid-gesture would yank
     * the card out of a hand that is still holding it.
     */
    async function announceLegality(session: DragSession): Promise<void> {
      const code = session.card.dataset["code"] ?? "";
      const result = await loadMoves(code);
      if (drag !== session) return;
      if (result.kind === "error") {
        session.options = new Map();
        toast({ kind: "error", title: result.title, detail: result.detail });
      } else {
        session.options = new Map(
          result.options.map((option) => [option.toStateCode, option]),
        );
      }
      paintLegality(session);
    }

    function paintLegality(session: DragSession): void {
      const options = session.options;
      if (options === null) return;
      const originLabel = labelOf(session.originColumn);
      for (const column of columnsOf(session.panel)) {
        if (column === session.originColumn) {
          column.dataset["drop"] = "origin";
          continue;
        }
        const option = options.get(column.dataset["stateCode"] ?? "");
        if (option === undefined) {
          lockColumn(column, "illegal", `Sin transición desde ${originLabel}`);
          continue;
        }
        if (option.missingFields.length > 0) {
          lockColumn(
            column,
            "blocked",
            `Falta ${fieldList(option.missingFields)} en el proyecto`,
          );
          continue;
        }
        openSlot(session, column);
      }
    }

    /** A column that cannot take the card says so, in words, and steps back. */
    function lockColumn(
      column: HTMLElement,
      drop: "illegal" | "blocked",
      reason: string,
    ): void {
      column.dataset["drop"] = drop;
      const text = column.querySelector<HTMLElement>(SEL.columnLockText);
      if (text !== null) text.textContent = reason;
      const chip = column.querySelector<HTMLElement>(SEL.columnLock);
      if (chip !== null) chip.hidden = false;
    }

    /** A legal column opens a dashed slot the height of the card, and its cards make room. */
    function openSlot(session: DragSession, column: HTMLElement): void {
      column.dataset["drop"] = "legal";
      const body = bodyOf(column);
      if (body === null) return;
      const slot = document.createElement("div");
      slot.className = "drop-slot";
      slot.dataset["dropSlot"] = "true";
      // The card list is a grid; a slot is scenery inside it, not a row.
      slot.setAttribute("role", "presentation");
      slot.style.height = `${session.cardHeight}px`;
      const siblings = cardsOf(column);
      void flip(siblings, () => {
        body.prepend(slot);
      });
      if (!prefersReducedMotion()) {
        const { duration, easing } = sampleSpring("carta");
        slot.animate(
          [
            { opacity: 0, transform: "scaleY(0.4)" },
            { opacity: 1, transform: "none" },
          ],
          { duration, easing },
        );
      }
      session.slots.push(slot);
    }

    function clearLegality(session: DragSession): void {
      for (const column of columnsOf(session.panel)) {
        column.dataset["drop"] = "idle";
        delete column.dataset["hover"];
        const chip = column.querySelector<HTMLElement>(SEL.columnLock);
        if (chip !== null) chip.hidden = true;
      }
      for (const slot of session.slots) slot.remove();
      session.slots.length = 0;
    }

    function updateHover(session: DragSession, x: number, y: number): void {
      const hovered = columnAt(session, x, y);
      for (const column of columnsOf(session.panel)) {
        if (column === hovered && column.dataset["drop"] === "legal") {
          column.dataset["hover"] = "true";
        } else {
          delete column.dataset["hover"];
        }
      }
    }

    /**
     * The column under the pointer, by rect arithmetic rather than `elementFromPoint`: the
     * dragged card is captured and floating above everything, so hit testing through it is
     * exactly what we must not rely on.
     *
     * Rects are measured on every call, which is also what keeps the drop slot honest while
     * the slider auto-scrolls under the hand: the columns move, the arithmetic follows.
     *
     * A column is claimed by its horizontal band across the whole height of the board, not by
     * its own box. Columns are as tall as their contents, and a card released below a short
     * column is unmistakably aimed at that column — refusing it because the box ended two
     * hundred pixels higher would be the interface being pedantic about its own layout.
     */
    function columnAt(
      session: DragSession,
      x: number,
      y: number,
    ): HTMLElement | null {
      const boxes = columnsOf(session.panel).map((column) => ({
        column,
        rect: column.getBoundingClientRect(),
      }));
      if (boxes.length === 0) return null;
      const top = Math.min(...boxes.map((box) => box.rect.top));
      const bottom = Math.max(...boxes.map((box) => box.rect.bottom));
      if (y < top || y > bottom) return null;
      for (const box of boxes) {
        if (x >= box.rect.left && x <= box.rect.right) return box.column;
      }
      return null;
    }

    // --- Drag: drop and reject ---------------------------------------------

    /**
     * Ends the gesture: the card returns to flow — in the column that accepted it, or in the
     * hole it came out of — and travels there along one arc.
     *
     * Layout is mutated first and animated after, which is the contract of
     * `lib/motion/spring.ts`: measure, mutate, then play the journey from the old rect. Doing
     * it the other way round leaves reduced-motion users looking at stale positions.
     */
    function concludeDrag(session: DragSession, outcome: DropOutcome): void {
      drag = null;
      if (session.frame !== null) cancelAnimationFrame(session.frame);
      delete document.documentElement.dataset["boardDragging"];
      if (session.card.hasPointerCapture(session.pointerId)) {
        session.card.releasePointerCapture(session.pointerId);
      }

      const target = outcome.kind === "accepted" ? outcome.column : null;
      const from = session.card.getBoundingClientRect();
      const affected = affectedCards(session, target);

      void flip(affected, () => {
        unfix(session.card);
        if (target === null) {
          session.placeholder.replaceWith(session.card);
        } else {
          const slot = session.slots.find(
            (candidate) => columnOf(candidate) === target,
          );
          if (slot !== undefined) {
            slot.replaceWith(session.card);
          } else {
            const body = bodyOf(target);
            if (body !== null) body.prepend(session.card);
          }
          session.placeholder.remove();
        }
        clearLegality(session);
      });

      const to = session.card.getBoundingClientRect();
      const journey = glide(session.card, from, to);

      refreshColumn(session.originColumn);
      if (target === null) {
        // The wall refusing the card is a physical answer, after it lands, not during.
        if (outcome.kind === "refused") {
          void journey.then(() => shake(session.card));
        }
        refreshRoving();
        return;
      }
      refreshColumn(target);
      refreshRoving();

      const options = session.options;
      const option =
        options === null
          ? undefined
          : options.get(target.dataset["stateCode"] ?? "");
      if (option === undefined) return;
      void performMove({
        card: session.card,
        code: session.card.dataset["code"] ?? "",
        option,
        targetLabel: labelOf(target),
        placement: { kind: "moved", from: session.originColumn },
      });
    }

    /** Every card whose position the drop changes — the FLIP set. */
    function affectedCards(
      session: DragSession,
      target: HTMLElement | null,
    ): HTMLElement[] {
      const columns = new Set<HTMLElement>([session.originColumn]);
      for (const slot of session.slots) {
        const column = columnOf(slot);
        if (column !== null) columns.add(column);
      }
      if (target !== null) columns.add(target);
      const cards: HTMLElement[] = [];
      for (const column of columns) {
        for (const card of cardsOf(column)) {
          if (card !== session.card) cards.push(card);
        }
      }
      return cards;
    }

    function unfix(card: HTMLElement): void {
      card.style.position = "";
      card.style.left = "";
      card.style.top = "";
      card.style.width = "";
      card.style.margin = "";
      card.style.transform = "";
      delete card.dataset["dragging"];
    }

    /**
     * Plays a card from where it was to where it now sits: an arc on the `carta` spring, or
     * a 120ms crossfade when the operator asked for reduced motion. Resolves when it settles,
     * so a caller can chain the reject shake instead of animating over the journey.
     */
    async function glide(
      card: HTMLElement,
      from: DOMRect,
      to: DOMRect,
    ): Promise<void> {
      if (prefersReducedMotion()) {
        await crossfade(card);
        return;
      }
      await travelBy(card, from.left - to.left, from.top - to.top);
    }

    async function crossfade(card: HTMLElement): Promise<void> {
      const animation = card.animate([{ opacity: 0 }, { opacity: 1 }], {
        duration: 120,
      });
      await animation.finished.catch(() => undefined);
    }

    // --- The move itself (shared by the drag and the menu) -----------------

    /**
     * Runs one transition: reason if the edge demands one, POST, then wait for the stream.
     *
     * Nothing is painted as done here. The card enters the pending state and the *server's*
     * envelope is what repaints it (`PATTERNS_FRONTEND.md` §8); a refusal sends the card
     * home along its own path with a shake and a toast naming the rule that refused it.
     */
    async function performMove(request: MoveRequest): Promise<void> {
      const { card, code, option, targetLabel, placement } = request;
      // Pending from the first instant, dialog included: a card sitting in a column it has
      // not been accepted into must never look settled.
      setPending(card, true);

      let reason = "";
      if (option.requiresReason) {
        const given = await askReason(code, targetLabel);
        if (given === null) {
          setPending(card, false);
          if (placement.kind === "moved")
            moveCard(card, placement.from, "travel");
          return;
        }
        reason = given;
      }

      const pending: PendingMove = {
        card,
        code,
        toStateCode: option.toStateCode,
        targetLabel,
        placement,
        detail: null,
        timer: null,
      };
      pendings.set(code, pending);

      const result = await submitMove(code, option.toStateCode, reason);
      // The stream may have confirmed (or superseded) this move while we waited; whoever
      // holds the entry now owns the card, and it is no longer us.
      if (pendings.get(code) !== pending) return;

      if (!result.ok) {
        pendings.delete(code);
        setPending(card, false);
        if (placement.kind === "moved")
          moveCard(card, placement.from, "travel");
        void shake(card);
        const copy = moveErrorCopy(result.error, code, targetLabel);
        toast({ kind: "error", title: copy.title, detail: copy.detail });
        return;
      }

      pending.detail = result.data;
      pending.timer = window.setTimeout(() => {
        settleWithoutEnvelope(code);
      }, CONFIRM_DEADLINE_MS);
    }

    /**
     * Applies the confirmed state to a card: it lands in its column, the chip snaps, the
     * counts follow, and the panel header follows when the card is the selected one.
     *
     * `occurredAt` is the envelope's instant when there was one, so the stale-patch watermark
     * advances to the event rather than to the moment we happened to render it.
     */
    function settle(pending: PendingMove, occurredAt: string | null): void {
      if (pending.timer !== null) window.clearTimeout(pending.timer);
      pendings.delete(pending.code);
      setPending(pending.card, false);
      const stamp =
        occurredAt ??
        (pending.detail === null ? null : pending.detail.updated_at);
      if (stamp !== null) markUpdatedAt(pending.card, stamp);
      invalidateMoves(pending.code);

      const panel = panelOf(pending.card);
      const column =
        panel === null ? null : findColumn(panel, pending.toStateCode);
      if (column === null) {
        dropFromBoard(pending.card, pending.code, pending.targetLabel);
        return;
      }
      if (columnOf(pending.card) !== column)
        moveCard(pending.card, column, "travel");
      patchStateChip(pending.card, column);
      syncPanelState(pending.code, column);
    }

    /** The panel header names the same state the card does, or it is telling a second story. */
    function syncPanelState(code: string, column: HTMLElement): void {
      if (code !== selectedCode || tp.state === null) return;
      applyStateChip(tp.state, column);
    }

    function confirmFromEnvelope(
      pending: PendingMove,
      envelope: Envelope,
    ): void {
      settle(pending, envelope.occurred_at);
      toast({
        kind: "success",
        title: `${pending.code} → ${pending.targetLabel}`,
        detail: "Confirmado por el servidor.",
      });
    }

    /**
     * The confirmation deadline: the POST was accepted but no envelope arrived (a stream that
     * is down, or a fan-out that lost the frame). The change is real — the response proved
     * it — so the card settles and the toast says the live confirmation is what is missing.
     */
    function settleWithoutEnvelope(code: string): void {
      const pending = pendings.get(code);
      if (pending === undefined) return;
      settle(pending, null);
      toast({
        kind: "info",
        title: `${code} → ${pending.targetLabel}`,
        detail: "El servidor lo aceptó, pero el aviso en vivo no llegó.",
      });
    }

    /**
     * Moves a card into a column and animates the journey.
     *
     * The DOM move happens inside `flip`, so the cards that make room travel with the same
     * spring as the card itself; the card's own glide is measured around it. Selection is an
     * attribute on the card, so it travels with the node and survives every reorder.
     */
    function moveCard(
      card: HTMLElement,
      column: HTMLElement,
      motion: "travel" | "none",
    ): void {
      const body = bodyOf(column);
      if (body === null) return;
      const previous = columnOf(card);
      const from = card.getBoundingClientRect();
      const affected = [
        ...cardsOf(column),
        ...(previous === null ? [] : cardsOf(previous)),
      ].filter((candidate) => candidate !== card);

      void flip(affected, () => {
        body.prepend(card);
      });

      const to = card.getBoundingClientRect();
      if (previous !== null) refreshColumn(previous);
      refreshColumn(column);
      refreshRoving();
      if (motion === "travel") void glide(card, from, to);
    }

    /**
     * A project moved into a state that has no column here — the board draws the states that
     * are occupied, and nobody was in that one. The card leaves rather than lying about where
     * the project is, and the toast says what happened.
     */
    function dropFromBoard(
      card: HTMLElement,
      code: string,
      /** The state's label when we have one; its bare code when the envelope is all we got. */
      stateName: string,
    ): void {
      const column = columnOf(card);
      const siblings =
        column === null
          ? []
          : cardsOf(column).filter((candidate) => candidate !== card);
      void flip(siblings, () => {
        card.remove();
      });
      if (column !== null) refreshColumn(column);
      if (code === selectedCode) clearSelection({ push: false, focus: false });
      refreshRoving();
      toast({
        kind: "info",
        title: `${code} salió del tablero`,
        detail: `Pasó a ${stateName}, un estado que hoy no tiene columna. Actualiza el tablero para verlo.`,
      });
    }

    // --- Reason dialog ------------------------------------------------------

    /**
     * Collects the reason an edge marked `requires_reason` demands, before the request.
     *
     * A modal is correct here and nowhere else on this surface: it is a confirmation the
     * operator asked for by dropping the card, and the transition cannot proceed without it
     * (DESIGN.md, Don'ts). Cancelling resolves `null` and the card goes home.
     */
    function askReason(
      code: string,
      targetLabel: string,
    ): Promise<string | null> {
      if (dialog === null || reasonInput === null) return Promise.resolve(null);
      reasonInput.value = "";
      if (reasonSubmit !== null) reasonSubmit.disabled = true;
      if (reasonContext !== null) {
        reasonContext.textContent = `${code} pasa a ${targetLabel}. Esta transición exige un motivo.`;
      }
      dialog.showModal();
      reasonInput.focus();
      return new Promise<string | null>((resolve) => {
        resolveReason = resolve;
      });
    }

    function onDialogClose(): void {
      const resolve = resolveReason;
      resolveReason = null;
      if (resolve === null) return;
      const confirmed = dialog !== null && dialog.returnValue === "confirm";
      const typed = reasonInput === null ? "" : reasonInput.value.trim();
      resolve(confirmed && typed !== "" ? typed : null);
    }

    function onReasonInput(): void {
      if (reasonSubmit === null || reasonInput === null) return;
      reasonSubmit.disabled = reasonInput.value.trim() === "";
    }

    // --- "Mover a…": the keyboard and touch twin ---------------------------

    async function openMenu(trigger: HTMLElement): Promise<void> {
      if (menu === null || menuList === null) return;
      const card = trigger.closest<HTMLElement>(SEL.card);
      if (card === null) return;
      const code = card.dataset["code"] ?? "";

      closeMenu();
      menuOwner = trigger;
      trigger.setAttribute("aria-expanded", "true");
      trigger.classList.add("is-loading");
      if (menuTitle !== null) menuTitle.textContent = `Mover ${code} a…`;
      menuList.replaceChildren(buildNote("Consultando movimientos…"));
      menu.hidden = false;
      positionMenu(trigger);

      const result = await loadMoves(code);
      trigger.classList.remove("is-loading");
      if (menuOwner !== trigger) return;
      renderMenu(result, card, code);
      positionMenu(trigger);
      focusFirstItem();
    }

    function renderMenu(
      result: MovesResult,
      card: HTMLElement,
      code: string,
    ): void {
      if (menuList === null) return;
      if (result.kind === "error") {
        menuList.replaceChildren(
          buildNote(`${result.title}. ${result.detail}`),
        );
        return;
      }
      if (result.options.length === 0) {
        menuList.replaceChildren(
          buildNote(`Sin movimientos legales desde ${result.stateLabel}.`),
        );
        return;
      }
      menuList.replaceChildren(
        ...result.options.map((option, index) =>
          buildMenuItem(option, card, code, index),
        ),
      );
    }

    /**
     * One target state as a menu item. A transition whose `requires_fields` are empty on the
     * project renders present and visibly dead, naming the field — the same rule the drag
     * paints as a locked column (`FRONTEND.md` §8).
     */
    function buildMenuItem(
      option: MoveOption,
      card: HTMLElement,
      code: string,
      index: number,
    ): HTMLElement {
      const item = document.createElement("div");
      item.className = "move-item";

      const button = document.createElement("button");
      button.type = "button";
      button.className = "move-option";
      button.setAttribute("role", "menuitem");
      button.lang = "es";
      button.textContent = option.label;
      item.append(button);

      if (option.missingFields.length > 0) {
        const noteId = `move-missing-${index}`;
        button.disabled = true;
        button.setAttribute("aria-describedby", noteId);
        const note = document.createElement("span");
        note.className = "small move-missing";
        note.id = noteId;
        note.lang = "es";
        note.textContent = `Falta ${fieldList(option.missingFields)}`;
        item.append(note);
        return item;
      }

      button.addEventListener("click", () => {
        dismissMenu();
        const panel = panelOf(card);
        const column =
          panel === null ? null : findColumn(panel, option.toStateCode);
        void performMove({
          card,
          code,
          option,
          targetLabel: column === null ? option.label : labelOf(column),
          placement: { kind: "waiting" },
        });
      });
      return item;
    }

    function buildNote(text: string): HTMLElement {
      const note = document.createElement("p");
      note.className = "small move-note";
      note.lang = "es";
      note.textContent = text;
      return note;
    }

    function positionMenu(trigger: HTMLElement): void {
      if (menu === null) return;
      const anchor = trigger.getBoundingClientRect();
      const width = menu.offsetWidth;
      const height = menu.offsetHeight;
      const maxLeft = window.innerWidth - width - VIEWPORT_MARGIN_PX;
      const left = Math.max(
        VIEWPORT_MARGIN_PX,
        Math.min(anchor.right - width, maxLeft),
      );
      const below = anchor.bottom + MENU_GAP_PX;
      const fitsBelow =
        below + height <= window.innerHeight - VIEWPORT_MARGIN_PX;
      const top = fitsBelow
        ? below
        : Math.max(VIEWPORT_MARGIN_PX, anchor.top - height - MENU_GAP_PX);
      menu.style.left = `${left}px`;
      menu.style.top = `${top}px`;
    }

    function menuItems(): HTMLButtonElement[] {
      if (menuList === null) return [];
      return [
        ...menuList.querySelectorAll<HTMLButtonElement>(
          ".move-option:not(:disabled)",
        ),
      ];
    }

    function focusFirstItem(): void {
      const first = menuItems()[0];
      if (first !== undefined) first.focus();
    }

    function closeMenu(): void {
      if (menu !== null) menu.hidden = true;
      if (menuOwner !== null) {
        menuOwner.setAttribute("aria-expanded", "false");
        menuOwner.classList.remove("is-loading");
      }
      menuOwner = null;
    }

    /** Closes the menu and hands focus back to the control that opened it. */
    function dismissMenu(): void {
      const owner = menuOwner;
      closeMenu();
      if (owner !== null) owner.focus();
    }

    function onMenuKeyDown(event: KeyboardEvent): void {
      if (event.key !== "ArrowDown" && event.key !== "ArrowUp") return;
      const items = menuItems();
      if (items.length === 0) return;
      const active = document.activeElement;
      const current = items.findIndex((item) => item === active);
      const delta = event.key === "ArrowDown" ? 1 : -1;
      const next = items[(current + delta + items.length) % items.length];
      if (next === undefined) return;
      event.preventDefault();
      next.focus();
    }

    // --- Stream -------------------------------------------------------------

    /**
     * A project changed state somewhere. Three cases, in order:
     *
     * 1. it is the move this tab is waiting for → confirm it;
     * 2. it is a move this tab did not make → the card travels across the board with the
     *    author's name riding on it (the signature moment);
     * 3. it names a state with no column here → the card leaves, and says so.
     */
    function onStateChanged(envelope: Envelope): void {
      lastEventAt = envelope.occurred_at;
      const code = envelope.entity.id;
      const card = findCard(board, code);
      if (card === null) return;
      if (!isNewer(card, envelope.occurred_at)) return;
      const toStateCode = readString(envelope.payload, "to");
      if (toStateCode === null) return;

      markUpdatedAt(card, envelope.occurred_at);
      invalidateMoves(code);

      const pending = pendings.get(code);
      if (pending !== undefined) {
        if (pending.toStateCode === toStateCode) {
          confirmFromEnvelope(pending, envelope);
          return;
        }
        // Somebody moved it elsewhere while we waited: our pending mark is void.
        if (pending.timer !== null) window.clearTimeout(pending.timer);
        pendings.delete(code);
        setPending(card, false);
      }

      const panel = panelOf(card);
      const column = panel === null ? null : findColumn(panel, toStateCode);
      if (column === null) {
        dropFromBoard(card, code, toStateCode);
        return;
      }
      if (columnOf(card) === column) {
        patchStateChip(card, column);
        syncPanelState(code, column);
        return;
      }

      moveCard(card, column, "travel");
      patchStateChip(card, column);
      syncPanelState(code, column);
      card.dataset["remote"] = "true";
      window.setTimeout(() => {
        delete card.dataset["remote"];
      }, REMOTE_RING_MS);
      if (envelope.actor !== operatorAlias) {
        rideAttribution(card, `${envelope.actor} → ${labelOf(column)}`);
      }
    }

    /**
     * A task moved, was created or was edited. The panel only cares when it belongs to the
     * project on screen, which every task payload names through `project_code`
     * (`docs/EVENTS.md` §4).
     *
     * The list is re-read rather than patched in place: a task can change the *group* it
     * belongs to, and the panel's shape is what a state change alters. Patching is for
     * values, refetching is for shape (`PATTERNS_FRONTEND.md` §6).
     */
    function onTaskEvent(envelope: Envelope): void {
      lastEventAt = envelope.occurred_at;
      const code = selectedCode;
      if (code === null) return;
      if (readString(envelope.payload, "project_code") !== code) return;
      if (taskRefreshTimer !== null) window.clearTimeout(taskRefreshTimer);
      taskRefreshTimer = window.setTimeout(() => {
        taskRefreshTimer = null;
        if (selectedCode !== code) return;
        void refreshTasks(code);
      }, TASK_REFRESH_DEBOUNCE_MS);
    }

    /**
     * A recomputed priority: the figure counts to its new value and its breakdown sentence is
     * rewritten from the envelope, because a number whose tooltip still argues the old case
     * is worse than no tooltip at all (CLAUDE.md rule 7).
     */
    function onPriorityRecalculated(envelope: Envelope): void {
      lastEventAt = envelope.occurred_at;
      const card = findCard(board, envelope.entity.id);
      if (card === null) return;
      const value = envelope.payload["value"];
      if (typeof value !== "number") return;
      const figure = card.querySelector<HTMLElement>(SEL.cardScore);
      if (figure === null) return;

      const previous = Number.parseFloat(figure.textContent ?? "");
      const description = describeScore(value, envelope.payload);
      // A project scored for the first time stops being an absence chip and becomes a figure.
      figure.dataset["scoreState"] = "computed";
      figure.classList.remove("chip", "tone-ambar");
      figure.classList.add("figure");
      const slot = card.querySelector<HTMLElement>(SEL.cardScoreSlot);
      if (slot !== null) slot.title = description;
      const note = card.querySelector<HTMLElement>(SEL.cardScoreNote);
      if (note !== null) note.textContent = description;
      countUp(figure, Number.isNaN(previous) ? value : previous, value);
    }

    /** Rebuilds the Spanish breakdown sentence from the envelope's own signal lines. */
    function describeScore(
      value: number,
      payload: Record<string, unknown>,
    ): string {
      const rounded = Math.round(value);
      const raw = payload["breakdown"];
      const version = readString(payload, "policy_version");
      const head = `Prioridad ${rounded} de 100${version === null ? "" : ` · política ${version}`}`;
      if (!Array.isArray(raw)) {
        return `${head} · desglose completo en Prioridades`;
      }
      const lines: string[] = [];
      for (const entry of raw) {
        if (!isRecord(entry)) continue;
        const code = entry["code"];
        const contribution = entry["contribution"];
        if (typeof code !== "string" || typeof contribution !== "number")
          continue;
        const points = Math.round(contribution);
        lines.push(`${code} ${points >= 0 ? "+" : ""}${points}`);
      }
      return lines.length === 0
        ? `${head} · desglose completo en Prioridades`
        : `${head} · ${lines.join(" · ")}`;
    }

    // --- Connection ---------------------------------------------------------

    function staleSentence(): string {
      if (lastEventAt === null) {
        return "Sin conexión en vivo. El tablero muestra los datos con los que se cargó la página.";
      }
      const time = new Intl.DateTimeFormat("es", {
        hour: "2-digit",
        minute: "2-digit",
      }).format(new Date(lastEventAt));
      return `Sin conexión en vivo. El tablero muestra los datos de las ${time}.`;
    }

    function showStale(mode: "offline" | "reset"): void {
      staleMode = mode;
      if (staleText !== null) {
        staleText.textContent =
          mode === "offline" ? staleSentence() : RESET_SENTENCE;
      }
      if (staleAction !== null) {
        staleAction.textContent =
          mode === "offline" ? "Reconectar" : "Actualizar tablero";
        staleAction.dataset["mode"] = mode;
      }
      if (staleBanner !== null) staleBanner.hidden = false;
    }

    function hideStale(): void {
      staleMode = null;
      if (staleBanner !== null) staleBanner.hidden = true;
    }

    /**
     * Drags are refused while the stream is down: a move whose confirmation can never arrive
     * would leave a card pending with no way back. The menu stays open on purpose — it is the
     * explicit path, and its deadline settles it from the response.
     */
    function applyConnection(stale: boolean): void {
      board.dataset["connection"] = stale ? "stale" : "live";
      for (const card of board.querySelectorAll<HTMLElement>(SEL.card)) {
        if (stale) card.title = STALE_DRAG_HINT;
        else card.removeAttribute("title");
      }
      if (!stale) {
        if (staleMode !== "reset") hideStale();
        return;
      }
      if (drag !== null) concludeDrag(drag, { kind: "released" });
      if (staleMode !== "reset") showStale("offline");
    }

    function onStaleAction(): void {
      if (staleAction === null) return;
      if (staleAction.dataset["mode"] === "reset") {
        window.location.reload();
        return;
      }
      retry();
    }

    // --- Wiring -------------------------------------------------------------

    function onBoardClick(event: MouseEvent): void {
      const target = event.target;
      if (!(target instanceof Element)) return;
      const pill = target.closest<HTMLElement>(SEL.switcherPill);
      if (pill !== null) {
        const code = pill.dataset["engagementCode"] ?? "";
        if (code !== "") selectEngagement(code, true);
        return;
      }
      const more = target.closest<HTMLElement>(SEL.membersMore);
      if (more !== null) {
        toggleMemberOverflow(more);
        return;
      }
      const member = target.closest<HTMLElement>(SEL.member);
      if (member !== null) {
        const alias = member.dataset["alias"] ?? "";
        applyMemberFilter(
          alias === memberFilter || alias === "" ? null : alias,
        );
        return;
      }
      if (target.closest("[data-tp-close]") !== null) {
        clearSelection({ push: true, focus: true });
        return;
      }
      if (target.closest("[data-tp-retry]") !== null) {
        if (selectedCode === null) return;
        showPanelArm("loading");
        void refreshTasks(selectedCode);
        return;
      }
      const trigger = target.closest<HTMLElement>(SEL.moveTrigger);
      if (trigger !== null) {
        if (menuOwner === trigger) dismissMenu();
        else void openMenu(trigger);
      }
    }

    function onDocumentClick(event: MouseEvent): void {
      if (menuOwner === null) return;
      const target = event.target;
      if (!(target instanceof Element)) return;
      if (target.closest(SEL.moveMenu) !== null) return;
      if (target.closest(SEL.moveTrigger) !== null) return;
      closeMenu();
    }

    function onKeyDown(event: KeyboardEvent): void {
      if (event.key !== "Escape") return;
      if (drag !== null) {
        event.preventDefault();
        concludeDrag(drag, { kind: "released" });
        return;
      }
      if (menuOwner !== null) {
        dismissMenu();
        return;
      }
      if (selectedCode === null) return;
      event.preventDefault();
      clearSelection({ push: true, focus: true });
    }

    function onViewportChange(): void {
      if (menuOwner !== null) closeMenu();
    }

    refreshRoving();

    board.addEventListener("pointerdown", onPointerDown);
    board.addEventListener("pointermove", onPointerMove);
    board.addEventListener("pointerup", onPointerUp);
    board.addEventListener("pointercancel", onPointerCancel);
    board.addEventListener("click", onBoardClick);
    board.addEventListener("keydown", onBoardKeyDown);
    document.addEventListener("click", onDocumentClick);
    document.addEventListener("keydown", onKeyDown);
    window.addEventListener("popstate", onPopState);
    window.addEventListener("resize", onViewportChange);
    window.addEventListener("scroll", onViewportChange, true);
    if (menuList !== null) menuList.addEventListener("keydown", onMenuKeyDown);
    if (dialog !== null) dialog.addEventListener("close", onDialogClose);
    if (reasonInput !== null)
      reasonInput.addEventListener("input", onReasonInput);
    if (reasonCancel !== null && dialog !== null) {
      reasonCancel.addEventListener("click", () => dialog.close("cancel"));
    }
    if (staleAction !== null)
      staleAction.addEventListener("click", onStaleAction);

    const offState = subscribe("project.state_changed", onStateChanged);
    const offPriority = subscribe(
      "project.priority.recalculated",
      onPriorityRecalculated,
    );
    const offTaskCreated = subscribe("task.created", onTaskEvent);
    const offTaskUpdated = subscribe("task.updated", onTaskEvent);
    const offTaskState = subscribe("task.state_changed", onTaskEvent);
    const offStatus = onStatus((status) => {
      applyConnection(status === "disconnected");
    });
    const offReset = onReset(() => {
      showStale("reset");
    });

    cleanups.push(() => {
      board.removeEventListener("pointerdown", onPointerDown);
      board.removeEventListener("pointermove", onPointerMove);
      board.removeEventListener("pointerup", onPointerUp);
      board.removeEventListener("pointercancel", onPointerCancel);
      board.removeEventListener("click", onBoardClick);
      board.removeEventListener("keydown", onBoardKeyDown);
      document.removeEventListener("click", onDocumentClick);
      document.removeEventListener("keydown", onKeyDown);
      window.removeEventListener("popstate", onPopState);
      window.removeEventListener("resize", onViewportChange);
      window.removeEventListener("scroll", onViewportChange, true);
      if (menuList !== null)
        menuList.removeEventListener("keydown", onMenuKeyDown);
      if (dialog !== null) dialog.removeEventListener("close", onDialogClose);
      for (const pending of pendings.values()) {
        if (pending.timer !== null) window.clearTimeout(pending.timer);
      }
      pendings.clear();
      if (taskRefreshTimer !== null) window.clearTimeout(taskRefreshTimer);
      claimPanel(null);
      if (drag !== null) concludeDrag(drag, { kind: "released" });
      offState();
      offPriority();
      offTaskCreated();
      offTaskUpdated();
      offTaskState();
      offStatus();
      offReset();
    });
  }

  function clamp(value: number, min: number, max: number): number {
    return Math.min(max, Math.max(min, value));
  }

  function readString(
    payload: Record<string, unknown>,
    key: string,
  ): string | null {
    const value = payload[key];
    return typeof value === "string" && value !== "" ? value : null;
  }

  function isRecord(value: unknown): value is Record<string, unknown> {
    return typeof value === "object" && value !== null;
  }
</script>

<style>
  .board {
    display: flex;
    flex-direction: column;
    flex: 1;
    min-height: 0;
    /* One column's resting width: wide enough for a project name plus its owner,
       narrow enough that four fit a laptop. The skeleton mirrors it so the loaded
       board never jumps out of the shape its skeleton promised. */
    --column-min: 268px;
    /* The task panel's track: wide enough for a task title on two lines, never so
       wide that it starves the wall. */
    --panel-width: clamp(380px, 28vw, 420px);
  }

  .board-bar {
    display: flex;
    align-items: center;
    gap: var(--space-4);
    flex-wrap: wrap;
    padding: 0 var(--space-5) var(--space-3);
  }

  .board-hint {
    margin-left: auto;
  }

  .stale {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    margin: 0 var(--space-5) var(--space-3);
    padding: var(--space-3) var(--space-4);
    background-color: var(--tone-wash);
    border-color: var(--tone-solid);
    color: var(--tone-ink);
  }

  .stale[hidden] {
    display: none;
  }

  .stale p {
    color: var(--tone-ink);
  }

  .stale button {
    margin-left: auto;
  }

  /* --- The stage: the wall, and the panel beside it --- */

  .board-stage {
    display: grid;
    grid-template-columns: minmax(0, 1fr) var(--panel-width);
    flex: 1;
    min-height: 0;
    border-top: var(--border-width) solid var(--hairline);
  }

  .board-slider {
    min-width: 0;
    min-height: 0;
    display: flex;
  }

  .panel {
    flex: 1;
    min-width: 0;
    min-height: 0;
  }

  .panel[hidden] {
    display: none;
  }

  .columns {
    display: grid;
    grid-auto-flow: column;
    grid-auto-columns: minmax(var(--column-min), 1fr);
    gap: var(--space-4);
    align-items: stretch;
    height: 100%;
    padding: var(--space-4) var(--space-5);
    overflow-x: auto;
    overflow-y: hidden;
    /* The wall scrolls sideways and never hands the gesture to the page behind it. */
    overscroll-behavior-x: contain;
    scroll-snap-type: x proximity;
  }

  /* A carried card must land where the hand is, not where a snap point decides. */
  :global(html[data-board-dragging="true"]) .columns {
    scroll-snap-type: none;
  }

  .tpanel-slot {
    /* One row with a zero minimum, so the panel's own overflow can do its job
       instead of the grid item refusing to shrink below its content. */
    display: grid;
    grid-template-rows: minmax(0, 1fr);
    min-height: 0;
    border-left: var(--border-width) solid var(--hairline);
  }

  /* The board goes stale, not blank: it stays readable and refuses the hand. */
  .board[data-connection="stale"] .columns {
    opacity: 0.72;
  }

  .board[data-connection="stale"] :global([data-card]) {
    cursor: not-allowed;
  }

  /* While a card is in the air the whole page is a grabbing hand, and nothing
     selects text under it — a drag that highlights paragraphs is not an object. */
  :global(html[data-board-dragging="true"] body) {
    cursor: grabbing;
    user-select: none;
  }

  /* --- Drop slots: built by the runtime, so global --- */

  .board :global(.drop-slot) {
    border: 2px dashed var(--cobalto);
    border-radius: var(--radius-card);
    background-color: var(--cobalto-papel);
    flex: none;
  }

  /* The hole the card came out of: neutral, not an invitation. */
  .board :global(.drop-slot.is-origin) {
    border-color: var(--tinta-suave);
    border-style: dashed;
    background-color: transparent;
  }

  /* --- Attribution chip riding a remote move --- */

  .board :global(.card-attribution) {
    position: absolute;
    top: calc(var(--space-3) * -1);
    left: var(--space-3);
    box-shadow: var(--shadow-resting);
    transition: opacity var(--motion-panel-duration) var(--motion-panel-ease);
  }

  .board :global(.card-attribution[data-leaving="true"]) {
    opacity: 0;
  }

  /* --- "Mover a…" menu --- */

  .move-menu {
    position: fixed;
    z-index: var(--z-drawer);
    min-width: 232px;
    max-width: 320px;
    padding: var(--space-2);
    box-shadow: var(--shadow-raised);
  }

  .move-menu[hidden] {
    display: none;
  }

  .move-menu-title {
    padding: var(--space-2) var(--space-2) var(--space-1);
  }

  .move-menu-list {
    display: flex;
    flex-direction: column;
  }

  .move-menu :global(.move-item) {
    display: flex;
    flex-direction: column;
    gap: 2px;
    padding-bottom: var(--space-1);
  }

  .move-menu :global(.move-option) {
    display: flex;
    align-items: center;
    min-height: 40px;
    padding: var(--space-2) var(--space-3);
    border-radius: var(--radius-control);
    font-size: var(--text-title-size);
    font-weight: var(--text-title-weight);
    text-align: left;
    color: var(--tinta);
    transition: background-color var(--motion-micro-duration)
      var(--motion-micro-ease);
  }

  .move-menu :global(.move-option:hover:not(:disabled)) {
    background-color: var(--pozo);
  }

  .move-menu :global(.move-option:disabled) {
    color: var(--tinta-suave);
  }

  .move-menu :global(.move-missing) {
    padding-inline: var(--space-3);
    color: var(--ambar-ink);
  }

  .move-menu :global(.move-note) {
    padding: var(--space-2) var(--space-3);
  }

  /* --- Reason dialog --- */

  .reason-dialog {
    width: min(440px, calc(100vw - var(--space-6)));
    padding: var(--space-5);
    border: var(--border-width) solid var(--hairline);
    border-radius: var(--radius-card);
    background-color: var(--carta);
    color: var(--tinta);
    box-shadow: var(--shadow-lifted);
  }

  .reason-dialog::backdrop {
    background-color: var(--scrim);
  }

  .reason-dialog form {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }

  .reason-label {
    margin-bottom: calc(var(--space-2) * -1);
  }

  .reason-actions {
    display: flex;
    justify-content: flex-end;
    gap: var(--space-2);
  }

  /* --- Below the panel's own width: the panel becomes a sheet over the wall --- */

  @media (max-width: 1279px) {
    .board-stage {
      grid-template-columns: minmax(0, 1fr);
    }

    .tpanel-slot {
      position: fixed;
      inset: auto 0 0 0;
      max-height: 72dvh;
      border-left: 0;
      border-top: var(--border-width) solid var(--hairline);
      border-radius: var(--radius-card) var(--radius-card) 0 0;
      box-shadow: var(--shadow-lifted);
      background-color: var(--carta);
      overflow: hidden;
      z-index: var(--z-drawer);
    }

    /* Nothing selected: the sheet is not a strip of empty paper at the bottom of
       the wall — it simply is not there, and the wall keeps the whole screen. */
    .board:not([data-selected]) .tpanel-slot {
      display: none;
    }
  }

  @media (max-width: 767px) {
    .board-bar {
      padding-inline: var(--space-4);
    }

    .stale {
      margin-inline: var(--space-4);
    }

    .board-hint {
      margin-left: 0;
    }

    .columns {
      grid-auto-columns: min(84vw, 300px);
      padding-inline: var(--space-4);
      scroll-snap-type: x mandatory;
    }
  }
</style>
