---
/**
 * Connection badge: the only island that renders the SSE store's status.
 *
 * Server-rendered as connecting; the colocated script subscribes via
 * `onStatus` and patches `data-status` plus the word. The unsubscribe is
 * stored and called on `astro:before-swap` — skipping it leaks the handler
 * across view transitions and keeps patching a detached node (FRONTEND.md §6).
 */
---

<div
  class="badge"
  data-connection-badge
  data-status="connecting"
  role="status"
  aria-live="polite"
>
  <span class="lamp" aria-hidden="true"></span>
  <span class="word small" data-connection-label>Conectando</span>
  <button
    type="button"
    class="btn btn-secondary reconnect"
    data-connection-reconnect
    hidden>Reconectar</button
  >
</div>

<script>
  import { onStatus, retry } from "../lib/stream/store";

  const badge = document.querySelector<HTMLElement>("[data-connection-badge]");
  if (badge !== null) {
    const legend = badge.querySelector<HTMLElement>("[data-connection-label]");
    const reconnect = badge.querySelector<HTMLButtonElement>(
      "[data-connection-reconnect]",
    );

    const off = onStatus((status) => {
      badge.dataset.status = status;
      if (legend !== null) {
        legend.textContent =
          status === "open"
            ? "En vivo"
            : status === "connecting"
              ? "Conectando"
              : "Sin conexión";
      }
      if (reconnect !== null) {
        reconnect.hidden = status !== "disconnected";
      }
    });

    if (reconnect !== null) {
      reconnect.addEventListener("click", () => {
        retry();
      });
    }

    document.addEventListener("astro:before-swap", off, { once: true });
  }
</script>

<style>
  .badge {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    padding: var(--space-1) var(--space-3);
    border: var(--border-width) solid var(--hairline);
    border-radius: var(--radius-full);
    background: var(--carta);
  }

  .lamp {
    display: block;
    width: var(--space-2);
    height: var(--space-2);
    border-radius: var(--radius-full);
    background: var(--tinta-suave);
  }

  .word {
    color: var(--tinta-media);
    white-space: nowrap;
  }

  .badge[data-status="open"] .lamp {
    background: var(--verde);
    animation: latido 2.4s ease-in-out infinite;
  }

  .badge[data-status="open"] .word {
    color: var(--verde-ink);
  }

  .badge[data-status="disconnected"] .lamp {
    background: var(--rojo);
  }

  .badge[data-status="disconnected"] .word {
    color: var(--rojo-ink);
  }

  /* The live lamp breathes; a dead or connecting one holds still. */
  @keyframes latido {
    0%,
    100% {
      box-shadow: 0 0 0 0 var(--verde-wash);
    }
    50% {
      box-shadow: 0 0 0 4px var(--verde-wash);
    }
  }

  .reconnect {
    height: 28px;
    padding-inline: var(--space-3);
    font-size: var(--text-small-size);
  }

  .reconnect[hidden] {
    display: none;
  }

  @media (max-width: 640px) {
    .badge {
      padding-inline: var(--space-2);
    }

    .word {
      display: none;
    }
  }
</style>
