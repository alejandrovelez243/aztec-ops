---
/**
 * `/workflows` — "Flujos de trabajo": where the operation's lifecycles are shaped.
 *
 * **Why this surface exists.** States and the moves between them are data
 * (`CLAUDE.md` rule 1), and data the operation owns has to be reshapeable *by*
 * the operation: a lifecycle only editable by somebody holding a Django admin
 * account is configurable by engineering, not by the people running the week.
 * So authoring lives here, on the product surface, gated on the ops-lead
 * capability (`docs/API.md` §2.19). The admin stays as a second door, never as
 * the only one.
 *
 * **Authoring a graph and obeying it are separate concerns, and stay that way.**
 * The diagram says which arrows exist; whether the project on your screen may
 * take one is computed per record against its own state, the transition's guard
 * and its `requires_fields`, and stays on the detail's `transitions`
 * (`docs/API.md` §2.2). Drawing an edge here grants nothing — acting on one
 * without asking still earns a typed 409, the same failure mode as a stale
 * button.
 *
 * **The header carries a title, a purpose and the primary action, and nothing
 * else.** It used to carry two grey paragraphs that restated each other and
 * both sent the reader to the Django admin to create a flow, which stopped
 * being true the day authoring moved here. How to read the diagram is the
 * legend's job, beside the drawing it explains
 * (`components/workflows/GraphLegend.astro`) — an explanation above the page is
 * documentation apologising for the screen. "Nuevo flujo" is rendered for
 * everybody and revealed in the browser for the ops lead, because the server
 * renders from a mirror cookie carrying a token rather than a capability; the
 * editor island binds its click through `[data-workflow-new]`.
 *
 * A container and nothing else (`PATTERNS_FRONTEND.md` §5): two reads, one view
 * model, then composition — the graphs are the page, and the catalog is what the
 * "nuevo flujo" form binds engagement types from. Every *write* belongs to
 * `components/workflows/editor.ts`, which repaints each section from the graph
 * the API answers with. Configuration does not arrive over the stream, so this
 * surface has four view states and not five — `disconnected` would be a
 * staleness marker on data no envelope can make stale.
 */
import ConfirmDialog from "../components/workflows/ConfirmDialog.astro";
import EmptyState from "../components/ui/EmptyState.astro";
import Icon from "../components/ui/Icon.astro";
import StateDialog from "../components/workflows/StateDialog.astro";
import TransitionDialog from "../components/workflows/TransitionDialog.astro";
import WorkflowDialog from "../components/workflows/WorkflowDialog.astro";
import WorkflowSection from "../components/workflows/WorkflowSection.astro";
import {
  buildWorkflowViews,
  emptyWorkflowView,
} from "../components/workflows/graph";
import Shell from "../layouts/Shell.astro";
import { getCatalog, getWorkflows } from "../lib/api/client";
import { errorCopyByCode } from "../lib/api/error-copy";
import { toViewState } from "../lib/view-state";

/**
 * Both reads at once: neither depends on the other, so sequential would cost a
 * round trip for nothing. A failed catalog is **not** a failed page — the
 * creation form then says it has no engagement types to offer, and a graph is
 * still creatable as the default of its class.
 */
const [result, catalog] = await Promise.all([getWorkflows(), getCatalog()]);

/**
 * `"connecting"` because the stream has no bearing on this answer: there is no
 * `EventSource` on the server, and this document is authoritative the moment it
 * is read whether or not the browser's connection has opened.
 */
const state = toViewState(result, "connecting", {
  isEmpty: (data) => data.workflows.length === 0,
  emptyMessage:
    "Nadie ha configurado todavía un flujo de trabajo, así que ningún proyecto ni ninguna tarea puede cambiar de estado. Crea el primero desde «Nuevo flujo».",
  lastEventAt: null,
});

const workflows =
  state.kind === "ready" || state.kind === "disconnected"
    ? buildWorkflowViews(state.data)
    : [];

/** What a new lifecycle may be bound to; empty is a legitimate first paint. */
const engagementTypes = catalog.ok ? catalog.data.engagement_types : [];

/** Filled even while its arm is hidden, so the card is never blank when it appears. */
const failure = errorCopyByCode(
  state.kind === "error" ? state.code : "unknown_error",
);

/**
 * Always a real sentence, never an absent prop: `exactOptionalPropertyTypes`
 * makes `description={undefined}` a type error, and it is the right rule — the
 * empty state's second line is what turns an apology into an instruction.
 */
const emptyDescription =
  state.kind === "empty"
    ? state.message
    : "Crea el primero desde «Nuevo flujo» y define los estados por los que pasará el trabajo.";

const CRUMBS = [
  { label: "Resumen", href: "/" },
  { label: "Flujos de trabajo" },
];

/** Skeleton rows shown while a retry is in flight. */
const SKELETON_ROWS = [0, 1, 2, 3, 4];
---

<Shell title="Flujos de trabajo" active="workflows" crumbs={CRUMBS}>
  <section class="workflows" data-workflows-region data-view={state.kind}>
    <header class="head">
      <div class="titles">
        <h1 class="h1">Flujos de trabajo</h1>
        <p class="body-text lead">
          Decide por dónde pasa el trabajo: los estados de cada flujo y los
          movimientos permitidos entre ellos.
        </p>
      </div>

      <button
        class="btn btn-primary"
        type="button"
        data-workflow-new
        data-ops-lead
        data-focus-key="workflows:create"
        hidden
      >
        <Icon name="plus" size={16} />
        Nuevo flujo
      </button>
    </header>

    <div class="graphs" data-graphs-arm>
      {workflows.map((workflow) => <WorkflowSection workflow={workflow} />)}
    </div>

    <div class="skeletons" data-skeletons-arm aria-hidden="true">
      <p class="skeleton skeleton-title"></p>
      <div class="skeleton skeleton-graph"></div>
      <div class="card skeleton-table">
        {SKELETON_ROWS.map(() => <p class="skeleton skeleton-row" />)}
      </div>
    </div>

    <div class="card" data-empty-arm>
      <EmptyState
        scene="quiet"
        title="No hay ningún flujo configurado"
        description={emptyDescription}
      >
        {
          /* The way out of the empty state is the act that fills it, right here — the header's
             copy of the button is hidden on this arm so the same offer is not made twice. */
        }
        <span data-ops-lead hidden>
          <button
            class="btn btn-primary"
            type="button"
            data-workflow-new
            data-focus-key="workflows:create-first"
          >
            <Icon name="plus" size={16} />
            Crear el primer flujo
          </button>
        </span>
      </EmptyState>
    </div>

    <div class="card state" data-error-arm>
      <span class="state-icon tone-rojo" aria-hidden="true">
        <Icon name="alert" />
      </span>
      <h2 class="h2" data-field="wf-read-error-title">{failure.title}</h2>
      <p class="body-text" data-field="wf-read-error-detail">
        {failure.detail}
      </p>
      <p>
        <button class="btn btn-secondary" type="button" data-workflows-retry>
          <Icon name="refresh" />
          Reintentar
        </button>
      </p>
    </div>

    {
      /* The four modals of the surface, rendered once and outside every arm: a dialog that
         lived inside the ready arm would be unreachable from the empty one, which is exactly
         where the first lifecycle is created. */
    }
    <WorkflowDialog engagementTypes={engagementTypes} />
    <StateDialog />
    <TransitionDialog />
    <ConfirmDialog />

    {
      /* The blank section the editor clones when a lifecycle is created, rendered by the same
         component that renders the real ones — so a section that appears without a reload is
         the same markup, with the same styles and the same hooks, as the ones the server drew. */
    }
    <template data-template="workflow-section">
      <WorkflowSection workflow={emptyWorkflowView()} />
    </template>
  </section>

  <script>
    import { onPage } from "../components/projects/island";
    import { mountWorkflowEditor } from "../components/workflows/editor";

    onPage("[data-workflows-region]", mountWorkflowEditor);
  </script>
</Shell>

<style>
  /*
   * Every grid on this page states `minmax(0, 1fr)` rather than letting the
   * single implicit track default to `auto`, and every child of one carries
   * `min-width: 0`.
   *
   * The diagram is ~1500px of fixed geometry inside its own scroller, and a
   * scroller only scrolls if something upstream is allowed to be narrower than
   * it: an `auto` track is floored by its item's min-content, and a grid item's
   * `min-width: auto` is floored by its own, so without both the whole column
   * grew to the drawing's width and the page — not the figure — scrolled
   * sideways at every viewport.
   */
  .workflows {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: var(--space-6);
  }

  .workflows > * {
    min-width: 0;
  }

  .head {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-end;
    justify-content: space-between;
    gap: var(--space-4);
  }

  .titles {
    display: grid;
    gap: var(--space-2);
  }

  .lead {
    color: var(--tinta-media);
  }

  /* `.btn` sets `display: inline-flex`, and an author rule beats the user
     agent's `[hidden]` whatever its specificity: without this the action would
     be visible to every member until the island ran, and stay visible to a
     member who is not an ops lead. */
  .head [hidden],
  [data-empty-arm] [hidden] {
    display: none;
  }

  .graphs {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: var(--space-8);
  }

  .state {
    justify-items: start;
    gap: var(--space-3);
    padding: var(--space-6);
  }

  .state-icon {
    display: grid;
    place-items: center;
    width: var(--space-7);
    height: var(--space-7);
    border-radius: var(--radius-full);
    background-color: var(--tone-wash);
    color: var(--tone-ink);
  }

  /* --- Skeletons: the exact geometry of the loaded state --- */

  .skeletons {
    display: grid;
    gap: var(--space-4);
  }

  .skeleton-title {
    width: 22ch;
    height: var(--space-5);
  }

  .skeleton-graph {
    height: 320px;
    border-radius: var(--radius-card);
  }

  .skeleton-table {
    display: grid;
    gap: var(--space-3);
    padding: var(--space-4);
  }

  .skeleton-row {
    height: var(--space-5);
  }

  /* --- View-state arms: one at a time, selected by `data-view` on the region --- */

  [data-graphs-arm],
  [data-skeletons-arm],
  [data-empty-arm],
  [data-error-arm] {
    display: none;
  }

  /* `disconnected` is unreachable here and shares the ready arm rather than
     inventing a staleness marker: nothing on this surface is patched by an
     envelope, so there is no such thing as stale configuration on screen. */
  [data-view="ready"] [data-graphs-arm],
  [data-view="disconnected"] [data-graphs-arm],
  [data-view="loading"] [data-skeletons-arm] {
    display: grid;
  }

  [data-view="empty"] [data-empty-arm],
  [data-view="error"] [data-error-arm] {
    display: grid;
  }

  /* One offer per screen: the empty arm makes it inside the card, and a page that could not
     even be read has no business inviting a write. */
  [data-view="empty"] .head [data-workflow-new],
  [data-view="error"] .head [data-workflow-new],
  [data-view="loading"] .head [data-workflow-new] {
    display: none;
  }

  @media (max-width: 640px) {
    .state {
      padding: var(--space-5);
    }
  }
</style>
