---
/**
 * `/projects/{code}` — one project, and everything you can do to it.
 *
 * The container: this frontmatter performs the reads of the first paint (the
 * project, its tasks, its timeline, and the two vocabularies the create-task
 * dialog draws its pickers from) and hands them to presentational components;
 * the islands underneath own the writes and the live patches.
 *
 * Layering, in one sentence each. `transitions` from the project read is the
 * only source of transition buttons, so a workflow state added in the admin
 * needs no frontend change. `workflow` from the same read says which graph
 * those buttons came from and whether an ops lead chose it for this project,
 * which is the only way the screen can explain why two projects of one
 * engagement type offer different moves. The score is never rendered without
 * the breakdown that defends it. A manual override is shown beside the computed
 * score, never instead of it. And nothing repaints a state change until the
 * stream confirms it — the server owns legality, and a rollback the operator has
 * already read past is worse than a wait.
 *
 * There is no SSR adapter, so the route is pre-rendered once per project in the
 * queue; a code the build did not know still renders the error arm rather than
 * a blank page.
 */
import Shell from "../../layouts/Shell.astro";
import ActivityFeed from "../../components/projects/ActivityFeed.astro";
import BlockersPanel from "../../components/projects/BlockersPanel.astro";
import DetailHeader from "../../components/projects/DetailHeader.astro";
import RichText from "../../components/ui/RichText.astro";
import DetailTabs from "../../components/projects/DetailTabs.astro";
import NotesPanel from "../../components/projects/NotesPanel.astro";
import ReasonDialog from "../../components/projects/ReasonDialog.astro";
import RegionMessage from "../../components/projects/RegionMessage.astro";
import RiskFlagList from "../../components/projects/RiskFlagList.astro";
import ScorePlate from "../../components/projects/ScorePlate.astro";
import StaleBanner from "../../components/projects/StaleBanner.astro";
import TasksTable from "../../components/projects/TasksTable.astro";
import {
  regionFailureCopy,
  type FailureCopy,
} from "../../components/projects/messages";
import {
  buildConversions,
  engagementWeights,
} from "../../components/projects/convert-engagement";
import { emptyAggregateFields } from "../../components/projects/presentation";
import {
  getCatalog,
  getProject,
  getProjectActivity,
  getProjectTasks,
  getQueue,
  getTeamLoad,
  getWorkflows,
  type Result,
} from "../../lib/api/client";
import type { ApiError } from "../../lib/api/errors";
import type {
  ActivityPage,
  Catalog,
  ProjectDetail,
  TaskPage,
  TaxonomyRef,
  TeamLoad,
  TeamLoadEntry,
  WorkflowCatalog,
} from "../../lib/api/domain";
import { assertNever, toViewState, type ViewState } from "../../lib/view-state";

/** First page of the timeline; "Cargar más" keeps the same size. */
const ACTIVITY_PAGE_SIZE = 20;

export async function getStaticPaths() {
  const result = await getQueue({ page_size: 200 });
  if (!result.ok) return [];
  return result.data.items.map((item) => ({ params: { code: item.code } }));
}

const code = Astro.params.code;

/** A route reached without a code cannot be read; it is a `not_found`, not a crash. */
const MISSING_CODE: ApiError = {
  kind: "not_found",
  code: "not_found",
  message: "The URL carries no project code.",
  details: {},
};

const [
  projectResult,
  tasksResult,
  activityResult,
  catalogResult,
  teamResult,
  workflowsResult,
]: [
  Result<ProjectDetail>,
  Result<TaskPage>,
  Result<ActivityPage>,
  Result<Catalog>,
  Result<TeamLoad>,
  Result<WorkflowCatalog>,
] =
  code === undefined
    ? [
        { ok: false, error: MISSING_CODE },
        { ok: false, error: MISSING_CODE },
        { ok: false, error: MISSING_CODE },
        { ok: false, error: MISSING_CODE },
        { ok: false, error: MISSING_CODE },
        { ok: false, error: MISSING_CODE },
      ]
    : await Promise.all([
        getProject(code),
        getProjectTasks(code),
        getProjectActivity(code, { page_size: ACTIVITY_PAGE_SIZE }),
        getCatalog(),
        getTeamLoad(),
        getWorkflows(),
      ]);

/**
 * What the create-task pickers offer, rendered by the server so the dialog has
 * no loading arm.
 *
 * Neither read can take the screen down: a project whose catalog call failed is
 * still a project you must be able to read and move. So a failure degrades to an
 * empty list, and the dialog answers for itself — with no priority to send there
 * is nothing to create, and its submit renders dead with the reason named rather
 * than posting a task the server would refuse.
 */
const priorities: readonly TaxonomyRef[] = catalogResult.ok
  ? catalogResult.data.priorities
  : [];
const members: readonly TeamLoadEntry[] = teamResult.ok
  ? teamResult.data.items
  : [];

/**
 * What a region renders, one arm at a time.
 *
 * `disconnected` collapses into `data`: on the server the read is fresh by
 * construction, and staleness is `StaleBanner`'s job in the browser.
 */
type RegionPlan<T> =
  | { mode: "data"; data: T }
  | { mode: "empty" }
  | { mode: "error"; copy: FailureCopy }
  | { mode: "loading" };

function planFor<T>(
  state: ViewState<T>,
  failure: ApiError | null,
  subject: string,
): RegionPlan<T> {
  switch (state.kind) {
    case "ready":
    case "disconnected":
      return { mode: "data", data: state.data };
    case "empty":
      return { mode: "empty" };
    case "error":
      return {
        mode: "error",
        copy:
          failure === null
            ? {
                title: `No pudimos cargar ${subject}`,
                detail: "Vuelve a intentarlo.",
              }
            : regionFailureCopy(failure, subject),
      };
    case "loading":
      return { mode: "loading" };
    default:
      return assertNever(state);
  }
}

// SSR has no stream, so the status is "connecting": a successful read is
// `ready` and a failed one is `error`; `disconnected` is a client-side arm.
const tasksPlan = planFor(
  toViewState(tasksResult, "connecting", {
    isEmpty: (page) => page.items.length === 0,
    emptyMessage: "Sin tareas registradas.",
    lastEventAt: null,
  }),
  tasksResult.ok ? null : tasksResult.error,
  "las tareas",
);

const activityPlan = planFor(
  toViewState(activityResult, "connecting", {
    isEmpty: (page) => page.items.length === 0,
    emptyMessage: "Sin movimientos registrados.",
    lastEventAt: null,
  }),
  activityResult.ok ? null : activityResult.error,
  "la actividad",
);

const project = projectResult.ok ? projectResult.data : null;
const projectFailure = projectResult.ok ? null : projectResult.error;

/**
 * What converting this project into each other engagement type would do.
 *
 * Composed on the server from three reads the page already performs — the project, the catalog's
 * engagement types and the workflow shapes — so the confirmation dialog opens with its whole
 * explanation written and has no loading arm. A failed catalog or workflow read degrades: the
 * chip renders visibly dead, or the dialog says plainly that it cannot tell whether the lifecycle
 * changes. Neither is allowed to take the project screen down.
 *
 * The weight lookup is bound to the catalog's own entries, so the dialog can say out loud that a
 * conversion moves the project in the queue. When the catalog read fails there are no weights for
 * anybody and the sentence goes unsaid rather than guessed.
 */
const conversions =
  project === null || !catalogResult.ok
    ? []
    : buildConversions(
        {
          projectName: project.name,
          current: project.engagement_type,
          engagementTypes: catalogResult.data.engagement_types,
          workflow: project.workflow,
          stateCode: project.state.code,
          stateLabel: project.state.label,
          catalog: workflowsResult.ok ? workflowsResult.data : null,
        },
        engagementWeights(catalogResult.data.engagement_types),
      );

const openBlockers =
  project?.blockers.filter(
    (blocker) => (blocker.resolved_at ?? null) === null,
  ) ?? [];

const crumbs = [
  { label: "Inicio", href: "/" },
  { label: "Proyectos", href: "/projects" },
  { label: project?.code ?? code ?? "Proyecto" },
];

const failureCopyForProject: FailureCopy =
  projectFailure === null
    ? { title: "No pudimos cargar el proyecto", detail: "Vuelve a intentarlo." }
    : regionFailureCopy(projectFailure, "el proyecto");
---

{
  project === null ? (
    <Shell title="Proyecto no encontrado" active="projects" crumbs={crumbs}>
      <RegionMessage
        kind="error"
        title={failureCopyForProject.title}
        detail={failureCopyForProject.detail}
        actionLabel="Reintentar"
      >
        <a class="btn btn-ghost" href="/projects">
          Volver a Proyectos
        </a>
      </RegionMessage>
    </Shell>
  ) : (
    <Shell title={project.name} active="projects" crumbs={crumbs}>
      <div class="detail" data-project-detail data-project-code={project.code}>
        <StaleBanner />

        <DetailHeader
          code={project.code}
          name={project.name}
          summary={project.summary ?? null}
          clientLabel={project.client.label}
          ownerAlias={project.owner?.alias ?? null}
          ownerLabel={project.owner?.label ?? null}
          engagementLabel={project.engagement_type.label}
          engagementColor={project.engagement_type.color ?? null}
          engagementCode={project.engagement_type.code}
          stateLabel={project.state.label}
          stateCategory={project.state.category}
          stateCode={project.state.code}
          stateColor={project.state.color ?? null}
          workflow={project.workflow}
          healthCode={project.health.code}
          healthLabel={project.health.label}
          targetDate={project.target_date ?? null}
          nextStep={project.next_step ?? null}
          isArchived={project.is_archived}
          updatedAt={project.updated_at}
          transitions={project.transitions}
          emptyFields={emptyAggregateFields(project)}
          conversions={conversions}
        />

        <div class="card">
          <RichText
            scope="project"
            code={project.code}
            value={project.description}
            label="Descripción"
          />
        </div>

        <div class="split">
          <ScorePlate
            projectCode={project.code}
            score={project.score ?? null}
            override={project.override ?? null}
            updatedAt={project.updated_at}
          />
          <div class="card risks">
            <RiskFlagList flags={project.risk_flags} />
          </div>
        </div>

        {/* Notes sit beside the risks rather than behind a tab: they are the
            written half of the same question the flags ask, and a tab hides
            them from the operator who is reading why a project is at risk —
            which is exactly when somebody's note explains it. */}
        <div class="card notes-card">
          <NotesPanel projectCode={project.code} notes={project.notes} />
        </div>

        <DetailTabs
          taskCount={tasksPlan.mode === "data" ? tasksPlan.data.count : 0}
          blockerCount={openBlockers.length}
          activityCount={
            activityPlan.mode === "data" ? activityPlan.data.count : 0
          }
        >
          <Fragment slot="tasks">
            {tasksPlan.mode === "data" && (
              <TasksTable
                projectCode={project.code}
                tasks={tasksPlan.data.items}
                updatedAt={project.updated_at}
                priorities={priorities}
                members={members}
              />
            )}
            {/* The table owns its own empty sentence and stays mounted, so a
                task created while the page is open lands in it. */}
            {tasksPlan.mode === "empty" && (
              <TasksTable
                projectCode={project.code}
                tasks={[]}
                updatedAt={project.updated_at}
                priorities={priorities}
                members={members}
              />
            )}
            {tasksPlan.mode === "error" && (
              <RegionMessage
                kind="error"
                title={tasksPlan.copy.title}
                detail={tasksPlan.copy.detail}
                actionLabel="Reintentar"
              />
            )}
            {tasksPlan.mode === "loading" && (
              <p class="skeleton loading-block" />
            )}
          </Fragment>

          <Fragment slot="blockers">
            <BlockersPanel
              projectCode={project.code}
              blockers={project.blockers}
            />
          </Fragment>

          <Fragment slot="activity">
            {activityPlan.mode === "data" && (
              <ActivityFeed
                projectCode={project.code}
                entries={activityPlan.data.items}
                count={activityPlan.data.count}
                pageSize={ACTIVITY_PAGE_SIZE}
              />
            )}
            {activityPlan.mode === "empty" && (
              <ActivityFeed
                projectCode={project.code}
                entries={[]}
                count={0}
                pageSize={ACTIVITY_PAGE_SIZE}
              />
            )}
            {activityPlan.mode === "error" && (
              <RegionMessage
                kind="error"
                title={activityPlan.copy.title}
                detail={activityPlan.copy.detail}
                actionLabel="Reintentar"
              />
            )}
            {activityPlan.mode === "loading" && (
              <p class="skeleton loading-block" />
            )}
          </Fragment>
        </DetailTabs>

        {/* One motive dialog for the whole screen: `requires_reason` is a
            property of a transition edge, so the project bar and a task row ask
            the same question and must not ask it in two different forms. */}
        <ReasonDialog />
      </div>
    </Shell>
  )
}

<style>
  .notes-card {
    /* `.card` carries no padding; the component inside owns its inset. */
    padding: var(--space-5);
  }

  .detail {
    display: flex;
    flex-direction: column;
    gap: var(--space-5);
  }

  .split {
    display: grid;
    grid-template-columns: minmax(0, 1.35fr) minmax(0, 1fr);
    gap: var(--space-4);
    align-items: start;
  }

  .risks {
    padding: var(--space-5);
  }

  .loading-block {
    height: var(--space-8);
  }

  @media (max-width: 1023px) {
    .split {
      grid-template-columns: 1fr;
    }
  }
</style>
