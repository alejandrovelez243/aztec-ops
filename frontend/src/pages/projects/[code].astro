---
import Shell from "../../layouts/Shell.astro";
import ProjectHeader from "../../islands/ProjectHeader.astro";
import TransitionBar from "../../islands/TransitionBar.astro";
import TimelineIsland from "../../islands/TimelineIsland.astro";
import TasksTable from "../../components/project/TasksTable.astro";
import BlockerPanel from "../../components/project/BlockerPanel.astro";
import NotesPanel from "../../components/project/NotesPanel.astro";
import RegionFallback from "../../components/project/RegionFallback.astro";
import {
  getProject,
  getProjectActivity,
  getProjectTasks,
  getQueue,
  type Result,
} from "../../lib/api/client";
import type { ApiError, ApiErrorCode } from "../../lib/api/errors";
import type {
  ActivityPage,
  ProjectDetail,
  TaskPage,
} from "../../lib/api/domain";
import { assertNever, toViewState, type ViewState } from "../../lib/view-state";

/**
 * Project detail — `/projects/{code}`. The container: the frontmatter fetches the
 * three reads for first paint (project, tasks, activity) and maps each onto the
 * view-state union; the islands patch from the stream afterwards.
 *
 * A `not_found` (or any failed) project read renders the error arm as real markup
 * with a retry — never a crash, never a blank page.
 *
 * The project has no SSR adapter, so the dynamic route prerenders one path per
 * project in the queue. An unknown code still renders the error arm — the
 * frontmatter read runs for every request in dev, and a code the build did not
 * know simply reaches the `not_found` Result.
 */
export async function getStaticPaths() {
  const res = await getQueue({ page_size: 200 });
  if (!res.ok) return [];
  return res.data.items.map((item) => ({ params: { code: item.code } }));
}

const code = Astro.params.code;

const missingCodeError: ApiError = {
  kind: "not_found",
  code: "not_found",
  message: "The URL carries no project code.",
  details: {},
};

const [projectRes, tasksRes, activityRes]: [
  Result<ProjectDetail>,
  Result<TaskPage>,
  Result<ActivityPage>,
] =
  code === undefined
    ? [
        { ok: false, error: missingCodeError },
        { ok: false, error: missingCodeError },
        { ok: false, error: missingCodeError },
      ]
    : await Promise.all([
        getProject(code),
        getProjectTasks(code),
        getProjectActivity(code),
      ]);

/**
 * UI copy for the error arm, keyed by the typed error code — the envelope's
 * `message` is English prose for logs and is never rendered as UI text
 * (docs/API.md §1.5).
 */
function errorCopy(code: ApiErrorCode): string {
  switch (code) {
    case "not_found":
      return "No project with this code.";
    case "transition_not_allowed":
      return "That move is not legal from the current state.";
    case "validation_error":
      return "The request was rejected as invalid.";
    case "conflicting_state":
      return "The record changed underneath this view.";
    case "network_error":
      return "The API is unreachable.";
    case "unknown_error":
      return "Something failed unexpectedly.";
    default:
      return assertNever(code);
  }
}

/**
 * Collapses a region's view state into what the template renders. SSR has no
 * stream status, so `disconnected` cannot occur here — it is still an arm of the
 * union and still handled, so adding a state fails the build, not the page.
 */
type RegionPlan<T> =
  | { mode: "data"; data: T }
  | { mode: "empty"; message: string }
  | { mode: "error"; code: ApiErrorCode }
  | { mode: "loading" };

function plan<T>(view: ViewState<T>): RegionPlan<T> {
  switch (view.kind) {
    case "ready":
    case "disconnected":
      return { mode: "data", data: view.data };
    case "empty":
      return { mode: "empty", message: view.message };
    case "error":
      return { mode: "error", code: view.code };
    case "loading":
      return { mode: "loading" };
    default:
      return assertNever(view);
  }
}

/**
 * The aggregate attributes `requires_fields` can name, with their current
 * emptiness. An unknown field name counts as empty — the button renders dead and
 * names it, which is the honest answer to a contract that grew.
 */
function collectEmptyFields(project: ProjectDetail): string[] {
  const values: Record<string, unknown> = {
    name: project.name,
    summary: project.summary ?? null,
    next_step: project.next_step ?? null,
    target_date: project.target_date ?? null,
    start_date: project.start_date ?? null,
    business_value: project.business_value ?? null,
    owner: project.owner ?? null,
    stage: project.stage ?? null,
    project_type: project.project_type ?? null,
  };
  const empty = new Set<string>();
  for (const transition of project.transitions) {
    for (const field of transition.requires_fields) {
      const value = values[field];
      if (value === undefined || value === null || value === "") {
        empty.add(field);
      }
    }
  }
  return [...empty];
}

const TASKS_EMPTY = "No tasks recorded on this project.";
const ACTIVITY_EMPTY = "No activity recorded yet.";

// SSR runs before the stream exists, so the status is "connecting": a successful
// read is `ready`, a failed one is `error` — `disconnected` is a client-side arm.
const tasksView = toViewState(tasksRes, "connecting", {
  isEmpty: (page) => page.items.length === 0,
  emptyMessage: TASKS_EMPTY,
  lastEventAt: null,
});
const activityView = toViewState(activityRes, "connecting", {
  isEmpty: (page) => page.items.length === 0,
  emptyMessage: ACTIVITY_EMPTY,
  lastEventAt: null,
});

const tasksPlan = plan(tasksView);
const activityPlan = plan(activityView);

const project = projectRes.ok ? projectRes.data : null;

const retryHref = Astro.url.pathname;
---

{
  project === null && !projectRes.ok ? (
    <Shell title="Project not found">
      <main class="detail">
        <RegionFallback
          kind="error"
          message={errorCopy(projectRes.error.code)}
          retryHref={retryHref}
        />
        <p>
          <a class="label back-link" href="/">
            BACK TO COMMAND CENTER
          </a>
        </p>
      </main>
    </Shell>
  ) : project !== null ? (
    <Shell title={project.name}>
      <div class="detail">
        <ProjectHeader
          code={project.code}
          name={project.name}
          summary={project.summary ?? null}
          clientLabel={project.client.label}
          ownerLabel={project.owner?.label ?? null}
          stageLabel={project.stage?.label ?? null}
          engagementLabel={project.engagement_type.label}
          state={project.state}
          health={project.health}
          targetDate={project.target_date ?? null}
          nextStep={project.next_step ?? null}
          isArchived={project.is_archived}
          score={project.score ?? null}
          override={project.override ?? null}
          riskFlags={project.risk_flags}
          updatedAt={project.updated_at}
        />

        <span class="rule" />

        <TransitionBar
          transitions={project.transitions}
          projectCode={project.code}
          emptyFields={collectEmptyFields(project)}
          updatedAt={project.updated_at}
        />

        <span class="rule" />

        <section class="region" aria-label="Tasks">
          <h2 class="headline">WORK</h2>
          {tasksPlan.mode === "data" ? (
            <TasksTable tasks={tasksPlan.data.items} />
          ) : tasksPlan.mode === "empty" ? (
            <RegionFallback kind="empty" message={tasksPlan.message} />
          ) : tasksPlan.mode === "error" ? (
            <RegionFallback
              kind="error"
              message={errorCopy(tasksPlan.code)}
              retryHref={retryHref}
            />
          ) : (
            <RegionFallback kind="loading" message="" />
          )}
        </section>

        <span class="rule" />

        <section class="region" aria-label="Blockers">
          <h2 class="headline">BLOCKERS</h2>
          <BlockerPanel
            blockers={project.blockers}
            projectCode={project.code}
            updatedAt={project.updated_at}
          />
        </section>

        <span class="rule" />

        <section class="region" aria-label="Notes">
          <h2 class="headline">NOTES</h2>
          <NotesPanel projectCode={project.code} />
        </section>

        <span class="rule" />

        <section class="region" aria-label="Chronology">
          <h2 class="headline">CHRONOLOGY</h2>
          {activityPlan.mode === "error" ? (
            <RegionFallback
              kind="error"
              message={errorCopy(activityPlan.code)}
              retryHref={retryHref}
            />
          ) : activityPlan.mode === "loading" ? (
            <RegionFallback kind="loading" message="" />
          ) : (
            <TimelineIsland
              entries={
                activityPlan.mode === "data" ? activityPlan.data.items : []
              }
              projectCode={project.code}
              emptyMessage={ACTIVITY_EMPTY}
            />
          )}
        </section>
      </div>
    </Shell>
  ) : null
}

<style>
  .detail {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
    padding: var(--space-4);
  }

  .region {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
  }

  .region .headline {
    color: var(--color-legend);
  }

  .back-link {
    color: var(--color-legend-dim);
    text-decoration: none;
  }

  .back-link:hover {
    color: var(--color-legend);
  }
</style>
