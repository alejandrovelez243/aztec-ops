---
/**
 * `/projects` — the whole portfolio, as cards or as a table.
 *
 * The container (`docs/standards/PATTERNS_FRONTEND.md` §5): this frontmatter
 * performs the reads for the first paint and composes presentational
 * components; the island underneath filters and patches, and never fetches the
 * list again.
 *
 * Four reads, in parallel, because they are one screen and four round trips in
 * series is a screen that paints in four parts:
 *
 * - `GET /api/v1/queue` is the snapshot read model that already carries state,
 *   owner, deadline, score and risk flags for every project, so the surface
 *   costs one index scan instead of a join per card. It is ordered by name
 *   because this page is where an operator *looks something up*; the ranked
 *   order is what `/priorities` is for.
 * - `GET /api/v1/clients`, `GET /api/v1/catalog` and `GET /api/v1/team/load`
 *   are the pickers of the create-project sheet. Read here rather than by the
 *   island, because "Nuevo proyecto" opens a modal in place: a fetch on open
 *   would give that sheet a loading arm for lists that do not change while the
 *   page is open.
 *
 * **Only the queue can fail the page**, exactly as `board.astro` states for
 * itself. A failed client directory or catalog costs the creation button, which
 * renders visibly dead with the reason; a failed roster costs only the owner
 * picker inside the sheet, and creation goes ahead without one. Neither is
 * worth blanking a portfolio somebody is reading.
 *
 * All four view states are rendered as real markup. `disconnected` is a
 * client-side arm — the server render is always fresh — and is carried by
 * `StaleBanner`, which keeps the rows on screen and timestamps them rather than
 * blanking a board somebody is reading.
 */
import Shell from "../../layouts/Shell.astro";
import CreateProjectDialog from "../../components/projects/CreateProjectDialog.astro";
import ProjectCard from "../../components/projects/ProjectCard.astro";
import ProjectsSkeleton from "../../components/projects/ProjectsSkeleton.astro";
import ProjectsTable from "../../components/projects/ProjectsTable.astro";
import ProjectsToolbar from "../../components/projects/ProjectsToolbar.astro";
import RegionMessage from "../../components/projects/RegionMessage.astro";
import StaleBanner from "../../components/projects/StaleBanner.astro";
import Icon from "../../components/ui/Icon.astro";
import {
  collectFacets,
  toPresentation,
  type Facets,
  type ProjectPresentation,
} from "../../components/projects/presentation";
import {
  regionFailureCopy,
  type FailureCopy,
} from "../../components/projects/messages";
import {
  CREATE_PROJECT_CLIENTS_FAILED,
  CREATE_PROJECT_ENGAGEMENT_FAILED,
  CREATE_PROJECT_NO_CLIENTS,
} from "../../components/projects/create-project-copy";
import {
  getCatalog,
  getClients,
  getQueue,
  getTeamLoad,
} from "../../lib/api/client";
import type { QueuePage } from "../../lib/api/domain";
import { assertNever, toViewState, type ViewState } from "../../lib/view-state";

/** The pagination cap (`docs/API.md` §1.3): the portfolio fits in one page. */
const PAGE_SIZE = 200;

const [result, clientsResult, catalogResult, teamResult] = await Promise.all([
  getQueue({ page_size: PAGE_SIZE, order_by: "name" }),
  getClients(),
  getCatalog(),
  getTeamLoad(),
]);

const clients = clientsResult.ok ? clientsResult.data.items : [];
const catalog = catalogResult.ok ? catalogResult.data : null;
const members = teamResult.ok ? teamResult.data.items : [];

/**
 * Why "Nuevo proyecto" cannot be offered, or `null` when it can.
 *
 * Three refusals, each with its own sentence, because the operator's next move
 * differs: nobody to register against is a data gap somebody has to fill, while
 * a failed read is a reload. The button renders **dead and visible** in all
 * three (`FRONTEND.md` §10) — a control that disappears teaches that the
 * capability does not exist.
 */
const createBlockedReason: string | null = !clientsResult.ok
  ? CREATE_PROJECT_CLIENTS_FAILED
  : clients.length === 0
    ? CREATE_PROJECT_NO_CLIENTS
    : catalog === null || catalog.engagement_types.length === 0
      ? CREATE_PROJECT_ENGAGEMENT_FAILED
      : null;

const EMPTY_MESSAGE = "No hay proyectos en la cartera.";

const view: ViewState<QueuePage> = toViewState(result, "connecting", {
  isEmpty: (page) => page.items.length === 0,
  emptyMessage: EMPTY_MESSAGE,
  lastEventAt: null,
});

/**
 * What the template renders, one arm at a time.
 *
 * `disconnected` collapses into `ready` here and nowhere else: on the server
 * there is no stream yet, so the data is fresh by construction; the staleness
 * marker is a client-side concern owned by `StaleBanner`.
 */
type Plan =
  | { mode: "ready"; projects: readonly ProjectPresentation[]; facets: Facets }
  | { mode: "empty" }
  | { mode: "error"; copy: FailureCopy }
  | { mode: "loading" };

const failure = result.ok ? null : result.error;

const GENERIC_FAILURE: FailureCopy = {
  title: "No pudimos cargar los proyectos",
  detail: "Vuelve a intentarlo en unos segundos.",
};

function toPlan(state: ViewState<QueuePage>): Plan {
  switch (state.kind) {
    case "ready":
    case "disconnected": {
      const projects = state.data.items.map(toPresentation);
      return { mode: "ready", projects, facets: collectFacets(projects) };
    }
    case "empty":
      return { mode: "empty" };
    case "error":
      return {
        mode: "error",
        copy:
          failure === null
            ? GENERIC_FAILURE
            : regionFailureCopy(failure, "los proyectos"),
      };
    case "loading":
      return { mode: "loading" };
    default:
      return assertNever(state);
  }
}

const plan = toPlan(view);
const crumbs = [{ label: "Inicio", href: "/" }, { label: "Proyectos" }];

/**
 * One id per trigger, because both can be on screen at once.
 *
 * The reason is attached through `aria-describedby` as well as `title`, so the
 * refusal is available to a screen reader and not only to a pointer that
 * happens to rest on a disabled button.
 */
const headBlockedId = "create-project-blocked-head";
const emptyBlockedId = "create-project-blocked-empty";
---

<Shell title="Proyectos" active="projects" crumbs={crumbs}>
  <header class="page-head">
    <div>
      <h1 class="h1">Proyectos</h1>
      <p class="body-text lead">
        Toda la cartera con su estado, su responsable y la prioridad que calculó
        el motor.
      </p>
    </div>
    {
      /* The creating control belongs to the page header and not to
        `ProjectsToolbar`: the toolbar narrows what is already on screen, while
        this acts on the portfolio itself. It sits before the link to
        `/priorities` because it is the primary act here and that one is a way
        out to another surface. */
    }
    <div class="head-actions">
      <button
        class="btn btn-primary"
        type="button"
        data-action="open-create-project"
        disabled={createBlockedReason !== null}
        title={createBlockedReason}
        aria-describedby={createBlockedReason === null
          ? undefined
          : headBlockedId}
      >
        <Icon name="plus" size={18} />
        Nuevo proyecto
      </button>
      {
        createBlockedReason !== null && (
          <span class="visually-hidden" id={headBlockedId}>
            {createBlockedReason}
          </span>
        )
      }
      <a class="btn btn-secondary" href="/priorities">
        <Icon name="flag" size={18} />
        Ver la cola priorizada
      </a>
    </div>
  </header>

  <StaleBanner />

  {
    plan.mode === "ready" && (
      <section
        class="projects"
        data-projects
        data-view="grid"
        aria-label="Cartera de proyectos"
      >
        <ProjectsToolbar facets={plan.facets} total={plan.projects.length} />

        <div class="projects-grid" data-projects-grid>
          {plan.projects.map((project) => (
            <ProjectCard project={project} />
          ))}
        </div>

        <ProjectsTable projects={plan.projects} />

        <div data-filter-empty hidden>
          <RegionMessage
            kind="empty"
            title="Ningún proyecto coincide con el filtro"
            detail="Prueba con otro texto, o quita alguno de los filtros activos."
            actionLabel={null}
          >
            <button
              class="btn btn-secondary"
              type="button"
              data-action="clear-filters"
            >
              Limpiar filtros
            </button>
          </RegionMessage>
        </div>
      </section>
    )
  }

  {
    plan.mode === "empty" && (
      <RegionMessage
        kind="empty"
        title={EMPTY_MESSAGE}
        detail="En cuanto se registre el primero aparecerá aquí, ya priorizado."
        actionLabel={null}
      >
        <button
          class="btn btn-primary"
          type="button"
          data-action="open-create-project"
          disabled={createBlockedReason !== null}
          title={createBlockedReason}
          aria-describedby={
            createBlockedReason === null ? undefined : emptyBlockedId
          }
        >
          <Icon name="plus" size={18} />
          Crear el primero
        </button>
        {createBlockedReason !== null && (
          <span class="visually-hidden" id={emptyBlockedId}>
            {createBlockedReason}
          </span>
        )}
      </RegionMessage>
    )
  }

  {
    plan.mode === "error" && (
      <RegionMessage
        kind="error"
        title={plan.copy.title}
        detail={plan.copy.detail}
        actionLabel="Reintentar"
      />
    )
  }

  {plan.mode === "loading" && <ProjectsSkeleton />}

  {
    /* Rendered once, outside `[data-projects]` and outside every plan arm. The
      list island delegates clicks and mounts menus on its own subtree, so a
      dialog inside it would have two owners for the same pickers — and the
      empty arm, which offers creation, does not render that subtree at all. */
  }
  <CreateProjectDialog
    clients={clients}
    engagementTypes={catalog?.engagement_types ?? []}
    projectTypes={catalog?.project_types ?? []}
    stages={catalog?.stages ?? []}
    currencies={catalog?.currencies ?? []}
    members={members}
    isTeamUnavailable={!teamResult.ok}
  />

  {/* Before paint, so a table-first operator never sees the grid flash by. */}
  <script is:inline>
    try {
      var container = document.querySelector("[data-projects]");
      if (container !== null) {
        container.setAttribute(
          "data-view",
          window.localStorage.getItem("aztec.ui.projects-view") === "table"
            ? "table"
            : "grid",
        );
      }
    } catch {
      /* storage disabled: the grid is the default and the toggle still works */
    }
  </script>

  <script>
    import { onPage } from "../../components/projects/island";
    import { mountProjectsList } from "../../components/projects/list-island";
    import { mountCreateProject } from "../../components/projects/create-project";

    onPage("[data-projects]", mountProjectsList);
    onPage("[data-create-project-dialog]", mountCreateProject);
  </script>
</Shell>

<style>
  .page-head {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: var(--space-4);
    flex-wrap: wrap;
    margin-bottom: var(--space-5);
  }

  .lead {
    color: var(--tinta-media);
    margin-top: var(--space-2);
  }

  .head-actions {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    flex-wrap: wrap;
  }

  .projects-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(288px, 1fr));
    gap: var(--space-4);
    align-items: stretch;
  }

  /* One representation at a time; the hidden one generates no boxes, which is
     also what keeps a single `view-transition-name` per project code. */
  .projects[data-view="grid"] :global([data-projects-table]) {
    display: none;
  }

  .projects[data-view="table"] .projects-grid {
    display: none;
  }

  .projects-grid[hidden],
  .projects :global([data-projects-table][hidden]) {
    display: none;
  }

  @media (max-width: 767px) {
    /* Below the table's breakpoint the cards carry every column, so the
       surface falls back to them instead of scrolling a wide grid sideways. */
    .projects[data-view="table"] .projects-grid {
      display: grid;
    }

    .projects[data-view="table"] :global([data-projects-table]) {
      display: none;
    }
  }
</style>
