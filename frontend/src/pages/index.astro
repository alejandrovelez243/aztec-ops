---
/**
 * Resumen — the landing surface (`/`), comp C "Zonas del día".
 *
 * The day arrives as three density zones instead of a band of hero metrics:
 * "Atender hoy" holds the top of the queue as full cards, "Esta semana" the next
 * band, "Radar" the rest as slim rows. Counts live in the zone headings, which
 * is the whole reason the KPI-tile template was refused — a number nobody can
 * act on is not a landing screen. Beside them: who is carrying the load, and the
 * activity region the API cannot feed yet.
 *
 * This file is the container (`docs/standards/PATTERNS_FRONTEND.md` §5): it
 * performs the two reads for the first paint, maps each onto the view-state
 * union, and composes. It renders no card markup of its own — `overview/markup`
 * is the single renderer, shared with the island, so a server-rendered zone and
 * a live-patched one cannot drift apart.
 *
 * Ranks are continuous across all three zones: Radar starts where Esta semana
 * stopped, never at one. Zone membership is a rank band over the API's own
 * ordering, never a list of workflow states — a state added from the admin
 * changes nothing here (CLAUDE.md rule 1).
 */
import ActivityPending from "../components/overview/ActivityPending.astro";
import OwnerLoadTeaser from "../components/overview/OwnerLoadTeaser.astro";
import { PAGE_COPY, QUEUE_COPY, TEAM_COPY } from "../components/overview/copy";
import {
  renderQueueRegion,
  type RegionKey,
} from "../components/overview/markup";
import { QUEUE_PAGE_SIZE } from "../components/overview/model";
import OverviewLive from "../islands/OverviewLive.astro";
import Shell from "../layouts/Shell.astro";
import { getQueue, getTeamLoad } from "../lib/api/client";
import { toViewState } from "../lib/view-state";
import "../components/overview/overview.css";

/** One reference instant for the whole render, so two cards cannot straddle midnight. */
const now = new Date();

// Both reads are independent; serialising them would add a round trip to the
// first paint for nothing.
const [queueResult, teamResult] = await Promise.all([
  getQueue({ page_size: QUEUE_PAGE_SIZE }),
  getTeamLoad(),
]);

// `"connecting"` is the only honest stream status during a server render: no
// island has hydrated, so nothing is subscribed and nothing has gone stale yet.
// The `disconnected` arm belongs to the island, which is what learns the stream
// dropped.
const queueState = toViewState(queueResult, "connecting", {
  isEmpty: (page) => page.items.length === 0,
  emptyMessage: QUEUE_COPY.emptyBody,
  lastEventAt: null,
});

const teamState = toViewState(teamResult, "connecting", {
  isEmpty: (page) => page.items.length === 0,
  emptyMessage: TEAM_COPY.emptyBody,
  lastEventAt: null,
});

/**
 * Regions the island must read again from the browser.
 *
 * This render runs without the operator's session — tokens live in the browser —
 * so an authenticated read can come back refused here and succeed there. Only a
 * region that actually failed is listed; one that painted rows is never
 * re-fetched.
 */
const hydrate: RegionKey[] = [];
if (queueState.kind === "error") hydrate.push("queue");
if (teamState.kind === "error") hydrate.push("team");
---

<Shell
  title={PAGE_COPY.title}
  active="overview"
  crumbs={[{ label: PAGE_COPY.crumb }]}
>
  <div class="ov-page">
    <header>
      <h1 class="h1">{PAGE_COPY.title}</h1>
      <p class="body-text ov-lead">{PAGE_COPY.lead}</p>
    </header>

    <OverviewLive hydrate={hydrate}>
      <div class="ov-columns">
        <div
          class="ov-queue"
          data-ov-region="queue"
          data-state={queueState.kind}
          set:html={renderQueueRegion(queueState, now)}
        />
        <aside class="ov-aside">
          <OwnerLoadTeaser state={teamState} />
          <ActivityPending />
        </aside>
      </div>
    </OverviewLive>
  </div>
</Shell>
