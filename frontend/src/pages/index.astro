---
import OpenBlockersPanel, {
  type BlockerLine,
} from "../components/command-center/OpenBlockersPanel.astro";
import NoNextStepPanel, {
  type NoNextStepLine,
} from "../components/command-center/NoNextStepPanel.astro";
import OwnerLoadPanel from "../components/command-center/OwnerLoadPanel.astro";
import PriorityQueue from "../islands/PriorityQueue.astro";
import Shell from "../layouts/Shell.astro";
import { getQueue, getTeamLoad } from "../lib/api/client";
import type { QueueItem, QueuePage, TeamLoad } from "../lib/api/domain";
import { assertNever, toViewState } from "../lib/view-state";
import type { ViewState } from "../lib/view-state";

/**
 * Command center (`/`): the full-bleed status matrix plus its server-rendered summary panels.
 *
 * First paint is fetched here in frontmatter (`GET /api/v1/queue`, `GET /api/v1/team/load`);
 * the `PriorityQueue` island keeps the rows live over SSE and never refetches to populate
 * itself. The panels are static server renders — they re-render on navigation, per the
 * hydration table in docs/standards/FRONTEND.md §4.
 */

/**
 * Fixed legend positions of the matrix's risk block, first cell leftmost (DESIGN.md, Layout).
 * Display order only — a flag outside this list still renders, appended after the fixed cells.
 */
const LEGEND_ORDER = [
  "BLOCKED",
  "OVERDUE",
  "NO_NEXT_STEP",
  "NO_TARGET_DATE",
  "STALE",
  "OWNER_OVERLOADED",
] as const;

const queueResult = await getQueue();
const teamResult = await getTeamLoad();

/** The matrix's view state; `"connecting"` because the stream has no meaning during SSR. */
const queueState = toViewState(queueResult, "connecting", {
  isEmpty: (data) => data.items.length === 0,
  emptyMessage:
    "No projects in the queue. Register the first project to put the board on the air.",
  lastEventAt: null,
});

const teamPageState = toViewState(teamResult, "connecting", {
  isEmpty: (data) => data.items.length === 0,
  emptyMessage: "No active owners on the roster.",
  lastEventAt: null,
});

/**
 * Derives a panel's view state from a fetched page: the panels read the same fetch, so a fetch
 * failure is a panel failure, and a panel-specific emptiness (`no open blockers`) is its own
 * `empty` arm with its own copy.
 */
function mapPanel<S, T>(
  state: ViewState<S>,
  pick: (data: S) => T[],
  emptyMessage: string,
): ViewState<readonly T[]> {
  switch (state.kind) {
    case "loading":
      return { kind: "loading" };
    case "error":
      return { kind: "error", code: state.code, message: state.message };
    case "empty":
      return { kind: "empty", message: emptyMessage };
    case "ready":
    case "disconnected": {
      const lines = pick(state.data);
      if (lines.length === 0) {
        return { kind: "empty", message: emptyMessage };
      }
      return state.kind === "ready"
        ? { kind: "ready", data: lines, lastEventAt: state.lastEventAt }
        : { kind: "disconnected", data: lines, lastEventAt: state.lastEventAt };
    }
    default:
      return assertNever(state);
  }
}

/** The roster page flattened to its entries for the owner-load panel. */
function pickTeamEntries(page: TeamLoad): NonNullable<TeamLoad["items"]> {
  return page.items;
}

const teamState = mapPanel(
  teamPageState,
  pickTeamEntries,
  "No active owners on the roster.",
);

/** Projects carrying open blockers, worst count first, with the `BLOCKED` flag's reason. */
function pickBlockerLines(items: readonly QueueItem[]): BlockerLine[] {
  return items
    .filter((item) => item.open_blockers > 0)
    .map((item) => ({
      code: item.code,
      name: item.name,
      openBlockers: item.open_blockers,
      reason:
        item.risk_flags.find((flag) => flag.code === "BLOCKED")?.reason ?? null,
    }))
    .sort((a, b) => b.openBlockers - a.openBlockers);
}

/** Projects flagged `NO_NEXT_STEP`, with the specification's reason and the owner's label. */
function pickNoNextStepLines(items: readonly QueueItem[]): NoNextStepLine[] {
  const lines: NoNextStepLine[] = [];
  for (const item of items) {
    const flag = item.risk_flags.find(
      (candidate) => candidate.code === "NO_NEXT_STEP",
    );
    if (flag !== undefined) {
      lines.push({
        code: item.code,
        name: item.name,
        ownerLabel: item.owner?.label ?? null,
        reason: flag.reason,
      });
    }
  }
  return lines;
}

const blockersState = mapPanel(
  queueState,
  (page: QueuePage) => pickBlockerLines(page.items),
  "No open blockers. Every project on the board is moving.",
);

const noNextStepState = mapPanel(
  queueState,
  (page: QueuePage) => pickNoNextStepLines(page.items),
  "Every project has a next step recorded.",
);

const skeletonRows = [0, 1, 2, 3, 4, 5, 6, 7];
---

<Shell title="Command Center">
  <div class="board">
    <header class="board-header">
      <h1 class="headline">Status matrix</h1>
      {
        queueState.kind === "ready" && (
          <span class="figure board-count">
            {queueState.data.count} projects
          </span>
        )
      }
    </header>

    {
      (() => {
        switch (queueState.kind) {
          case "loading":
            return (
              <table class="matrix" aria-busy="true">
                <thead>
                  <tr>
                    <th scope="col" class="label">
                      Code
                    </th>
                    <th scope="col" class="label">
                      Project / Client
                    </th>
                    <th scope="col" class="label col-owner">
                      Owner
                    </th>
                    <th scope="col" class="label">
                      Risk legend
                    </th>
                    <th scope="col" class="label col-countdown">
                      Countdown
                    </th>
                    <th scope="col" class="label">
                      Score
                    </th>
                    <th scope="col" class="label">
                      Verdict
                    </th>
                  </tr>
                </thead>
                <tbody>
                  {skeletonRows.map((row) => (
                    <tr class="page-skeleton-row" data-skeleton={row}>
                      <td colspan="7">
                        <div class="page-skeleton-bar" />
                      </td>
                    </tr>
                  ))}
                </tbody>
              </table>
            );
          case "empty":
            return (
              <section class="board-note" aria-label="Empty queue">
                <p class="body-text">{queueState.message}</p>
              </section>
            );
          case "error":
            return (
              <section class="board-note" role="alert">
                <p class="body-text">
                  The priority queue could not be fetched ({queueState.code}).
                  The board cannot render without it.
                </p>
                <a class="label board-retry" href="/">
                  Retry
                </a>
              </section>
            );
          case "ready":
          case "disconnected":
            return (
              <>
                {queueState.kind === "disconnected" && (
                  <p class="label board-stale" role="status">
                    Stream disconnected — rows may be stale
                    {queueState.lastEventAt !== null &&
                      ` · last event ${queueState.lastEventAt}`}
                  </p>
                )}
                <div class="matrix-scroll">
                  <table class="matrix">
                    <thead>
                      <tr>
                        <th scope="col" class="label">
                          Code
                        </th>
                        <th scope="col" class="label">
                          Project / Client
                        </th>
                        <th scope="col" class="label col-owner">
                          Owner
                        </th>
                        <th scope="col" class="label">
                          Risk legend
                        </th>
                        <th scope="col" class="label col-countdown">
                          Countdown
                        </th>
                        <th scope="col" class="label">
                          Score
                        </th>
                        <th scope="col" class="label">
                          Verdict
                        </th>
                      </tr>
                    </thead>
                    <PriorityQueue
                      items={queueState.data.items}
                      legendOrder={LEGEND_ORDER}
                    />
                  </table>
                </div>
              </>
            );
          default:
            return assertNever(queueState);
        }
      })()
    }

    <div class="panels">
      <OwnerLoadPanel state={teamState} />
      <OpenBlockersPanel state={blockersState} />
      <NoNextStepPanel state={noNextStepState} />
    </div>
  </div>
</Shell>

<style>
  .board {
    padding: var(--space-4);
  }

  .board-header {
    display: flex;
    align-items: baseline;
    gap: var(--space-3);
    margin-bottom: var(--space-3);
  }

  .board-header h1 {
    margin: 0;
    color: var(--color-legend);
  }

  .board-count {
    color: var(--color-legend-dim);
  }

  .matrix-scroll {
    overflow-x: auto;
  }

  .matrix {
    width: 100%;
    min-width: 960px;
    border-collapse: collapse;
    border-top: 1px solid var(--color-rule);
  }

  .matrix th {
    text-align: left;
    color: var(--color-legend-dim);
    padding: var(--space-2) var(--space-3);
    border-bottom: 1px solid var(--color-rule);
  }

  .board-note {
    border: 1px solid var(--color-rule);
    padding: var(--space-4);
    color: var(--color-legend-dim);
  }

  .board-retry {
    display: inline-block;
    margin-top: var(--space-2);
    color: var(--color-legend);
    border: 1px solid var(--color-rule);
    padding: var(--space-1) var(--space-2);
    text-decoration: none;
  }

  .board-retry:hover {
    background: var(--color-plate);
  }

  .board-stale {
    color: var(--color-caution);
    margin: 0 0 var(--space-2);
  }

  .page-skeleton-row {
    height: 40px;
  }

  .page-skeleton-row td {
    border-bottom: 1px solid var(--color-rule);
    padding: var(--space-1) var(--space-3);
  }

  .page-skeleton-bar {
    height: 20px;
    background: var(--color-plate);
    border: 1px solid var(--color-rule);
  }

  .panels {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--space-4);
    margin-top: var(--space-6);
  }

  /* Column shedding below 1024px, in the DESIGN.md order: client, owner, then countdown.
     The td rules live in the cell components (global styles); these hide the headers. */
  @media (max-width: 900px) {
    .col-owner {
      display: none;
    }
  }

  @media (max-width: 768px) {
    .col-countdown {
      display: none;
    }
  }

  @media (max-width: 1024px) {
    .panels {
      grid-template-columns: 1fr;
    }
  }
</style>
