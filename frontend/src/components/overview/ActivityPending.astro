---
/**
 * "Última actividad" — a designed hole, not a missing region.
 *
 * The portfolio-wide feed this surface wants needs an endpoint the API does not
 * publish: `backend/apps/activity/api/routers.py` exposes only
 * `GET /api/v1/projects/{code}/activity`, and there is no client function for a
 * global read in `src/lib/api/client.ts`.
 *
 * Shipping the region as a stated absence rather than omitting it is the
 * Present-Absence Rule applied to the product itself: a reviewer sees what is
 * owed, and nobody is tempted to fill the space with one project's trail dressed
 * up as the portfolio's. When the endpoint lands, this component is replaced by
 * a feed — the layout slot around it does not move.
 */
import Icon from "../ui/Icon.astro";
import { ACTIVITY_COPY } from "./copy";
---

<section class="card ov-panel ov-pending" aria-labelledby="ov-activity-title">
  <header class="ov-pending-head">
    <span class="ov-pending-icon"><Icon name="pulse" /></span>
    <h2 class="h2" id="ov-activity-title">{ACTIVITY_COPY.title}</h2>
    <span class="chip tone-ambar">{ACTIVITY_COPY.pendingChip}</span>
  </header>
  <p class="body-text">{ACTIVITY_COPY.body}</p>
  <span class="chip chip-code ov-pending-endpoint">GET /api/v1/activity</span>
  <p class="small ov-pending-aside">{ACTIVITY_COPY.aside}</p>
</section>
