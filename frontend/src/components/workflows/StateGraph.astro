---
/**
 * The workflow drawn: a card per state in the operator's order, and an arrow per
 * configured move arching over the row when it advances and under it when it
 * goes back.
 *
 * **The drawing is `aria-hidden`.** It is a picture of something the tables
 * beside it state in full — a screen reader that walked a hundred bezier paths
 * would learn nothing the rows do not say better, and two accessible copies of
 * one graph is two things to keep in agreement. It is also why **no control ever
 * goes inside it**: a focusable button in an `aria-hidden` subtree is focus
 * landing somewhere the screen reader refuses to describe, so a state is edited
 * from its row in the states table, never from its card here.
 *
 * The scroll container around it is *not* hidden, and that is deliberate rather
 * than an oversight. A horizontally scrollable region is keyboard-focusable
 * (Firefox makes it so on its own), so the container keeps a label that says
 * what it holds and where the content really is, and everything inside it is
 * hidden — a keyboard can still scroll the picture, and a reader is pointed at
 * the tables instead of walked through the paths.
 *
 * Geometry arrives already computed (`components/workflows/graph.ts`), so the
 * arcs line up with the cards on the server's first paint, and the editor
 * repaints from the same model after a write: the numbers the CSS positions the
 * cards with are the numbers the SVG drew its paths in, whoever emitted them.
 *
 * The two templates at the bottom are the editor's only way to add a card or an
 * arrow. Cloned rather than built in TypeScript, so a live node carries this
 * component's scope attribute and its styles — and, for the arrow, so the
 * `<path>` is parsed inside `<svg>` and is a real SVG element rather than an
 * unknown HTML tag.
 *
 * The two cases the layout has to survive: a **back edge**, which is why arcs
 * have a side at all, and a **state nothing touches**, which keeps its column
 * and says so on the card rather than quietly vanishing from the picture.
 */
import { GRAPH, ROLE_NOTE } from "./graph";
import type { ArcView, NodeView } from "./graph";

export interface Props {
  nodes: readonly NodeView[];
  arcs: readonly ArcView[];
  /** Diagram width in px, from the model — the scroll container's content size. */
  width: number;
  /** Diagram height in px, from the model. */
  height: number;
  /** Document-unique id of this graph's arrowhead marker. */
  arrowId: string;
}

const { nodes, arcs, width, height, arrowId } = Astro.props;

/** Joins the custom properties an element needs, dropping the ones it has none of. */
function styleOf(parts: readonly (string | null)[]): string {
  return parts.filter((part): part is string => part !== null).join(";");
}

const canvasStyle = styleOf([
  `--graph-w:${width}px`,
  `--graph-h:${height}px`,
  `--node-w:${GRAPH.nodeWidth}px`,
  `--node-h:${GRAPH.nodeHeight}px`,
]);
---

<figure class="graph" data-graph>
  <div
    class="scroller"
    tabindex="0"
    role="group"
    aria-label="Diagrama del flujo; los mismos estados y movimientos están en las tablas siguientes"
  >
    <div class="canvas" data-canvas style={canvasStyle} aria-hidden="true">
      <svg
        class="arcs"
        data-arcs
        viewBox={`0 0 ${width} ${height}`}
        width={width}
        height={height}
        focusable="false"
      >
        <defs>
          <marker
            id={arrowId}
            data-arrow-marker
            viewBox="0 0 10 10"
            refX="9"
            refY="5"
            markerWidth="6"
            markerHeight="6"
            orient="auto"
            markerUnits="strokeWidth"
          >
            <path d="M1 1 L9 5 L1 9 Z" fill="currentColor"></path>
          </marker>
        </defs>
        <g data-arc-group>
          {
            arcs.map((arc) => (
              <path
                class="arc"
                d={arc.path}
                data-direction={arc.direction}
                marker-end={`url(#${arrowId})`}
              />
            ))
          }
        </g>
      </svg>

      <ul class="nodes" data-nodes>
        {
          nodes.map((node) => (
            <li
              class:list={["node", "card", node.toneClass]}
              style={styleOf([
                `--x:${node.x}px`,
                `--y:${node.y}px`,
                node.toneStyle,
              ])}
              data-role={node.role}
            >
              <span class="node-label title" data-field="node-label">
                {node.state.label}
              </span>
              <span class="node-code figure" data-field="node-code">
                {node.state.code}
              </span>
              <span
                class="chip node-note"
                data-field="node-note"
                hidden={ROLE_NOTE[node.role] === null}
              >
                {ROLE_NOTE[node.role]}
              </span>
            </li>
          ))
        }
      </ul>

      <ul class="captions" data-captions>
        {
          arcs.map((arc) => (
            <li
              class="caption"
              style={styleOf([`--x:${arc.labelX}px`, `--y:${arc.labelY}px`])}
            >
              <span class:list={["chip", arc.requiresReason && "tone-ambar"]}>
                <span data-field="caption-label">{arc.label}</span>{" "}
                <b
                  class="mark"
                  data-field="caption-mark"
                  hidden={!arc.requiresReason}
                >
                  *
                </b>
              </span>
            </li>
          ))
        }
      </ul>
    </div>
  </div>

  {/* The editor's hands: one card, one arrow, one caption. */}
  <template data-template="graph-node">
    <li class="node card" data-role="connected">
      <span class="node-label title" data-field="node-label"></span>
      <span class="node-code figure" data-field="node-code"></span>
      <span class="chip node-note" data-field="node-note" hidden></span>
    </li>
  </template>

  <template data-template="graph-arc">
    <svg focusable="false"><path class="arc"></path></svg>
  </template>

  <template data-template="graph-caption">
    <li class="caption">
      <span class="chip">
        <span data-field="caption-label"></span>{" "}<b
          class="mark"
          data-field="caption-mark"
          hidden>*</b
        >
      </span>
    </li>
  </template>
</figure>

<style>
  /* `min-width: 0` is what lets the scroller below actually scroll: as a grid
     item the figure is otherwise floored by its own min-content — the full
     width of the drawing — and the page ends up carrying the overflow. */
  .graph {
    margin: 0;
    min-width: 0;
  }

  /* The drawing is wider than any content column it will ever sit in, so it
     scrolls inside its own well instead of pushing the page sideways. */
  .scroller {
    overflow-x: auto;
    overscroll-behavior-x: contain;
    padding: var(--space-3);
    border-radius: var(--radius-card);
    background-color: var(--pozo);
  }

  .canvas {
    position: relative;
    width: var(--graph-w);
    height: var(--graph-h);
  }

  .arcs {
    position: absolute;
    inset: 0;
    color: var(--tinta-suave);
    overflow: visible;
  }

  .arc {
    fill: none;
    stroke: currentColor;
    stroke-width: 1.5;
    stroke-linecap: round;
  }

  /* --- The cards --- */

  .node {
    position: absolute;
    left: var(--x);
    top: var(--y);
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: var(--space-1);
    width: var(--node-w);
    height: var(--node-h);
    padding: var(--space-3) var(--space-3) var(--space-3) var(--space-4);
    overflow: hidden;
    /* The marker stripe of the wall card, kept beside the card's own elevation:
       `.rail` in base.css replaces `box-shadow` outright, which would flatten
       the card onto the wall the moment it carried a tone. */
    box-shadow:
      inset var(--rail-width) 0 0 0 var(--tone-solid),
      var(--shadow-resting);
  }

  .node-label {
    color: var(--tinta);
    /* Two lines of room before a long label is cut: the card's height is fixed
       by the geometry the arcs were drawn against and cannot grow to fit one. */
    display: -webkit-box;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 2;
    line-clamp: 2;
    overflow: hidden;
  }

  .node-code {
    color: var(--tinta-suave);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  /* A state the configuration strands is marked on the card, because the reader
     who came here to find out why is looking straight at it. */
  .node-note {
    align-self: flex-start;
    margin-top: var(--space-1);
    text-transform: none;
    letter-spacing: 0;
  }

  /* `.node-note` is a flex item; an author rule beats the user agent's
     `[hidden] { display: none }`, so a connected card would show an empty chip
     without this. */
  .node-note[hidden],
  .mark[hidden] {
    display: none;
  }

  .node[data-role="isolated"] {
    border-style: dashed;
  }

  /* --- The arrow captions --- */

  .caption {
    position: absolute;
    left: var(--x);
    top: var(--y);
    transform: translate(-50%, -50%);
  }

  .caption .chip {
    background-color: var(--tone-wash, var(--carta));
    box-shadow: 0 0 0 var(--border-width) var(--hairline);
    text-transform: none;
    letter-spacing: 0;
    font-weight: var(--text-title-weight);
  }

  .mark {
    font-weight: var(--text-label-weight);
  }
</style>
