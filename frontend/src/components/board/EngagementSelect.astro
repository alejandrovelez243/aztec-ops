---
/**
 * The engagement-type field: which portfolio the rail and the board are showing.
 *
 * One type at a time is a product decision, not a layout accident — two engagement types can
 * be bound to different workflows, so a single rail for both would either mix two vocabularies
 * or invent a union nobody works in.
 *
 * It is a `MenuSelect`, never a `<select>` (`docs/standards/FRONTEND.md` §10): the native
 * popup is drawn by the operating system, so it lands as a grey system list in the middle of a
 * surface that is otherwise all paper and ink, no design token reaches inside it, and its
 * chrome speaks the OS locale rather than the Spanish this interface owes the operator.
 *
 * The count travels inside each entry's text, because the field answers "which portfolio, and
 * how much is in it" in one glance. It follows the member filter, so the island rewrites the
 * whole list through `setMenuOptions` when the filter changes; the bare label it rebuilds each
 * entry from comes from the rail panel's `data-engagement-label`, not from the text it is
 * about to overwrite.
 *
 * Presentational: it renders entries and announces a choice through the DOM. What a choice
 * means — swapping both halves, persisting the preference — belongs to `BoardCanvas`.
 */
import MenuSelect from "../ui/MenuSelect.astro";
import type { MenuOption } from "../ui/MenuSelect.astro";
import { ENGAGEMENT_FACET } from "./board-dom";

export interface Option {
  readonly code: string;
  readonly label: string;
  /** Projects of this type on the rail; a count, never a badge of alarm. */
  readonly count: number;
}

export interface Props {
  options: readonly Option[];
  /** Code rendered as chosen on the server; the browser may swap it to the stored choice. */
  active: string;
}

const { options, active } = Astro.props;

const entries: MenuOption[] = options.map((option) => ({
  value: option.code,
  label: `${option.label} · ${option.count}`,
}));
---

<div class="eng" lang="es">
  <MenuSelect
    facet={ENGAGEMENT_FACET}
    label="Tipo de encargo"
    options={entries}
    value={active}
  />
</div>

<style>
  .eng {
    min-width: 0;
  }

  /* Wide enough for "Mantenimiento o recurrente · 12" without truncating, and capped so the
     toolbar keeps room for the roster beside it. */
  .eng :global(.menu-select) {
    width: clamp(220px, 26vw, 320px);
  }
</style>
