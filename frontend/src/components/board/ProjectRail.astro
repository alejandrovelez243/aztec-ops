---
import ProjectRailSection from "./ProjectRailSection.astro";
import type { BoardSurfaceModel } from "./board-model";

/**
 * The rail: the portfolio as a narrow vertical stack, one band per project workflow state.
 *
 * This is the half an operations lead reads first — where every project currently sits — and
 * the half they act on by dragging a card up or down into another state. It is deliberately
 * narrow and deliberately scrollable as *one* column: the eye runs down a single list of
 * zones instead of across a wall, which is what makes "what is blocked" a glance rather than
 * a scan.
 *
 * One panel per engagement type, because `Workflow.objects.resolve` binds a graph per type:
 * switching the engagement field swaps the whole set of bands, not just their contents.
 * Exactly one panel is ever visible; the others stay in the DOM so the switch costs no request.
 *
 * Each panel carries `data-engagement-label` beside its code because it is the one place the
 * engagement type's *rendered* label survives: the field's own entries are rewritten with a
 * count on every filter change, so reading a name back out of them would eat the name. Same
 * rule as Data-Owns-Color — the taxonomy's word comes from the payload, never from the DOM
 * text of a control.
 *
 * Presentational. The island owns selection, dragging, filtering and every live patch; this
 * component decides the markup and holds the Spanish.
 */
export interface Props {
  surfaces: readonly BoardSurfaceModel[];
  /** Engagement type painted first; the browser may swap to the operator's stored choice. */
  active: string;
  /** The project rendered as selected, when one is. */
  selectedCode?: string | null;
  /**
   * Why the ghost slot at the foot of every band is dead — no counterparties to register a
   * project against, or a failed catalog read. `null` when creation is available.
   */
  createBlockedReason?: string | null;
}

const {
  surfaces,
  active,
  selectedCode = null,
  createBlockedReason = null,
} = Astro.props;
---

<aside class="rail" data-rail data-scroller aria-label="Proyectos por estado">
  {
    surfaces.map((surface) => (
      <section
        class="rail-panel"
        data-panel
        data-engagement-code={surface.engagementType.code}
        data-engagement-label={surface.engagementType.label}
        hidden={surface.engagementType.code !== active}
        aria-label={`Proyectos de ${surface.engagementType.label}`}
      >
        {surface.sections.map((section) => (
          <ProjectRailSection
            section={section}
            engagementCode={surface.engagementType.code}
            selectedCode={selectedCode}
            createBlockedReason={createBlockedReason}
          />
        ))}
      </section>
    ))
  }
</aside>

<style>
  .rail {
    display: flex;
    flex-direction: column;
    min-height: 0;
    min-width: 0;
    padding: var(--space-4);
    /*
     * The one side that is not uniform. The rail is capped at the viewport and
     * scrolls inside it, so a `--space-4` bottom leaves the last card — or the
     * ghost slot of a short band — sliced flush against the fold, which reads as
     * a broken panel rather than as a list that continues. The extra inset is
     * the scroll *end*: the stack visibly finishes, with paper under it.
     */
    padding-bottom: var(--space-7);
    background-color: var(--papel);
    /* One column that scrolls as one: the stack of zones is the unit of reading. */
    overflow-y: auto;
    overflow-x: hidden;
    overscroll-behavior-y: contain;
    scroll-snap-type: y proximity;
    /*
     * No height of its own, deliberately. It used to cap itself at `100dvh` and
     * stick to the top, because `.shell` grew to its content and nothing above
     * the rail was bounded. That cap was measured from the wrong origin: the
     * rail starts below the page header, so a full viewport of height ended a
     * header's worth *below* the fold, and the last card sat in a region the
     * window clipped and the rail's own scrollbar could not reach.
     *
     * `.shell[data-wide]` is now pinned to the viewport, so this is a grid item
     * in a bounded row and `min-height: 0` above is the whole story: it takes
     * the space that is actually left and scrolls inside it.
     *
     * `relative` is load-bearing and is the one thing the old `sticky` was also
     * doing by accident. A scroller does not clip an absolutely positioned
     * descendant whose containing block lives outside it, and this rail has one
     * (`ProjectRailSection`). Without a containing block here that box escaped
     * the clip, and the window grew a second scrollbar for a list that was
     * already scrolling inside itself.
     */
    position: relative;
  }

  .rail-panel {
    display: flex;
    flex-direction: column;
    gap: var(--space-5);
    min-width: 0;
  }

  .rail-panel[hidden] {
    display: none;
  }

  /* A carried card must land where the hand is, not where a snap point decides. */
  :global(html[data-board-dragging="true"]) .rail {
    scroll-snap-type: none;
  }

  /* Below the rail's own width it lies down: a horizontal strip of the same zones,
     above the task board, still complete and still droppable. */
  @media (max-width: 1023px) {
    .rail {
      /* Lying down, it is a horizontal strip above the board, so the sticky
         column and its viewport cap would pin a strip nobody asked to pin. */
      position: static;
      max-height: none;
      overflow-x: auto;
      overflow-y: hidden;
      overscroll-behavior-x: contain;
      scroll-snap-type: x proximity;
      padding: var(--space-3) var(--space-4);
    }

    .rail-panel {
      flex-direction: row;
      align-items: flex-start;
      gap: var(--space-4);
    }
  }
</style>
