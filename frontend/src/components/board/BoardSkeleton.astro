---
/**
 * The board's loading arm: the exact geometry of the loaded board, shimmering.
 *
 * Whole-page spinners are forbidden (DESIGN.md §Motion), and a skeleton that does not match
 * the final layout is worse than none — the operator reads a shape, then watches it jump.
 * Four columns of three cards is the shape of the seeded portfolio; the real column count
 * arrives with the data.
 */
const COLUMNS = 4;
const CARDS_PER_COLUMN = 3;

const columns = Array.from({ length: COLUMNS }, (_, index) => index);
const cards = Array.from({ length: CARDS_PER_COLUMN }, (_, index) => index);
---

<div class="skeleton-board" aria-busy="true" aria-live="polite">
  <p class="visually-hidden" lang="es">Cargando el tablero…</p>
  {
    columns.map(() => (
      <section class="skeleton-column">
        <div class="skeleton-head">
          <span class="skeleton skeleton-title" />
          <span class="skeleton skeleton-count" />
        </div>
        <div class="well skeleton-body">
          {cards.map(() => (
            <div class="card skeleton-card">
              <span class="skeleton skeleton-chip" />
              <span class="skeleton skeleton-line" />
              <span class="skeleton skeleton-line short" />
              <div class="skeleton-foot">
                <span class="skeleton skeleton-avatar" />
                <span class="skeleton skeleton-chip" />
                <span class="skeleton skeleton-score" />
              </div>
            </div>
          ))}
        </div>
      </section>
    ))
  }
</div>

<style>
  .skeleton-board {
    display: grid;
    grid-auto-flow: column;
    /* Same resting column width as the loaded board (islands/BoardCanvas.astro): a
       skeleton in a different shape is a promise the paint then breaks. */
    --column-min: 268px;
    grid-auto-columns: minmax(var(--column-min), 1fr);
    gap: var(--space-4);
    overflow-x: auto;
  }

  .skeleton-column {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
  }

  .skeleton-head {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    padding-inline: var(--space-2);
    min-height: var(--space-6);
  }

  .skeleton-title {
    width: 96px;
    height: var(--space-3);
  }

  .skeleton-count {
    width: var(--space-5);
    height: var(--space-3);
    margin-left: auto;
  }

  .skeleton-body {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
    padding: var(--space-3);
    min-height: 120px;
  }

  .skeleton-card {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    padding: var(--space-3);
  }

  .skeleton-chip {
    width: 72px;
    height: var(--space-4);
  }

  .skeleton-line {
    width: 100%;
    height: var(--space-4);
  }

  .skeleton-line.short {
    width: 60%;
  }

  .skeleton-foot {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    padding-top: var(--space-2);
    border-top: var(--border-width) solid var(--hairline);
  }

  .skeleton-avatar {
    width: var(--space-5);
    height: var(--space-5);
    border-radius: var(--radius-full);
  }

  .skeleton-score {
    width: var(--space-6);
    height: var(--space-4);
    margin-left: auto;
  }
</style>
