---
import type { Tone } from "./board-model";

/**
 * The engagement-type switcher: which wall you are standing in front of.
 *
 * One type at a time is a product decision, not a layout accident — two engagement types
 * usually run different workflows, so a single row of columns for both would either mix two
 * vocabularies or invent a union nobody works in.
 *
 * The pressed pill is Cobalto because it is the interface saying "you are here"; the type's
 * own colour only ever appears as the small dot beside it (DESIGN.md, One-Voice and Wash
 * rules).
 */
export interface Option {
  readonly code: string;
  readonly label: string;
  readonly tone: Tone;
  /** Projects of this type currently on the board; a count, never a badge of alarm. */
  readonly count: number;
}

export interface Props {
  options: readonly Option[];
  /** Code rendered as pressed on the server; the browser may swap it to the stored choice. */
  active: string;
}

const { options, active } = Astro.props;
---

<div
  class="switcher"
  data-engagement-switcher
  role="group"
  aria-label="Tipo de encargo"
>
  {
    options.map((option) => (
      <button
        type="button"
        class="btn pill switch-pill"
        data-engagement-pill
        data-engagement-code={option.code}
        aria-pressed={option.code === active ? "true" : "false"}
        aria-controls={`panel-${option.code}`}
        lang="es"
      >
        <span
          class:list={["dot", option.tone.className]}
          style={option.tone.style}
          aria-hidden="true"
        />
        <span class="switch-label">{option.label}</span>
        <span class="figure switch-count">{option.count}</span>
      </button>
    ))
  }
</div>

<style>
  .switcher {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    flex-wrap: wrap;
  }

  .switch-pill {
    height: 40px;
    padding-inline: var(--space-3);
    background-color: var(--carta);
    border: var(--border-width) solid var(--hairline);
    color: var(--tinta-media);
  }

  .switch-pill:hover {
    border-color: var(--tinta-suave);
    color: var(--tinta);
  }

  .switch-pill[aria-pressed="true"] {
    background-color: var(--cobalto-papel);
    border-color: var(--cobalto);
    color: var(--cobalto);
  }

  .switch-count {
    color: var(--tinta-suave);
  }

  .switch-pill[aria-pressed="true"] .switch-count {
    color: var(--cobalto);
  }
</style>
