---
/**
 * The `loading` arm of one person's card: the geometry of `LoadRow` with nothing in it.
 *
 * A separate component rather than a mode of `LoadRow`, because a component that renders
 * either real data or shimmering blocks depending on a flag is two components sharing a file
 * (`docs/standards/FRONTEND.md` §3). What it does owe `LoadRow` is the exact same geometry:
 * a skeleton that settles into a different layout is a page that jumps when the data lands.
 *
 * Purely decorative — the region announces the wait through its own live text, so nothing in
 * here reaches the accessibility tree.
 */
---

<li class="row card" aria-hidden="true">
  <div class="identity">
    <span class="avatar skeleton"></span>
    <div class="who">
      <span class="skeleton line name"></span>
      <span class="skeleton line meta"></span>
    </div>
    <span class="skeleton line figures"></span>
  </div>
  <div class="skeleton track"></div>
  <div class="chips">
    <span class="skeleton chip-ghost wide"></span>
    <span class="skeleton chip-ghost"></span>
  </div>
</li>

<style>
  .row {
    display: grid;
    gap: var(--space-3);
    padding: var(--space-4);
  }

  .identity {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr) auto;
    align-items: center;
    gap: var(--space-3);
  }

  /* `.skeleton` is declared after `.avatar` in base.css and flattens its radius back to a
     chip; the disk has to stay a disk or the wait has a different shape than the answer. */
  .avatar.skeleton {
    border-radius: var(--radius-full);
  }

  .line {
    display: block;
    height: var(--space-3);
  }

  .name {
    width: 40%;
    margin-bottom: var(--space-2);
  }

  .meta {
    width: 62%;
  }

  /* Sized in characters, so the block is as wide as the readout it stands in for. */
  .figures {
    width: 13ch;
  }

  .track {
    height: var(--space-2);
    border-radius: var(--radius-full);
  }

  .chips {
    display: flex;
    gap: var(--space-2);
  }

  .chip-ghost {
    display: block;
    width: 11ch;
    height: var(--space-5);
    border-radius: var(--radius-chip);
  }

  .chip-ghost.wide {
    width: 16ch;
  }

  @media (max-width: 640px) {
    .identity {
      grid-template-columns: auto minmax(0, 1fr);
      row-gap: var(--space-2);
    }

    .figures {
      grid-column: 1 / -1;
    }
  }
</style>
