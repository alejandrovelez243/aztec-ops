---
/**
 * Replacing somebody's password, asked on its own.
 *
 * A separate dialog and not a field of the edit form, because it is a different action with a
 * different audit record and a different failure: the API answers a refused password with
 * *every* rule it broke, and this form renders all of them. Showing only the first is how
 * people end up retrying one rule at a time and settling on something worse.
 *
 * No current password is asked for: this is an ops lead resetting a credential on somebody
 * else's behalf, so there is none to verify. That is stated on screen rather than left as an
 * omission the operator has to interpret.
 */
---

<dialog
  class="dialog"
  data-password-dialog
  aria-labelledby="password-dialog-title"
>
  <form data-password-form novalidate>
    <h2 class="h2" id="password-dialog-title">
      Contraseña de <span data-field="password-target"></span>
    </h2>
    <p class="small lead">
      Queda activa de inmediato y la sesión que esa persona tuviera abierta
      caduca sola. En la bitácora queda quién la cambió y cuándo, nunca cuál es.
    </p>

    <label class="field">
      <span class="label">Nueva contraseña</span>
      <input
        class="input"
        type="password"
        name="password"
        required
        autocomplete="new-password"
      />
    </label>

    {
      /* One item per rule the server rejected, because it answers with all of them at once. */
    }
    <ul class="problems" data-field="password-problems" hidden></ul>

    <div class="dialog-actions">
      <button class="btn btn-ghost" type="button" data-action="close-password">
        Cancelar
      </button>
      <button
        class="btn btn-primary"
        type="submit"
        data-action="submit-password"
      >
        Cambiar contraseña
      </button>
    </div>
  </form>
</dialog>

<style>
  .dialog {
    width: min(460px, calc(100vw - var(--space-6)));
    padding: var(--space-5);
    border: var(--border-width) solid var(--hairline);
    border-radius: var(--radius-card);
    background-color: var(--carta);
    box-shadow: var(--shadow-lifted);
    color: var(--tinta);
  }

  .dialog::backdrop {
    background-color: var(--scrim);
  }

  .dialog form {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }

  .lead {
    color: var(--tinta-media);
  }

  .field {
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
  }

  /* `display: grid` below beats the user agent's `[hidden] { display: none }`, so the empty
     list would render as a gap before anything was ever rejected. */
  .problems[hidden] {
    display: none;
  }

  .problems {
    display: grid;
    gap: var(--space-1);
    margin: 0;
    padding-left: var(--space-4);
    list-style: disc;
    font-size: var(--text-small-size);
    line-height: var(--text-small-line);
    color: var(--rojo);
  }

  .dialog-actions {
    display: flex;
    justify-content: flex-end;
    gap: var(--space-2);
    margin-top: var(--space-2);
  }
</style>
