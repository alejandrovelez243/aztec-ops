---
/**
 * The question the roster answers: search, three facets, and the way in for a new person.
 *
 * Each facet is named after the API's own query parameter — the search input by its `name`, the
 * three pickers by their `facet` — and the island copies them straight into the URL. That is what
 * keeps the toolbar, the address bar and the request describing the same thing; a toolbar with
 * its own vocabulary would need a translation table, and the table is where the three drift apart.
 *
 * The pickers are `MenuSelect`, never a `<select>` (`FRONTEND.md` §10): the native popup is drawn
 * by the operating system, so it lands as a grey system list on a surface that is otherwise all
 * paper and ink, and no token reaches inside it. A `MenuSelect` carries no hidden input either —
 * its `data-value` *is* the field, which is what the island reads.
 *
 * The controls are rendered with the current query already selected, so a shared link opens on
 * the view it promises rather than on the default one.
 */
import Icon from "../ui/Icon.astro";
import MenuSelect from "../ui/MenuSelect.astro";
import type { RosterQuery } from "./table";
import type { TaxonomyRef } from "../../lib/api/domain";

export interface Props {
  query: RosterQuery;
  /** Every role a person can be classified under, in the order an operator arranged them. */
  roles: readonly TaxonomyRef[];
}

const { query, roles } = Astro.props;

/** `overloaded` is tri-state on the wire; the picker carries the three as strings. */
const overloadedValue =
  query.overloaded === null ? "" : String(query.overloaded);

const roleOptions = [
  { value: "", label: "Todos" },
  ...roles.map((role) => ({ value: role.code, label: role.label })),
];

const statusOptions = [
  { value: "active", label: "Activas" },
  { value: "inactive", label: "Retiradas" },
  { value: "all", label: "Todas" },
];

const overloadedOptions = [
  { value: "", label: "Cualquiera" },
  { value: "true", label: "Con sobrecarga" },
  /* The third answer a boolean could not give: who still has room to take work. */
  { value: "false", label: "Con margen" },
];
---

<form class="toolbar card" data-roster-toolbar role="search" novalidate>
  <label class="search">
    <span class="visually-hidden">Buscar una persona</span>
    <span class="search-icon" aria-hidden="true">
      <Icon name="search" size={16} />
    </span>
    <input
      class="input"
      type="search"
      name="q"
      value={query.search}
      placeholder="Buscar por nombre o código"
      autocomplete="off"
    />
  </label>

  <MenuSelect
    facet="role"
    label="Rol"
    options={roleOptions}
    value={query.role ?? ""}
  />

  <MenuSelect
    facet="status"
    label="Estado"
    options={statusOptions}
    value={query.status}
  />

  <MenuSelect
    facet="overloaded"
    label="Carga"
    options={overloadedOptions}
    value={overloadedValue}
  />

  <div class="tools">
    <button class="btn btn-secondary" type="button" data-roster-action="clear">
      Limpiar
    </button>
    {
      /*
       * Roles sit beside the facet that uses them rather than behind a settings screen: the
       * moment somebody needs a role that does not exist is the moment they are filling this
       * form, and a trip to `/admin/` is how a person gets filed under the wrong one.
       */
    }
    <button
      class="btn btn-secondary"
      type="button"
      data-roster-action="roles"
      data-roster-actions
      hidden
    >
      Roles
    </button>
    <button
      class="btn btn-primary"
      type="button"
      data-roster-action="create"
      data-roster-actions
      hidden
    >
      <Icon name="plus" size={16} />
      Añadir persona
    </button>
  </div>
</form>

<style>
  .toolbar {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-end;
    gap: var(--space-3);
    padding: var(--space-4);
  }

  .search {
    position: relative;
    flex: 1 1 18rem;
    min-width: 12rem;
  }

  .search-icon {
    position: absolute;
    top: 50%;
    left: var(--space-3);
    transform: translateY(-50%);
    color: var(--tinta-media);
    line-height: 0;
  }

  .search .input {
    width: 100%;
    padding-left: calc(var(--space-3) * 2 + 16px);
  }

  /* The pickers are a child component's markup, so the toolbar reaches them
     with `:global`; it decides how wide they sit, never how they look. */
  .toolbar :global(.menu-select) {
    min-width: 9rem;
  }

  .tools {
    display: flex;
    gap: var(--space-2);
    margin-left: auto;
  }

  /* Load-bearing: the island hides the roster-writing buttons for anyone who is not an ops
     lead, and `.btn`'s `display: inline-flex` would otherwise beat the user agent's `[hidden]`
     rule and offer every reader an action the API will refuse. */
  .tools [hidden] {
    display: none;
  }

  @media (max-width: 767px) {
    .toolbar :global(.menu-select) {
      flex: 1 1 100%;
      min-width: 0;
      width: 100%;
    }

    .tools {
      width: 100%;
      /* Two buttons whose labels cannot shrink: `flex: 1` sizes them to the
         room they have but never below their own text, so on a 360px phone the
         pair ran past the card and the *page* scrolled sideways. Wrapping puts
         the second one on its own line instead. */
      flex-wrap: wrap;
    }

    .tools .btn {
      flex: 1;
    }
  }
</style>
