---
/**
 * The identity card of one project: what it is, whose it is, where it stands,
 * and the legal moves out of here.
 *
 * The title carries `transition:name` so the card the operator clicked on
 * `/projects` becomes this heading instead of the page cutting to it — the
 * shared element that makes the two surfaces feel like one object being opened.
 *
 * Absences are named, never blank: no deadline is an ámbar "Sin fecha", and an
 * unowned project says so instead of leaving the cell empty.
 *
 * Three of those facts are also *editable here*, because naming an absence and
 * offering no cure is only half the job. The responsable is a menu over the
 * team, and the próximo paso — the one field a risk flag actively asks for — is
 * written in place. Both go through `PATCH /api/v1/projects/{code}` and both
 * repaint the whole header, the transition bar and the risk list from the
 * response, which is the project re-read after the write.
 *
 * The third is the tipo de encargo, and its chip *is* its own trigger
 * (`ConvertEngagementDialog`): converting a project is the one edit here whose
 * consequences reach past this card — the lifecycle that governs it and the
 * weight the queue gives it — so it is confirmed with a sentence first and the
 * page is re-read afterwards rather than patched.
 *
 * Between the facts and the moves sits the lifecycle: which graph this project
 * follows and whether somebody chose it for this project or it came from the
 * engagement type. It is the sentence that explains the transition bar — two
 * projects of the same type may legitimately be running different lifecycles,
 * and "why does that one have a button this one has not" has to be answerable
 * from the screen. Changing it is an ops lead's, on its own route.
 */
import ConvertEngagementDialog from "./ConvertEngagementDialog.astro";
import DateField from "../ui/DateField.astro";
import LifecyclePlate from "../lifecycle/LifecyclePlate.astro";
import NextStepField from "./NextStepField.astro";
import OwnerMenu from "./OwnerMenu.astro";
import StateChip from "./StateChip.astro";
import TransitionBar from "./TransitionBar.astro";
import { NO_CONVERSIONS, type ConversionPlan } from "./convert-engagement";
import { healthTone } from "./tone";
import type { Transition, WorkflowRef } from "../../lib/api/domain";

export interface Props {
  code: string;
  name: string;
  /** One-line description; `null` when nobody wrote one. */
  summary: string | null;
  clientLabel: string;
  ownerAlias: string | null;
  ownerLabel: string | null;
  engagementLabel: string;
  engagementColor: string | null;
  /** `EngagementType.code`; what the lifecycle plate names the inherited graph from. */
  engagementCode: string;
  stateLabel: string;
  stateCategory: string;
  /** The state's `code`, which is what a lifecycle may or may not have a column for. */
  stateCode: string;
  stateColor: string | null;
  /** The graph `state` and `transitions` come from, and whether somebody chose it. */
  workflow: WorkflowRef;
  healthCode: string;
  healthLabel: string;
  targetDate: string | null;
  /** What happens next; `null` is the `NO_NEXT_STEP` signal itself. */
  nextStep: string | null;
  isArchived: boolean;
  /** The read's `updated_at`; every live patch is compared against it. */
  updatedAt: string;
  /** The only source of transition buttons (`docs/API.md` §2.2). */
  transitions: readonly Transition[];
  /** Aggregate attributes that are currently empty, from the same read. */
  emptyFields: readonly string[];
  /**
   * What converting this project into each other engagement type would do, composed by
   * `buildConversions` from the catalog and the workflow shapes the page read. Empty leaves
   * the chip visibly dead rather than absent.
   */
  conversions: readonly ConversionPlan[];
}

const {
  code,
  name,
  summary,
  clientLabel,
  ownerAlias,
  ownerLabel,
  engagementLabel,
  engagementColor,
  engagementCode,
  stateLabel,
  stateCategory,
  stateCode,
  stateColor,
  workflow,
  healthCode,
  healthLabel,
  targetDate,
  nextStep,
  isArchived,
  updatedAt,
  transitions,
  emptyFields,
  conversions,
} = Astro.props;

const health = healthTone(healthCode);
---

<header class="head card" data-project-header data-updated-at={updatedAt}>
  <div class="top">
    <span class="chip chip-code">{code}</span>
    <StateChip label={stateLabel} category={stateCategory} color={stateColor} />
    <span class:list={["chip", health]} data-health-chip>{healthLabel}</span>
    {isArchived && <span class="chip tone-piedra">Archivado</span>}
  </div>

  <h1 class="h1 name" transition:name={`proj-${code}`}>{name}</h1>
  {
    summary !== null && summary !== "" && (
      <p class="body-text summary">{summary}</p>
    )
  }

  <dl class="facts">
    <div class="fact">
      <dt class="label">Cliente</dt>
      <dd class="title">{clientLabel}</dd>
    </div>
    <div class="fact">
      <dt class="label">Responsable</dt>
      <dd>
        <OwnerMenu
          scope="project"
          code={code}
          alias={ownerAlias}
          label={ownerLabel}
        />
      </dd>
    </div>
    <div class="fact">
      <dt class="label">Tipo de encargo</dt>
      <dd>
        <ConvertEngagementDialog
          projectCode={code}
          label={engagementLabel}
          color={engagementColor}
          conversions={conversions}
          disabledReason={NO_CONVERSIONS}
        />
      </dd>
    </div>
    <div class="fact">
      <dt class="label">Fecha objetivo</dt>
      <dd>
        <DateField
          scope="project"
          code={code}
          date={targetDate}
          label="Fecha objetivo"
        />
      </dd>
    </div>
    <div class="fact wide">
      <dt class="label">Próximo paso</dt>
      <dd>
        <NextStepField projectCode={code} nextStep={nextStep} />
      </dd>
    </div>
  </dl>

  {
    /* Between the facts and the moves, because it is what explains the moves:
      the chip above says where the project stands, the buttons below say where
      it may go, and this names the graph both of them come from. */
  }
  <LifecyclePlate
    scope="project"
    code={code}
    workflow={workflow}
    stateCode={stateCode}
    stateLabel={stateLabel}
    engagementType={engagementCode}
  />

  <TransitionBar
    projectCode={code}
    transitions={transitions}
    emptyFields={emptyFields}
    updatedAt={updatedAt}
  />
</header>

<script>
  import { mountHeaderControls } from "./header-controls";
  import { onPage } from "./island";

  onPage("[data-project-header]", mountHeaderControls);
</script>

<style>
  .head {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
    padding: var(--space-5);
  }

  .top {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    flex-wrap: wrap;
  }

  .name {
    margin-top: var(--space-1);
    overflow-wrap: anywhere;
  }

  .summary {
    color: var(--tinta-media);
  }

  .facts {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
    gap: var(--space-4);
    margin-top: var(--space-2);
    padding-top: var(--space-4);
    border-top: var(--border-width) solid var(--hairline);
  }

  .fact {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    min-width: 0;
  }

  .fact.wide {
    grid-column: 1 / -1;
  }

  dd {
    margin: 0;
  }
</style>
