---
/**
 * The project's work: one row per task, in the server's triage order — and the
 * three things an operator wants to do with a row without leaving this screen.
 *
 * **Open it.** The title is a link to `/tasks/{code}`, where the comments and
 * the rest of the task live.
 *
 * **Move it.** `TaskMoveMenu` lists the moves the API published for that task
 * and nothing else; with none published it renders visibly dead with the reason
 * named. The frontend never derives a legal move from a state code.
 *
 * **Reassign it.** `OwnerMenu`, the same control the header uses, against the
 * task, writing through `PATCH /api/v1/tasks/{code}`. The name that lands is the
 * one the response carries, not the one that was clicked, so a row never claims
 * an owner the database refused.
 *
 * It stays a table: `<th scope="col">`, one row per task, controls inside cells.
 * A menu is a button and a list of buttons, so every row is fully keyboard
 * operable and the semantics a screen reader reads are unchanged.
 *
 * A dependency that resolved to no task keeps the operation's own words
 * (`raw_label`): 61 of the 82 source tasks describe their prerequisite in prose,
 * so an unresolved reference is the normal case, not a defect.
 */
import DateField from "../ui/DateField.astro";
import OwnerMenu from "./OwnerMenu.astro";
import TaskMoveMenu from "./TaskMoveMenu.astro";
import { taskMoves } from "./task-moves";
import { taxonomyTone, toneStyle } from "./tone";
import type { TaskItem } from "../../lib/api/domain";

export interface Props {
  projectCode: string;
  tasks: readonly TaskItem[];
  /** The project read's `updated_at`; the floor for live patches on the rows. */
  updatedAt: string;
}

const { projectCode, tasks, updatedAt } = Astro.props;

/** Where a task's own screen lives; built here so the row and the island agree. */
function taskHref(code: string): string {
  return `/tasks/${encodeURIComponent(code)}`;
}
---

<div class="tasks" data-tasks data-project-code={projectCode}>
  <p class="empty small" data-tasks-empty hidden={tasks.length > 0}>
    Este proyecto todavía no tiene tareas registradas.
  </p>

  <div class="table-wrap card" data-tasks-wrap hidden={tasks.length === 0}>
    <table>
      <caption class="visually-hidden">Tareas del proyecto</caption>
      <thead>
        <tr>
          <th class="label" scope="col">Tarea</th>
          <th class="label" scope="col">Estado</th>
          <th class="label" scope="col">Prioridad</th>
          <th class="label" scope="col">Responsable</th>
          <th class="label" scope="col">Vence</th>
          <th class="label" scope="col">Depende de</th>
        </tr>
      </thead>
      <tbody data-task-rows>
        {
          tasks.map((task) => (
            <tr data-task-row data-code={task.code} data-updated-at={updatedAt}>
              <td class="col-title">
                <a
                  class="title link"
                  href={taskHref(task.code)}
                  data-task-link
                  data-field="task-title"
                >
                  {task.title}
                </a>
                <span class="chip chip-code">{task.code}</span>
              </td>
              <td>
                <TaskMoveMenu
                  code={task.code}
                  state={task.state}
                  moves={taskMoves(task)}
                />
              </td>
              <td>
                <span
                  class:list={["chip", taxonomyTone(task.priority.color).className]}
                  style={toneStyle(taxonomyTone(task.priority.color))}
                  data-priority-chip
                >
                  <span data-field="priority-label">{task.priority.label}</span>
                </span>
              </td>
              <td>
                <OwnerMenu
                  scope="task"
                  code={task.code}
                  alias={task.assignee?.alias ?? null}
                  label={task.assignee?.label ?? null}
                  compact
                />
              </td>
              <td class="col-due">
                <DateField
                  scope="task"
                  code={task.code}
                  date={task.due_date ?? null}
                  label="Vence"
                />
                <span
                  class="chip tone-rojo"
                  data-field="overdue"
                  hidden={!task.is_overdue}
                >
                  vencida
                </span>
              </td>
              <td class="col-deps" data-field="dependencies">
                {task.dependencies.length === 0 && <span class="small">—</span>}
                {task.dependencies.map((dependency) => (
                  <span class="chip chip-code dep" title={dependency.raw_label}>
                    {dependency.task_code ?? dependency.raw_label}
                  </span>
                ))}
              </td>
            </tr>
          ))
        }
      </tbody>
    </table>
  </div>

  {
    /* One home for the row markup; the island clones it when a task is created
      while the page is open. The controls are rendered empty and filled by the
      island from the same read that fills the rest of the row. */
  }
  <template data-template="task">
    <tr data-task-row>
      <td class="col-title">
        <a class="title link" href="#" data-task-link data-field="task-title"
        ></a>
        <span class="chip chip-code" data-field="task-code"></span>
      </td>
      <td>
        <TaskMoveMenu
          code=""
          state={{ code: "", label: "", category: "", color: null }}
          moves={[]}
        />
      </td>
      <td>
        <span class="chip" data-priority-chip
          ><span data-field="priority-label"></span></span
        >
      </td>
      <td>
        <OwnerMenu scope="task" code="" alias={null} label={null} compact />
      </td>
      <td class="col-due">
        <DateField scope="task" code="" date={null} label="Vence" />
        <span class="chip tone-rojo" data-field="overdue" hidden>vencida</span>
      </td>
      <td class="col-deps" data-field="dependencies"></td>
    </tr>
  </template>

  {
    /* Dependency chips are cloned too, so they keep this component's scoped
      styles — an element built with `createElement` carries no scope id and
      would render unclipped. */
  }
  <template data-template="dependency">
    <span class="chip chip-code dep"></span>
  </template>

  <template data-template="no-dependency">
    <span class="small">—</span>
  </template>
</div>

<script>
  import { onPage } from "./island";
  import { mountTasks } from "./tasks";

  onPage("[data-tasks]", mountTasks);
</script>

<style>
  .table-wrap {
    /* Still the row scroller. The menus are positioned in viewport coordinates
      by `menu.ts` precisely so this container cannot clip them. */
    overflow-x: auto;
    padding: 0;
  }

  .table-wrap[hidden],
  .empty[hidden] {
    display: none;
  }

  table {
    width: 100%;
    min-width: 640px;
  }

  thead th {
    text-align: left;
    padding: var(--space-3);
    border-bottom: var(--border-width) solid var(--hairline);
  }

  tbody tr {
    border-bottom: var(--border-width) solid var(--hairline);
  }

  tbody tr:last-child {
    border-bottom: 0;
  }

  td {
    padding: var(--space-3);
    vertical-align: middle;
  }

  .col-title {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--space-1);
    min-width: 220px;
  }

  .link {
    display: inline-flex;
    align-items: center;
    min-height: 24px;
    color: var(--tinta);
    text-decoration: none;
    border-bottom: var(--border-width) solid transparent;
    transition: border-color var(--motion-micro-duration)
      var(--motion-micro-ease);
  }

  .link:hover {
    color: var(--cobalto);
    border-bottom-color: var(--cobalto);
  }

  .col-due {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    white-space: nowrap;
  }

  .col-deps {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-1);
    max-width: 260px;
  }

  .dep {
    max-width: 220px;
    overflow: hidden;
    text-overflow: ellipsis;
    display: inline-block;
  }

  .chip[hidden] {
    display: none;
  }
</style>
