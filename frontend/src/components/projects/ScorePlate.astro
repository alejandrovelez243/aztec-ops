---
/**
 * The score and the argument that defends it.
 *
 * A number without its breakdown is forbidden here (CLAUDE.md rule 7): the
 * plate always renders every signal the engine weighed, in the order the API
 * sent them (descending contribution), with the reason each one recorded.
 * `reason` is the engine's own prose and is rendered verbatim inside
 * `lang="en"` rather than paraphrased — the plate exists to reproduce the
 * decision, not to restate it.
 *
 * A manual override never rewrites `score.value` (`docs/API.md` §2.14). Both
 * are shown, the forced one labelled "Ajuste manual" with its reason and its
 * author, so the size of the disagreement between the human and the engine
 * stays visible.
 *
 * `score: null` means "never scored yet", which is not zero: a project between
 * its creation and the recalculator's first pass says so in words.
 */
import Icon from "../ui/Icon.astro";
import { barWidth, formatContribution, formatInstant, formatScore } from "./format";
import { signalLabel } from "./messages";
import type { Override, Score } from "../../lib/api/domain";

export interface Props {
  /** Business code, for the override calls the plate performs. */
  projectCode: string;
  /** The computed score, or `null` before the engine has ever run. */
  score: Score | null;
  /** The forced rank in effect, or `null`. */
  override: Override | null;
}

const { projectCode, score, override } = Astro.props;

const breakdown = score?.breakdown ?? [];
const total = breakdown.reduce((sum, entry) => sum + Math.abs(entry.contribution), 0);
const computedAt = formatInstant(score?.computed_at ?? null);

/**
 * The one line that says *what* was forced, by whom and when. Built here rather
 * than in the template, where the branch between a fixed position and a boost
 * would be unreadable — and where it would have to be rewritten identically in
 * the island that patches it.
 */
function overrideMeta(forced: Override | null): string {
  if (forced === null) return "";
  const amount =
    forced.position !== null && forced.position !== undefined
      ? `Posición ${forced.position}`
      : `Impulso ${forced.boost ?? ""}`;
  return `${amount} · ${forced.actor} · ${formatInstant(forced.created_at) ?? ""}`;
}

const overrideLine = overrideMeta(override);
const overrideReason = override?.reason ?? "";
---

<section
  class="plate card"
  data-score-plate
  data-project-code={projectCode}
  aria-label="Prioridad y su desglose"
>
  <header class="head">
    <div class="value-block">
      <p class="label">Prioridad</p>
      <p class="display value" data-field="score">
        {score === null ? "—" : formatScore(score.value)}
      </p>
      {
        score !== null && (
          <p class="small meta">
            Política <span class="figure" data-field="policy">{score.policy_version}</span>
            {computedAt !== null && <> · calculada el {computedAt}</>}
          </p>
        )
      }
      {score === null && <p class="small meta">Todavía sin calcular.</p>}
    </div>

    <div class="ops" data-ops-lead hidden>
      <button class="btn btn-secondary" type="button" data-action="open-override">
        <Icon name="flag" size={18} />
        Ajustar prioridad
      </button>
      <button
        class="btn btn-ghost"
        type="button"
        data-action="clear-override"
        hidden={override === null}
      >
        Quitar ajuste
      </button>
    </div>
  </header>

  <div class="override" data-override hidden={override === null}>
    <p class="chip tone-cielo">Ajuste manual</p>
    <p class="body-text" data-field="override-reason">{overrideReason}</p>
    <p class="small" data-field="override-meta">{overrideLine}</p>
  </div>

  {
    score !== null && breakdown.length === 0 && (
      <p class="small">El motor no registró señales para este puntaje.</p>
    )
  }

  <ul class="breakdown" data-breakdown>
    {
      breakdown.map((entry) => (
        <li class="signal" data-signal={entry.code}>
          <p class="title name">{signalLabel(entry.code)}</p>
          <p class="figure contribution" data-field="contribution">
            {formatContribution(entry.contribution)}
          </p>
          <span class="bar" aria-hidden="true">
            <span
              class="fill"
              data-field="bar"
              style={`width: ${barWidth(entry.contribution, total)}%`}
            />
          </span>
          <p class="small reason" lang="en" data-field="reason">
            {entry.reason}
          </p>
        </li>
      ))
    }
  </ul>

  {/* One home for the row markup: the island clones this when a recalculation
      brings a signal the first paint did not have. */}
  <template data-template="signal">
    <li class="signal">
      <p class="title name" data-field="signal-name"></p>
      <p class="figure contribution" data-field="contribution"></p>
      <span class="bar" aria-hidden="true"><span class="fill" data-field="bar"></span></span>
      <p class="small reason" lang="en" data-field="reason"></p>
    </li>
  </template>

  <dialog class="dialog" data-override-dialog aria-labelledby="override-title">
    <form method="dialog" data-override-form>
      <h2 class="h2" id="override-title">Ajustar la prioridad</h2>
      <p class="small">
        Fuerza la posición de este proyecto en la cola. El puntaje calculado no cambia: queda a la
        vista junto a tu decisión.
      </p>

      <label class="field">
        <span class="label">Tipo de ajuste</span>
        <select class="input" name="mode" data-override-mode>
          <option value="position">Posición fija en la cola</option>
          <option value="boost">Impulso sobre el puntaje</option>
        </select>
      </label>

      <label class="field">
        <span class="label" data-field="amount-label">Posición</span>
        <input class="input" name="amount" type="number" min="1" step="1" required />
      </label>

      <label class="field">
        <span class="label">Motivo (obligatorio)</span>
        <textarea
          class="input"
          name="reason"
          rows="3"
          required
          placeholder="Por qué esta decisión pesa más que el cálculo"></textarea>
      </label>

      <p class="small error" data-field="override-error" hidden></p>

      <div class="dialog-actions">
        <button class="btn btn-ghost" type="button" data-action="close-override">Cancelar</button>
        <button class="btn btn-primary" type="submit" data-action="submit-override">
          Guardar ajuste
        </button>
      </div>
    </form>
  </dialog>
</section>

<script>
  import { onPage } from "./island";
  import { mountScorePlate } from "./score-plate";

  onPage("[data-score-plate]", mountScorePlate);
</script>

<style>
  .plate {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
    padding: var(--space-5);
  }

  .head {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: var(--space-4);
    flex-wrap: wrap;
  }

  .value {
    margin-top: var(--space-1);
  }

  .meta {
    margin-top: var(--space-1);
  }

  .ops {
    display: flex;
    gap: var(--space-2);
    flex-wrap: wrap;
  }

  .ops[hidden] {
    display: none;
  }

  .override {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--space-2);
    padding: var(--space-3) var(--space-4);
    border-radius: var(--radius-chip);
    background-color: var(--cielo-wash);
  }

  .override[hidden] {
    display: none;
  }

  .breakdown {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }

  .signal {
    display: grid;
    grid-template-columns: 1fr auto;
    gap: var(--space-1) var(--space-3);
    align-items: baseline;
  }

  .contribution {
    color: var(--tinta);
  }

  .bar {
    grid-column: 1 / -1;
    display: block;
    height: var(--space-2);
    border-radius: var(--radius-full);
    background-color: var(--pozo);
    overflow: hidden;
  }

  .fill {
    display: block;
    height: 100%;
    border-radius: var(--radius-full);
    background-color: var(--cobalto);
    transition: width var(--motion-carta-duration) var(--motion-carta-ease);
  }

  .reason {
    grid-column: 1 / -1;
  }

  .dialog {
    width: min(460px, calc(100vw - var(--space-6)));
    padding: var(--space-5);
    border: var(--border-width) solid var(--hairline);
    border-radius: var(--radius-card);
    background-color: var(--carta);
    box-shadow: var(--shadow-lifted);
    color: var(--tinta);
  }

  .dialog::backdrop {
    background-color: var(--scrim);
  }

  .dialog form {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }

  .field {
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
  }

  .error {
    color: var(--rojo-ink);
  }

  .dialog-actions {
    display: flex;
    justify-content: flex-end;
    gap: var(--space-2);
    margin-top: var(--space-2);
  }
</style>
