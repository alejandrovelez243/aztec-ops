---
/**
 * Every risk currently raised against the project, with the evidence for each.
 *
 * Colour comes from `severity` and the name from a fallback table keyed by
 * `code`, never a branch on it: the flag set is open (CLAUDE.md rule 8), so a
 * code this build does not know renders with its own code and its reason rather
 * than disappearing — a dropped flag is a risk nobody sees.
 *
 * `reason` is the engine's evidence, generated by the specification that raised
 * the flag, and is rendered verbatim inside `lang="en"`: paraphrasing evidence
 * client-side is how a UI starts disagreeing with the audit trail it is
 * supposed to explain.
 */
import { riskLabel } from "./messages";
import { severityTone } from "./tone";
import type { RiskFlag } from "../../lib/api/domain";

export interface Props {
  flags: readonly RiskFlag[];
}

const { flags } = Astro.props;
---

<div class="risks" data-risk-list>
  <h2 class="label">Riesgos</h2>

  {
    /* Both arms always render, so the island can flip between them when a
      transition raises or clears a flag. */
  }
  <p class="chip tone-verde none" data-risk-none hidden={flags.length > 0}>
    Sin riesgos detectados
  </p>

  <ul data-risk-items hidden={flags.length === 0}>
    {
      flags.map((flag) => (
        <li class:list={["risk", severityTone(flag.severity)]}>
          <span class="dot" aria-hidden="true" />
          <div class="body">
            <p class="title" data-field="risk-name">
              {riskLabel(flag)}
            </p>
            <p class="small reason" lang="en" data-field="risk-reason">
              {flag.reason}
            </p>
          </div>
        </li>
      ))
    }
  </ul>

  {
    /* Cloned by the island when a re-read brings a flag that was not raised at
      first paint; the markup therefore has one home. */
  }
  <template data-template="risk">
    <li class="risk tone-piedra">
      <span class="dot" aria-hidden="true"></span>
      <div class="body">
        <p class="title" data-field="risk-name"></p>
        <p class="small reason" lang="en" data-field="risk-reason"></p>
      </div>
    </li>
  </template>
</div>

<style>
  .risks {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }

  .risks ul {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
  }

  .risk {
    display: flex;
    align-items: flex-start;
    gap: var(--space-3);
    padding: var(--space-3);
    border-radius: var(--radius-chip);
    background-color: var(--tone-wash);
  }

  .risk .dot {
    margin-top: 6px;
  }

  .risk .title {
    color: var(--tone-ink);
  }

  .reason {
    margin-top: var(--space-1);
  }

  .none {
    align-self: flex-start;
  }

  /* `hidden` must beat the flex displays above, or both arms show at once. */
  .risks ul[hidden],
  .risks .none[hidden] {
    display: none;
  }
</style>
