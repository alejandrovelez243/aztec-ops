---
/**
 * The project's running commentary: what somebody wanted the next reader to
 * know.
 *
 * A note is not a substitute for a blocker — nothing parses this text, and the
 * moment something greps it for "bloqueado" the typed row stops being written
 * (`docs/API.md` §2.12). The form says so in as many words.
 *
 * The list is rendered by the server from `notes` on the project detail
 * (`docs/API.md` §2.2): every note the project carries, newest first, including
 * the ones written against its tasks. The island on top of it only *adds* —
 * this operator's own note as the POST answers it, and colleagues' notes as the
 * stream delivers them — and it deduplicates on the note code, so a note that
 * was already painted here does not arrive twice. Server-rendered and streamed
 * rows share the markup below the `data-template="note"` clone produces, so the
 * two are indistinguishable once on screen.
 *
 * The empty arm therefore means the project has no notes, which is a fact about
 * the project. It no longer means "we cannot show you the ones it has".
 */
import Icon from "../ui/Icon.astro";
import { formatInstant, relativeTime } from "./format";
import type { NoteView } from "../../lib/api/domain";

export interface Props {
  projectCode: string;
  /** The project's notes as the detail read returns them: newest first. */
  notes: readonly NoteView[];
}

const { projectCode, notes } = Astro.props;
---

<section class="notes" data-notes data-project-code={projectCode}>
  <form class="add card" data-note-form>
    <label class="field">
      <span class="label">Nueva nota</span>
      <textarea
        class="input"
        name="body"
        rows="3"
        required
        placeholder="Contexto, acuerdos, lo que el próximo lector necesita saber"
      ></textarea>
    </label>
    <p class="small hint">
      Para lo que está detenido, usa <strong>Bloqueos</strong>: eso sí pesa en
      la prioridad.
    </p>
    <p class="small error" data-field="note-error" hidden></p>
    <div class="actions">
      <button class="btn btn-primary" type="submit" data-action="add-note">
        <Icon name="plus" size={18} />
        Publicar nota
      </button>
    </div>
  </form>

  <p class="empty small" data-notes-empty hidden={notes.length > 0}>
    Este proyecto todavía no tiene notas. Publica la primera: quedará en la
    bitácora para quien lea después.
  </p>

  <ul class="list" data-note-list>
    {
      notes.map((note) => (
        <li class="note card" data-note data-code={note.code}>
          <p class="title">
            <span data-field="note-author">{note.author}</span>
            <span
              class="small when"
              data-field="note-when"
              data-occurred-at={note.created_at}
              title={formatInstant(note.created_at) ?? undefined}
            >
              {relativeTime(note.created_at)}
            </span>
          </p>
          <p class="body-text" data-field="note-body">
            {note.body}
          </p>
        </li>
      ))
    }
  </ul>

  {
    /* One home for the row markup, and it must stay the same shape as the rows
      above: the island clones this for a note it just wrote and for one the
      stream delivered, and a reader must not be able to tell which half of the
      panel a note came from. */
  }
  <template data-template="note">
    <li class="note card" data-note>
      <p class="title">
        <span data-field="note-author"></span>
        <span class="small when" data-field="note-when"></span>
      </p>
      <p class="body-text" data-field="note-body"></p>
    </li>
  </template>
</section>

<script>
  import { onPage } from "./island";
  import { mountNotes } from "./notes";

  onPage("[data-notes]", mountNotes);
</script>

<style>
  .notes {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
  }

  .add {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    padding: var(--space-4);
  }

  .hint {
    color: var(--tinta-media);
  }

  .actions {
    display: flex;
    justify-content: flex-end;
  }

  .error {
    color: var(--rojo-ink);
  }

  .error[hidden] {
    display: none;
  }

  .empty[hidden] {
    display: none;
  }

  .list {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }

  .note {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    padding: var(--space-4);
  }

  .when {
    margin-left: var(--space-2);
    font-weight: 400;
  }
</style>
