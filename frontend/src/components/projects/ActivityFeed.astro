---
/**
 * The project's timeline: every recorded change, newest first.
 *
 * This is the audit trail, not a rendering of the stream — `ActivityRecord` is
 * what makes a reprioritization defensible weeks later, and rows sharing a
 * `correlation_id` are one decision (`docs/API.md` §2.13). Verbs are named in
 * Spanish through a fallback table; a verb this build does not know renders as
 * itself rather than as a blank row.
 *
 * Times are relative with the absolute instant in `title`, because "hace 3
 * días" is what an operator reads and "28 jul 2026, 09:05" is what they need
 * when they are reconstructing a week.
 */
import Icon from "../ui/Icon.astro";
import { formatInstant, relativeTime } from "./format";
import { verbLabel } from "./messages";
import { activityChange } from "./presentation";
import type { ActivityEntry } from "../../lib/api/domain";

export interface Props {
  projectCode: string;
  entries: readonly ActivityEntry[];
  /** Total records across pages, from the read's envelope. */
  count: number;
  /** Page size of the first read; the island keeps paging with the same one. */
  pageSize: number;
}

const { projectCode, entries, count, pageSize } = Astro.props;
---

<section
  class="feed"
  data-activity-feed
  data-project-code={projectCode}
  data-page="1"
  data-page-size={pageSize}
  data-count={count}
>
  <p class="empty small" data-activity-empty hidden={entries.length > 0}>
    Todavía no hay movimientos registrados en este proyecto.
  </p>

  <ol class="list" data-activity-list>
    {
      entries.map((entry) => (
        <li class="entry" data-activity data-id={entry.id}>
          <span class="dot tone-cielo" aria-hidden="true" />
          <div class="body">
            <p class="title">
              <span data-field="activity-verb">{verbLabel(entry.verb)}</span>
              <span class="small actor" data-field="activity-actor">
                {entry.actor}
              </span>
            </p>
            <p class="small change" data-field="activity-change" hidden={activityChange(entry) === ""}>
              {activityChange(entry)}
            </p>
            <p class="small reason" data-field="activity-reason" hidden={entry.reason === ""}>
              {entry.reason}
            </p>
            <p
              class="small when"
              data-field="activity-when"
              data-occurred-at={entry.occurred_at}
              title={formatInstant(entry.occurred_at) ?? undefined}
            >
              {relativeTime(entry.occurred_at)}
            </p>
          </div>
        </li>
      ))
    }
  </ol>

  <div class="more">
    <button
      class="btn btn-secondary"
      type="button"
      data-action="load-more"
      hidden={entries.length >= count}
    >
      <Icon name="chevron-down" size={18} />
      Cargar más
    </button>
    <p class="small">
      <span class="figure" data-field="activity-shown">{entries.length}</span> de
      <span class="figure" data-field="activity-total">{count}</span> registros
    </p>
  </div>

  {/* One home for the row markup; the island clones it when paging and when a
      change lands while the page is open. */}
  <template data-template="activity">
    <li class="entry" data-activity>
      <span class="dot tone-cielo" aria-hidden="true"></span>
      <div class="body">
        <p class="title">
          <span data-field="activity-verb"></span>
          <span class="small actor" data-field="activity-actor"></span>
        </p>
        <p class="small change" data-field="activity-change" hidden></p>
        <p class="small reason" data-field="activity-reason" hidden></p>
        <p class="small when" data-field="activity-when"></p>
      </div>
    </li>
  </template>
</section>

<script>
  import { onPage } from "./island";
  import { mountActivity } from "./activity";

  onPage("[data-activity-feed]", mountActivity);
</script>

<style>
  .feed {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
  }

  .empty[hidden] {
    display: none;
  }

  .list {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }

  .entry {
    display: flex;
    align-items: flex-start;
    gap: var(--space-3);
    padding-left: var(--space-1);
  }

  .entry .dot {
    margin-top: 7px;
  }

  .body {
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
    min-width: 0;
  }

  .actor {
    margin-left: var(--space-2);
    font-weight: 400;
  }

  .change {
    color: var(--tinta);
  }

  .body p[hidden] {
    display: none;
  }

  .more {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    flex-wrap: wrap;
  }

  .more .btn[hidden] {
    display: none;
  }
</style>
